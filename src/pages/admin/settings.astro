---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Settings" eyebrow="Platform" description="Review CajunSites operational configuration, production connections, and dashboard services." active="settings">
  <style is:global>
    .settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.setting{padding:18px}.setting-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px}.setting h3{margin:0}.setting p{margin:4px 0 0;color:#807489;font-size:.77rem}.setting-meta{display:grid;gap:7px;padding-top:12px;border-top:1px solid #eee9f1;font-size:.73rem}.setting-meta div{display:flex;justify-content:space-between;gap:14px}.setting-meta span{color:#8c8093}.setting-meta strong{color:#46314f;text-align:right}.security{background:linear-gradient(135deg,#fff,#faf5ff)}.tax{background:linear-gradient(135deg,#fffdf6,#fff)}.settings-link{font-weight:850;color:#641bc0;text-decoration:none}.health-error{display:none;margin-bottom:12px;padding:11px 13px;border-radius:10px;background:#fdecec;color:#8d2424}.health-error.show{display:block}@media(max-width:850px){.settings-grid{grid-template-columns:1fr}}
  </style>
  <div id="healthError" class="health-error">Platform health could not be loaded. Refresh to retry.</div>
  <div class="settings-grid">
    <section class="surface setting"><div class="setting-head"><div><h3>Customer Database</h3><p>Primary operational data store.</p></div><span class="pill" data-health="d1">Checking</span></div><div class="setting-meta"><div><span>Provider</span><strong>Cloudflare D1</strong></div><div><span>Database</span><strong>cajunsites-production</strong></div></div></section>
    <section class="surface setting"><div class="setting-head"><div><h3>Payments & Billing</h3><p>Checkout, recurring billing, and lifecycle webhooks.</p></div><span class="pill" data-health="stripe_webhook">Checking</span></div><div class="setting-meta"><div><span>Provider</span><strong>Stripe</strong></div><div><span>Offer</span><strong>$499 + $49/month</strong></div><div><span>Lifecycle</span><strong>Payment failure/recovery + cancellation</strong></div></div></section>
    <section class="surface setting"><div class="setting-head"><div><h3>Transactional Email</h3><p>Customer and internal lifecycle email.</p></div><span class="pill" data-health="resend">Checking</span></div><div class="setting-meta"><div><span>Provider</span><strong>Resend</strong></div><div><span>Sender</span><strong>hello@cajunsites.com</strong></div></div></section>
    <section class="surface setting"><div class="setting-head"><div><h3>Business Research</h3><p>Source-backed public business enrichment.</p></div><span class="pill" data-health="openai">Checking</span></div><div class="setting-meta"><div><span>Runtime</span><strong>OpenAI + Web Search</strong></div><div><span>Review Policy</span><strong>Aggregate facts/themes only</strong></div></div></section>
    <section class="surface setting"><div class="setting-head"><div><h3>Concept Factory</h3><p>Central Visual Family Engine, Vercel deployment, and DNS.</p></div><span class="pill" id="conceptHealth">Checking</span></div><div class="setting-meta"><div><span>Visual System</span><strong>visual-family-v4</strong></div><div><span>Hosting</span><strong>Vercel</strong></div><div><span>DNS</span><strong>Cloudflare</strong></div></div></section>
    <section class="surface setting security"><div class="setting-head"><div><h3>Admin Security</h3><p>Worker-gated pages, role-based sessions, throttling, and password protection.</p></div><span class="pill" id="securityHealth">Checking</span></div><div class="setting-meta"><div><span>Admin HTML</span><strong>Worker authenticated</strong></div><div><span>Login Throttling</span><strong>5 failures / 15 minutes</strong></div><div><span>Password Pepper</span><strong id="pepperState">Checking</strong></div><div><span>Users</span><strong><a class="settings-link" href="/admin/users/">Manage →</a></strong></div></div></section>
    <section class="surface setting"><div class="setting-head"><div><h3>Cloudflare Email Service</h3><p>Lead and onboarding internal delivery.</p></div><span class="pill" data-health="email_service">Checking</span></div><div class="setting-meta"><div><span>Destination</span><strong>Configured Worker binding</strong></div></div></section>
    <section class="surface setting tax"><div class="setting-head"><div><h3>Stripe Tax</h3><p>Automatic tax configuration.</p></div><span class="pill gold">Pending Review</span></div><div class="setting-meta"><div><span>Current State</span><strong>Disabled</strong></div><div><span>Next Step</span><strong>Confirm Louisiana treatment</strong></div></div></section>
  </div>
</AdminShell>
<script is:inline>
function setPill(el,ok,label){el.textContent=label||(ok?'Configured':'Missing');el.className='pill '+(ok?'green':'red')}async function check(){const err=document.getElementById('healthError');err.className='health-error';try{const d=await window.adminApi('/api/admin/health'),s=d.services||{};document.querySelectorAll('[data-health]').forEach(el=>{const x=s[el.dataset.health]||{};setPill(el,Boolean(x.configured&&x.healthy!==false),x.configured?(x.healthy===false?'Unavailable':'Configured'):'Missing')});const concept=Boolean(s.vercel?.configured&&s.dns?.configured);setPill(document.getElementById('conceptHealth'),concept,concept?'Configured':'Missing Secret');const security=Boolean(s.admin_password_pepper?.configured);setPill(document.getElementById('securityHealth'),security,security?'Protected':'Incomplete');document.getElementById('pepperState').textContent=s.admin_password_pepper?.dedicated?'Dedicated secret':'Legacy fallback secret'}catch{err.className='health-error show'}}window.addEventListener('admin-authenticated',check);check();
</script>