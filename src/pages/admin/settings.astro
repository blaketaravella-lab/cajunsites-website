---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Settings" eyebrow="Platform" description="Review CajunSites operational configuration, production connections, and dashboard services." active="settings">
  <style>
    .settings-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.setting{padding:18px}.setting-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px}.setting h3{margin:0}.setting p{margin:4px 0 0;color:#807489;font-size:.77rem}.setting-meta{display:grid;gap:7px;padding-top:12px;border-top:1px solid #eee9f1;font-size:.73rem}.setting-meta div{display:flex;justify-content:space-between;gap:14px}.setting-meta span{color:#8c8093}.setting-meta strong{color:#46314f;text-align:right}.security{background:linear-gradient(135deg,#fff,#faf5ff)}.tax{background:linear-gradient(135deg,#fffdf6,#fff)}.settings-link{font-weight:850;color:#641bc0;text-decoration:none}@media(max-width:850px){.settings-grid{grid-template-columns:1fr}}
  </style>
  <div class="settings-grid"><section class="surface setting"><div class="setting-head"><div><h3>Customer Database</h3><p>Primary operational data store.</p></div><span class="pill green">Configured</span></div><div class="setting-meta"><div><span>Provider</span><strong>Cloudflare D1</strong></div><div><span>Database</span><strong>cajunsites-production</strong></div></div></section><section class="surface setting"><div class="setting-head"><div><h3>Payments</h3><p>Checkout and recurring billing.</p></div><span class="pill green">Configured</span></div><div class="setting-meta"><div><span>Provider</span><strong>Stripe</strong></div><div><span>Offer</span><strong>$499 + $49/month</strong></div></div></section><section class="surface setting"><div class="setting-head"><div><h3>Transactional Email</h3><p>Customer and internal lifecycle email.</p></div><span class="pill green">Configured</span></div><div class="setting-meta"><div><span>Provider</span><strong>Resend</strong></div><div><span>Sender</span><strong>hello@cajunsites.com</strong></div></div></section><section class="surface setting"><div class="setting-head"><div><h3>Business Research</h3><p>Source-backed public business enrichment.</p></div><span class="pill green">Configured</span></div><div class="setting-meta"><div><span>Runtime</span><strong>OpenAI + Web Search</strong></div><div><span>Secret</span><strong>OPENAI_API_KEY</strong></div></div></section><section class="surface setting"><div class="setting-head"><div><h3>Concept Factory</h3><p>Automated preview deployment and domains.</p></div><span class="pill green">Configured</span></div><div class="setting-meta"><div><span>Hosting</span><strong>Vercel</strong></div><div><span>DNS</span><strong>Cloudflare</strong></div></div></section><section class="surface setting security"><div class="setting-head"><div><h3>Admin Security</h3><p>Internal accounts, sessions, and protected runtime secrets.</p></div><span class="pill green">Protected</span></div><div class="setting-meta"><div><span>Access</span><strong>Role based</strong></div><div><span>Sessions</span><strong>Server side</strong></div><div><span>Users</span><strong><a class="settings-link" href="/admin/users/">Manage →</a></strong></div></div></section><section class="surface setting"><div class="setting-head"><div><h3>Operations Storage</h3><p>Activity history, notes, and site metadata.</p></div><span class="pill" id="opsPill">Checking</span></div><div class="setting-meta"><div><span>Status</span><strong id="opsText">Checking database readiness...</strong></div></div></section><section class="surface setting tax"><div class="setting-head"><div><h3>Stripe Tax</h3><p>Automatic tax configuration.</p></div><span class="pill gold">Pending Review</span></div><div class="setting-meta"><div><span>Current State</span><strong>Disabled</strong></div><div><span>Next Step</span><strong>Confirm Louisiana treatment</strong></div></div></section></div>
</AdminShell>
<script is:inline>
async function check(){try{const d=await window.adminApi('/api/admin/activity'),p=document.getElementById('opsPill'),t=document.getElementById('opsText');if(d.storageReady===false){p.textContent='Migration Required';p.className='pill gold';t.textContent='Migration 0003 required'}else{p.textContent='Configured';p.className='pill green';t.textContent='Available'}}catch{}}window.addEventListener('admin-authenticated',check);if(window.adminUser)check();
</script>