---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Settings" eyebrow="Platform" description="Review CajunSites operational configuration, production connections, and dashboard data services." active="settings">
  <style>
    .settings-card{display:grid;gap:8px;align-content:start}.settings-card h3{margin:2px 0 0}.settings-card p{margin:0;color:var(--muted)}.settings-card p strong{color:var(--ink)}.settings-link{font-weight:800;color:var(--purple-800);text-decoration:none}.settings-link:hover{text-decoration:underline}.security-card{background:linear-gradient(180deg,#fff,#fcf9fd)}
  </style>
  <div class="admin-grid">
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Customer Database</h3><p>Cloudflare D1</p><p><strong>Database:</strong> cajunsites-production</p></div>
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Payments</h3><p>Stripe Checkout and recurring billing</p><p><strong>Offer:</strong> $499 launch + $49/month</p></div>
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Transactional Email</h3><p>Resend using the verified CajunSites domain.</p><p><strong>Sender:</strong> hello@cajunsites.com</p></div>
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Form Protection</h3><p>Cloudflare Turnstile protects lead and onboarding submissions.</p></div>
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Admin Authentication</h3><p>Individual internal accounts with role-based access, server-side sessions, secure HttpOnly cookies, and salted password verification using a server-side secret.</p></div>
    <div class="admin-card settings-card"><span class="pill green">Configured</span><h3>Internal Access</h3><p>Owner-managed access for CajunSites staff.</p><p><a class="settings-link" href="/admin/users/">Manage Internal Users →</a></p></div>
    <div class="admin-card settings-card"><span class="pill" id="opsPill">Checking</span><h3>Operations Storage</h3><p>Activity history, internal notes, and site metadata.</p><p id="opsText">Checking database readiness...</p></div>
  </div>
  <div class="admin-grid" style="margin-top:14px;grid-template-columns:1fr 1fr">
    <div class="admin-card settings-card"><span class="pill gold">Pending Review</span><h3>Stripe Tax</h3><p>Automatic tax remains disabled pending final Louisiana tax treatment confirmation.</p></div>
    <div class="admin-card settings-card security-card"><span class="pill green">Protected</span><h3>Security</h3><p>Runtime secrets are managed in Cloudflare and are not stored in GitHub. Customer onboarding links are signed, internal sessions are stored server-side and can be revoked immediately, and all internal pages are excluded from search indexing.</p></div>
  </div>
</AdminShell>
<script is:inline>
async function check(){try{const d=await window.adminApi('/api/admin/activity');const p=document.getElementById('opsPill'),t=document.getElementById('opsText');if(d.storageReady===false){p.textContent='Migration Required';p.className='pill gold';t.textContent='Apply migration 0003_admin_operations.sql to enable notes, activity history, and site metadata.'}else{p.textContent='Configured';p.className='pill green';t.textContent='Activity history, internal notes, and site metadata are available.'}}catch{}}
window.addEventListener('admin-authenticated',check);if(window.adminUser)check();
</script>