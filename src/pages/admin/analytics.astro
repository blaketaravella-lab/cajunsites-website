---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Analytics" eyebrow="Business Performance" description="Monitor customer flow, recurring revenue, and fulfillment progress." active="analytics">
  <style>
    .funnel{display:grid;gap:12px;margin-top:14px}.funnel-row{display:grid;grid-template-columns:220px minmax(120px,1fr) 60px;align-items:center;gap:12px}.funnel-label{font-weight:800;color:var(--purple-950)}.track{height:12px;background:#f0eaf3;border-radius:999px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,var(--purple-800),var(--purple-700));border-radius:999px}.count{font-weight:800;color:var(--purple-800);text-align:right}@media(max-width:700px){.funnel-row{grid-template-columns:1fr auto;gap:7px}.track{grid-column:1/-1;grid-row:2}.count{grid-column:2;grid-row:1}.funnel-label{grid-column:1;grid-row:1}}
  </style>
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="customers">0</strong><span>Total Customers</span></div><div class="metric"><strong id="launchRevenue">$0</strong><span>Launch Revenue</span></div><div class="metric"><strong id="mrr">$0</strong><span>Monthly Recurring Revenue</span></div></div>
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span></div><div class="metric"><strong id="pipeline">0</strong><span>In Fulfillment</span></div><div class="metric"><strong id="live">0</strong><span>Live / Active</span></div></div>
  <div class="admin-card"><h3>Operational Funnel</h3><p style="margin:0;color:var(--muted);font-size:.84rem">Current customers by major lifecycle stage.</p><div id="funnel" class="funnel"></div></div>
</AdminShell>
<script is:inline>
async function load(){try{const d=await window.adminApi('/api/admin/customers');const c=d.customers||[];const count=s=>c.filter(x=>s.includes(x.status)).length;const billable=c.filter(x=>x.status!=='Cancelled');document.getElementById('customers').textContent=c.length;document.getElementById('launchRevenue').textContent='$'+(c.length*499).toLocaleString();document.getElementById('mrr').textContent='$'+(billable.length*49).toLocaleString();document.getElementById('awaiting').textContent=count(['Paid - Awaiting Onboarding']);document.getElementById('pipeline').textContent=count(['Onboarding Received','Waiting on Customer','Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']);document.getElementById('live').textContent=count(['Live','Active Customer']);const groups=[['Paid - Awaiting Onboarding',['Paid - Awaiting Onboarding']],['Onboarding Received',['Onboarding Received','Waiting on Customer']],['Ready to Build',['Ready to Build']],['Production',['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']],['Live / Active',['Live','Active Customer']]];document.getElementById('funnel').innerHTML=groups.map(([l,s])=>`<div class="funnel-row"><div class="funnel-label">${l}</div><div class="track"><div class="fill" style="width:${c.length?Math.max(3,count(s)/c.length*100):0}%"></div></div><div class="count">${count(s)}</div></div>`).join('')}catch{}}
window.addEventListener('admin-authenticated',load);load();
</script>