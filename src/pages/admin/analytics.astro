---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Analytics" eyebrow="Business Performance" description="Monitor customer flow, recurring revenue, and fulfillment progress." active="analytics">
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="customers">0</strong><span>Total Customers</span></div><div class="metric"><strong id="launchRevenue">$0</strong><span>Launch Revenue</span></div><div class="metric"><strong id="mrr">$0</strong><span>Monthly Recurring Revenue</span></div></div>
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span></div><div class="metric"><strong id="pipeline">0</strong><span>In Fulfillment</span></div><div class="metric"><strong id="live">0</strong><span>Live / Active</span></div></div>
  <div class="admin-card"><h3>Operational Funnel</h3><div id="funnel" style="display:grid;gap:10px;margin-top:14px"></div></div>
</AdminShell>
<script is:inline>
async function load(){try{const d=await window.adminApi('/api/admin/customers');const c=d.customers||[];const count=s=>c.filter(x=>s.includes(x.status)).length;document.getElementById('customers').textContent=c.length;document.getElementById('launchRevenue').textContent='$'+(c.length*499).toLocaleString();document.getElementById('mrr').textContent='$'+(count(['Live','Active Customer'])*49).toLocaleString();document.getElementById('awaiting').textContent=count(['Paid - Awaiting Onboarding']);document.getElementById('pipeline').textContent=count(['Onboarding Received','Waiting on Customer','Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']);document.getElementById('live').textContent=count(['Live','Active Customer']);const groups=[['Paid - Awaiting Onboarding',['Paid - Awaiting Onboarding']],['Onboarding Received',['Onboarding Received','Waiting on Customer']],['Ready to Build',['Ready to Build']],['Production',['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']],['Live / Active',['Live','Active Customer']]];document.getElementById('funnel').innerHTML=groups.map(([l,s])=>`<div style="display:grid;grid-template-columns:220px 1fr 60px;align-items:center;gap:12px"><strong>${l}</strong><div style="height:12px;background:#f0eaf3;border-radius:999px;overflow:hidden"><div style="height:100%;width:${c.length?Math.max(3,count(s)/c.length*100):0}%;background:var(--purple-700)"></div></div><span>${count(s)}</span></div>`).join('')}catch{}}
window.addEventListener('admin-authenticated',load);load();
</script>