---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Analytics" eyebrow="Business Performance" description="Monitor customer flow, recurring revenue, and fulfillment progress." active="analytics">
  <style>
    .analytics-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.funnel{display:grid;gap:13px}.funnel-row{display:grid;grid-template-columns:170px minmax(120px,1fr) 42px;align-items:center;gap:12px}.funnel-label{font-weight:800;color:#3f2550;font-size:.75rem}.track{height:10px;background:#f0eaf3;border-radius:999px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#54148d,#7a2bd1);border-radius:999px}.count{font-weight:900;color:#54148d;text-align:right}.revenue-card{padding:20px;background:linear-gradient(135deg,#2e0752,#5f18a5);color:#fff}.revenue-card h3{color:#fff;margin:0}.revenue-card p{color:#dfd1e9;font-size:.78rem}.revenue-big{font-size:2.5rem;font-weight:950;letter-spacing:-.05em;margin:15px 0 3px}.revenue-sub{font-size:.7rem;color:#ddcfea}.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}.mini{padding:11px;border-radius:10px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12)}.mini strong{display:block;font-size:1.05rem}.mini span{font-size:.63rem;color:#d9cbe4}@media(max-width:900px){.analytics-grid{grid-template-columns:1fr}}@media(max-width:700px){.funnel-row{grid-template-columns:1fr auto}.track{grid-column:1/-1}.count{grid-column:2;grid-row:1}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="customers">0</strong><span>Total Customers</span><small>Paid accounts</small></div><div class="metric"><strong id="launchRevenue">$0</strong><span>Launch Revenue</span><small>Gross one-time value</small></div><div class="metric"><strong id="mrr">$0</strong><span>Monthly Recurring Revenue</span><small>Current recurring base</small></div><div class="metric"><strong id="live">0</strong><span>Live / Active</span><small>Production customers</small></div></div>
  <div class="analytics-grid"><section class="surface"><div class="surface-head"><div><h3>Operational Funnel</h3><p>Current customers grouped by major lifecycle stage.</p></div></div><div class="surface-body"><div id="funnel" class="funnel"></div></div></section><section class="surface revenue-card"><h3>Revenue Snapshot</h3><p>Simple business-model view based on the standard CajunSites offer.</p><div class="revenue-big" id="revenueMrr">$0</div><div class="revenue-sub">Monthly recurring revenue</div><div class="mini-grid"><div class="mini"><strong id="awaiting">0</strong><span>Awaiting onboarding</span></div><div class="mini"><strong id="pipeline">0</strong><span>In fulfillment</span></div><div class="mini"><strong id="avgValue">$0</strong><span>First-year value / customer</span></div><div class="mini"><strong id="annualized">$0</strong><span>Annualized recurring</span></div></div></section></div>
</AdminShell>
<script is:inline>
async function load(){try{const d=await window.adminApi('/api/admin/customers'),c=d.customers||[],count=s=>c.filter(x=>s.includes(x.status)).length,billable=c.filter(x=>x.status!=='Cancelled'),mrr=billable.length*49;document.getElementById('customers').textContent=c.length;document.getElementById('launchRevenue').textContent='$'+(c.length*499).toLocaleString();document.getElementById('mrr').textContent='$'+mrr.toLocaleString();document.getElementById('revenueMrr').textContent='$'+mrr.toLocaleString();document.getElementById('awaiting').textContent=count(['Paid - Awaiting Onboarding']);document.getElementById('pipeline').textContent=count(['Onboarding Received','Waiting on Customer','Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']);document.getElementById('live').textContent=count(['Live','Active Customer']);document.getElementById('avgValue').textContent='$'+(499+49*12).toLocaleString();document.getElementById('annualized').textContent='$'+(mrr*12).toLocaleString();const groups=[['Awaiting Onboarding',['Paid - Awaiting Onboarding']],['Onboarding Review',['Onboarding Received','Waiting on Customer']],['Ready to Build',['Ready to Build']],['Production',['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching']],['Live / Active',['Live','Active Customer']]];document.getElementById('funnel').innerHTML=groups.map(([l,s])=>`<div class="funnel-row"><div class="funnel-label">${l}</div><div class="track"><div class="fill" style="width:${c.length?Math.max(3,count(s)/c.length*100):0}%"></div></div><div class="count">${count(s)}</div></div>`).join('')}catch{}}window.addEventListener('admin-authenticated',load);load();
</script>