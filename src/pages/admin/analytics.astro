---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Analytics" eyebrow="Business Performance" description="Monitor prospect conversion, customer flow, recurring revenue, and fulfillment progress." active="analytics">
  <style is:global>
    .analytics-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.funnel{display:grid;gap:13px}.funnel-row{display:grid;grid-template-columns:170px minmax(120px,1fr) 42px;align-items:center;gap:12px}.funnel-label{font-weight:800;color:#3f2550;font-size:.75rem}.track{height:10px;background:#f0eaf3;border-radius:999px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#54148d,#7a2bd1);border-radius:999px}.count{font-weight:900;color:#54148d;text-align:right}.revenue-card{padding:20px;background:linear-gradient(135deg,#2e0752,#5f18a5);color:#fff}.revenue-card h3{color:#fff;margin:0}.revenue-card p{color:#dfd1e9;font-size:.78rem}.revenue-big{font-size:2.5rem;font-weight:950;letter-spacing:-.05em;margin:15px 0 3px}.revenue-sub{font-size:.7rem;color:#ddcfea}.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}.mini{padding:11px;border-radius:10px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12)}.mini strong{display:block;font-size:1.05rem}.mini span{font-size:.63rem;color:#d9cbe4}.section-stack{display:grid;gap:14px}.note{font-size:.68rem;color:#85788c;margin-top:10px;line-height:1.45}@media(max-width:900px){.analytics-grid{grid-template-columns:1fr}}@media(max-width:700px){.funnel-row{grid-template-columns:1fr auto}.track{grid-column:1/-1}.count{grid-column:2;grid-row:1}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="prospects">0</strong><span>Total Prospects</span><small>Current pipeline records</small></div><div class="metric"><strong id="winRate">0%</strong><span>Closed Win Rate</span><small>Won ÷ Won + Lost</small></div><div class="metric"><strong id="mrr">$0</strong><span>Active Base MRR</span><small>Modeled from healthy subscriptions</small></div><div class="metric"><strong id="live">0</strong><span>Live / Active</span><small>Production customers</small></div></div>
  <div class="analytics-grid"><div class="section-stack"><section class="surface"><div class="surface-head"><div><h3>Prospect Funnel</h3><p>Current pipeline by sales stage.</p></div></div><div class="surface-body"><div id="prospectFunnel" class="funnel"></div></div></section><section class="surface"><div class="surface-head"><div><h3>Customer Fulfillment Funnel</h3><p>Paid customers grouped by major delivery stage.</p></div></div><div class="surface-body"><div id="customerFunnel" class="funnel"></div></div></section></div><section class="surface revenue-card"><h3>Revenue Snapshot</h3><p>Operational model based on current healthy subscription records. Stripe remains the source of truth.</p><div class="revenue-big" id="revenueMrr">$0</div><div class="revenue-sub">Modeled active base MRR</div><div class="mini-grid"><div class="mini"><strong id="customers">0</strong><span>Total customers</span></div><div class="mini"><strong id="paymentIssues">0</strong><span>Payment issues</span></div><div class="mini"><strong id="annualized">$0</strong><span>Annualized recurring</span></div><div class="mini"><strong id="fallbacks">0</strong><span>Generic visual fallbacks</span></div></div><div class="note">Launch revenue is intentionally not inferred from customer count here. Use Stripe payment data for realized revenue reporting.</div></section></div>
</AdminShell>
<script is:inline>
const row=(label,count,total)=>`<div class="funnel-row"><div class="funnel-label">${label}</div><div class="track"><div class="fill" style="width:${total?Math.max(3,count/total*100):0}%"></div></div><div class="count">${count}</div></div>`;async function load(){try{const [d,m]=await Promise.all([window.adminApi('/api/admin/customers'),window.adminApi('/api/admin/metrics')]);const c=d.customers||[],count=s=>c.filter(x=>s.includes(x.status)).length,sc=m.prospects?.stage_counts||{},pt=m.prospects?.total||0,mrr=(m.customers?.active_mrr_customers||0)*49;document.getElementById('prospects').textContent=pt;document.getElementById('winRate').textContent=(m.prospects?.win_rate||0)+'%';document.getElementById('mrr').textContent='$'+mrr.toLocaleString();document.getElementById('revenueMrr').textContent='$'+mrr.toLocaleString();document.getElementById('customers').textContent=c.length;document.getElementById('paymentIssues').textContent=m.customers?.payment_issues||0;document.getElementById('annualized').textContent='$'+(mrr*12).toLocaleString();document.getElementById('fallbacks').textContent=m.prospects?.generic_fallbacks||0;document.getElementById('live').textContent=count(['Live','Active Customer']);const pg=[['Qualified',sc.Qualified||0],['Concept Built',sc['Concept Built']||0],['Contacted',sc.Contacted||0],['Concept Viewed',sc['Concept Viewed']||0],['Won',sc.Won||0],['Lost',sc.Lost||0]];document.getElementById('prospectFunnel').innerHTML=pg.map(([l,n])=>row(l,n,pt)).join('');const cg=[['Awaiting Onboarding',count(['Paid - Awaiting Onboarding'])],['Onboarding Review',count(['Onboarding Received','Waiting on Customer'])],['Ready to Build',count(['Ready to Build'])],['Production',count(['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'])],['Live / Active',count(['Live','Active Customer'])]];document.getElementById('customerFunnel').innerHTML=cg.map(([l,n])=>row(l,n,c.length)).join('')}catch(err){document.getElementById('prospectFunnel').innerHTML='<div class="empty">Analytics could not be loaded. Refresh to retry.</div>'}}window.addEventListener('admin-authenticated',load);load();
</script>