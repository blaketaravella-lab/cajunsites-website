---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Analytics" eyebrow="Business Performance" description="Monitor conversion, fulfillment, actual recurring revenue, and platform efficiency." active="analytics">
  <style is:global>
    .analytics-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.funnel{display:grid;gap:13px}.funnel-row{display:grid;grid-template-columns:170px minmax(120px,1fr) 42px;align-items:center;gap:12px}.funnel-label{font-weight:800;color:#3f2550;font-size:.75rem}.track{height:10px;background:#f0eaf3;border-radius:999px;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,#54148d,#7a2bd1);border-radius:999px}.count{font-weight:900;color:#54148d;text-align:right}.revenue-card{padding:20px;background:linear-gradient(135deg,#2e0752,#5f18a5);color:#fff}.revenue-card h3{color:#fff;margin:0}.revenue-card p{color:#dfd1e9;font-size:.78rem}.revenue-big{font-size:2.5rem;font-weight:950;letter-spacing:-.05em;margin:15px 0 3px}.revenue-sub{font-size:.7rem;color:#ddcfea}.mini-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:15px}.mini{padding:11px;border-radius:10px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12)}.mini strong{display:block;font-size:1.05rem}.mini span{font-size:.63rem;color:#d9cbe4}.section-stack{display:grid;gap:14px}.note{font-size:.68rem;color:#85788c;margin-top:10px;line-height:1.45}@media(max-width:900px){.analytics-grid{grid-template-columns:1fr}}@media(max-width:700px){.funnel-row{grid-template-columns:1fr auto}.track{grid-column:1/-1}.count{grid-column:2;grid-row:1}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="prospects">0</strong><span>Total Prospects</span><small>Current active records</small></div><div class="metric"><strong id="cacheRate">0%</strong><span>Research Cache Hit Rate</span><small>Last 30 days</small></div><div class="metric"><strong id="mrr">$0</strong><span>Synced MRR</span><small>Actual Stripe subscriptions</small></div><div class="metric"><strong id="activeJobs">0</strong><span>Active Jobs</span><small>Queued + running</small></div></div>
  <div class="analytics-grid"><div class="section-stack"><section class="surface"><div class="surface-head"><div><h3>Prospect Funnel</h3><p>Current pipeline by sales stage.</p></div></div><div class="surface-body"><div id="prospectFunnel" class="funnel"></div></div></section><section class="surface"><div class="surface-head"><div><h3>Platform Efficiency</h3><p>External source usage and image-production efficiency over the last 30 days.</p></div></div><div class="surface-body"><div class="mini-grid"><div class="mini"><strong id="googleCalls">0</strong><span>Google lookups</span></div><div class="mini"><strong id="openaiCalls">0</strong><span>AI operations</span></div><div class="mini"><strong id="imageAttempts">0</strong><span>Image attempts</span></div><div class="mini"><strong id="approvedImages">0</strong><span>Approved images</span></div></div><div class="note">Research caching and confidence-driven source routing reduce repeated paid lookups while preserving manual data and verified evidence.</div></div></section></div><section class="surface revenue-card"><h3>Revenue Snapshot</h3><p>Recurring revenue is calculated from synchronized Stripe subscription amounts instead of a fixed per-customer model.</p><div class="revenue-big" id="revenueMrr">$0</div><div class="revenue-sub">Actual synchronized MRR</div><div class="mini-grid"><div class="mini"><strong id="customers">0</strong><span>Total customers</span></div><div class="mini"><strong id="synced">0</strong><span>Billing synced</span></div><div class="mini"><strong id="annualized">$0</strong><span>Annualized recurring</span></div><div class="mini"><strong id="pastDue">0</strong><span>Past due / delinquent</span></div></div><div class="note">Customers without a Stripe billing snapshot are excluded from MRR until their billing page is synchronized or Stripe sends a lifecycle webhook.</div></section></div>
</AdminShell>
<script is:inline>
const row=(label,count,total)=>`<div class="funnel-row"><div class="funnel-label">${label}</div><div class="track"><div class="fill" style="width:${total?Math.max(3,count/total*100):0}%"></div></div><div class="count">${count}</div></div>`;const money=cents=>new Intl.NumberFormat(undefined,{style:'currency',currency:'USD',maximumFractionDigits:0}).format((cents||0)/100);async function load(){try{const d=await window.adminApi('/api/admin/dashboard-summary'),sc=d.prospects?.stage_counts||{},pt=d.prospects?.total||0,mrr=d.billing?.actual_mrr_cents||0;document.getElementById('prospects').textContent=pt;document.getElementById('cacheRate').textContent=(d.efficiency?.cache_hit_rate||0)+'%';document.getElementById('mrr').textContent=money(mrr);document.getElementById('revenueMrr').textContent=money(mrr);document.getElementById('customers').textContent=d.customers?.total||0;document.getElementById('synced').textContent=d.billing?.synced_customers||0;document.getElementById('pastDue').textContent=d.billing?.past_due||0;document.getElementById('annualized').textContent=money(mrr*12);document.getElementById('activeJobs').textContent=(d.jobs?.counts?.Queued||0)+(d.jobs?.counts?.Running||0);document.getElementById('googleCalls').textContent=d.efficiency?.google_calls_30d||0;document.getElementById('openaiCalls').textContent=d.efficiency?.openai_calls_30d||0;document.getElementById('imageAttempts').textContent=d.efficiency?.image_attempts_30d||0;document.getElementById('approvedImages').textContent=d.efficiency?.approved_images_30d||0;const pg=[['Qualified',sc.Qualified||0],['Concept Built',sc['Concept Built']||0],['Contacted',sc.Contacted||0],['Concept Viewed',sc['Concept Viewed']||0],['Won',sc.Won||0],['Lost',sc.Lost||0]];document.getElementById('prospectFunnel').innerHTML=pg.map(([l,n])=>row(l,n,pt)).join('')}catch(err){document.getElementById('prospectFunnel').innerHTML='<div class="empty">Analytics could not be loaded. Refresh to retry.</div>'}}window.addEventListener('admin-authenticated',load);load();
</script>