---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Design Studio" eyebrow="Concept Design" description="Review the website visually, refine its direction, and apply deliberate design changes through the Concept Build system." active="design">
<style is:global>
.ds-toolbar{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:10px;margin-bottom:16px}.ds-toolbar select{min-height:42px;padding:0 12px}.studio-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(340px,.65fr);gap:16px;align-items:start}.preview-card{min-height:760px;overflow:hidden}.preview-head{display:flex;justify-content:space-between;gap:16px;align-items:center;padding:15px 18px;border-bottom:1px solid #ebe8ed}.preview-head h3{margin:0}.preview-head p{margin:4px 0 0;color:#6d6672;font-size:.76rem}.device-switch{display:flex;gap:4px;padding:3px;border:1px solid #e2dee5;border-radius:8px;background:#fbfafc}.device-switch button{min-height:32px;padding:0 10px;border:0;border-radius:6px;background:transparent;color:#6d6672;font-size:.72rem;font-weight:600;cursor:pointer}.device-switch button.active{background:#2d0b50;color:#fff}.preview-stage{display:grid;place-items:center;min-height:700px;padding:18px;background:#f2f0f3;overflow:auto}.preview-shell{width:100%;height:680px;background:#fff;border:1px solid #cbc6ce;border-radius:10px;overflow:hidden;box-shadow:0 8px 24px rgba(30,7,53,.09);transition:width .18s ease}.preview-shell.mobile{width:min(390px,100%)}.preview-shell iframe{width:100%;height:100%;border:0;background:#fff}.preview-empty{display:grid;place-items:center;text-align:center;color:#8b8490;padding:28px}.preview-empty strong{display:block;color:#18151b;font-size:1rem;margin-bottom:6px}.studio-side{display:grid;gap:14px;position:sticky;top:72px}.chat-card{min-height:520px;display:grid;grid-template-rows:auto 1fr auto}.chat-head{padding:15px 17px;border-bottom:1px solid #ebe8ed;display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.chat-head h3{margin:0}.chat-head p{margin:4px 0 0;color:#6d6672;font-size:.74rem}.guard{display:inline-flex;align-items:center;gap:6px;color:#17603a;font-size:.7rem;font-weight:600;white-space:nowrap}.guard:before{content:"";width:7px;height:7px;border-radius:50%;background:#17603a}.messages{padding:16px;display:grid;gap:12px;align-content:start;overflow:auto;max-height:390px;background:#fbfafc}.msg{max-width:90%;padding:10px 12px;border-radius:9px;font-size:.8rem;line-height:1.55;white-space:pre-wrap}.msg.user{justify-self:end;background:#2d0b50;color:#fff;border-bottom-right-radius:3px}.msg.assistant{justify-self:start;background:#fff;border:1px solid #e2dee5;color:#39343d;border-bottom-left-radius:3px}.msg.out{border-color:#e9c59f;background:#fffaf3}.proposal{margin-top:10px;padding:10px;border-radius:8px;background:#f7f3fa;border:1px solid #eee6f6}.proposal-title{font-size:.69rem;font-weight:600;color:#54218a;margin-bottom:7px}.chips{display:flex;flex-wrap:wrap;gap:5px}.chip{padding:4px 7px;border-radius:999px;background:#fff;border:1px solid #e2dee5;font-size:.62rem;font-weight:500;color:#514b56}.apply-row{display:flex;gap:7px;align-items:center;margin-top:9px}.applied{font-size:.68rem;color:#17603a;font-weight:600}.composer{display:grid;grid-template-columns:1fr auto;gap:8px;padding:12px;border-top:1px solid #ebe8ed;background:#fff}.composer textarea{min-height:64px;max-height:150px;padding:10px 11px;resize:vertical}.profile-box{padding:16px}.profile-box h3{margin:0 0 10px}.profile-row{padding:8px 0;border-top:1px solid #ebe8ed}.profile-row:first-of-type{border-top:0}.profile-row label{display:block;font-size:.72rem;font-weight:600;color:#6d6672}.profile-row div{font-size:.77rem;font-weight:500;color:#39343d;margin-top:3px;overflow-wrap:anywhere}.boundary{padding:14px 16px}.boundary summary{cursor:pointer;font-size:.8rem;font-weight:600;color:#514b56}.boundary p{font-size:.74rem;color:#6d6672;margin:10px 0}.boundary ul{padding-left:18px;margin:0;color:#6d6672;font-size:.71rem;line-height:1.6}.empty-chat{padding:54px 20px;text-align:center;color:#8b8490}.empty-chat strong{display:block;color:#18151b;font-size:.96rem;margin-bottom:6px}.notice{display:none;padding:11px 13px;border-radius:8px;margin-bottom:14px}.notice.show{display:block;background:#e7f5ec;color:#17603a}.notice.error{background:#fceaea;color:#a12b2b}@media(max-width:1180px){.studio-grid{grid-template-columns:1fr}.studio-side{position:static;grid-template-columns:1fr 1fr}.chat-card{min-height:560px}.preview-card{min-height:660px}.preview-stage{min-height:600px}.preview-shell{height:580px}}@media(max-width:760px){.ds-toolbar,.composer,.studio-side{grid-template-columns:1fr}.preview-head{align-items:flex-start;flex-direction:column}.device-switch{width:100%}.device-switch button{flex:1}.preview-stage{padding:10px;min-height:560px}.preview-shell{height:540px}.msg{max-width:95%}.composer .admin-action{width:100%}}
</style>
<div id="notice" class="notice"></div>
<div class="ds-toolbar">
  <select id="prospect"><option value="">Select a prospect...</option></select>
  <a id="openConcept" class="admin-action" href="#" target="_blank" rel="noopener" style="display:none">Open Concept ↗</a>
</div>
<div class="studio-grid">
  <section class="surface preview-card">
    <div class="preview-head"><div><h3>Website Preview</h3><p>The rendered concept is the primary design surface. Use the conversation to change the design specification, then rebuild.</p></div><div class="device-switch" aria-label="Preview size"><button type="button" id="desktopPreview" class="active">Desktop</button><button type="button" id="mobilePreview">Mobile</button></div></div>
    <div class="preview-stage">
      <div id="previewEmpty" class="preview-empty"><div><strong>Select a prospect</strong>Choose a prospect with a concept to review the website here.</div></div>
      <div id="previewShell" class="preview-shell" style="display:none"><iframe id="conceptPreview" title="Concept website preview" loading="lazy"></iframe></div>
    </div>
  </section>
  <div class="studio-side">
    <section class="surface chat-card">
      <div class="chat-head"><div><h3>Design Direction</h3><p>Describe what should change. Nothing is applied until you choose Apply & Rebuild.</p></div><span class="guard">Design sandbox</span></div>
      <div id="messages" class="messages"><div class="empty-chat"><strong>Select a prospect</strong>Choose a prospect to start a design conversation.</div></div>
      <form id="composer" class="composer"><textarea id="message" maxlength="2000" placeholder="Example: Make the site feel more premium, keep it local and approachable, and put the services before the customer journey." disabled></textarea><button id="send" class="admin-action purple" type="submit" disabled>Send</button></form>
    </section>
    <section class="surface profile-box"><h3>Current Design</h3><div id="profile"><div class="empty">Select a prospect.</div></div></section>
    <details class="surface boundary"><summary>Design Studio boundaries</summary><p>This workspace is intentionally restricted to public website design.</p><ul><li>Website concept design only</li><li>No dashboard, billing, user, or settings changes</li><li>No source-code or infrastructure changes</li><li>Only validated design-profile fields can be applied</li></ul></details>
  </div>
</div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);let prospects=[],selectedId=null,state=null,loadSeq=0,prospectsPromise=null;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='notice show'+(b?' error':'');setTimeout(()=>n.className='notice',5500)}
function parse(v,f={}){try{return v?JSON.parse(v):f}catch{return f}}
function clearConceptLink(){const link=el('openConcept');link.removeAttribute('href');link.style.display='none';setPreview(null)}
function setPreview(url){const frame=el('conceptPreview'),shell=el('previewShell'),empty=el('previewEmpty');if(url){if(frame.src!==url)frame.src=url;shell.style.display='block';empty.style.display='none'}else{frame.removeAttribute('src');shell.style.display='none';empty.style.display='grid'}}
function profileRows(p){if(!p)return '<div class="empty">No design profile yet.</div>';const rows=[['Archetype',p.archetype],['Mood',p.mood],['Image direction',p.image_theme],['Headline',p.headline],['CTA',p.cta],['Sections',(p.sections||[]).join(' · ')],['Journey',(p.process||[]).join(' → ')]].filter(([,v])=>v&&String(v).trim());return rows.map(([k,v])=>`<div class="profile-row"><label>${esc(k)}</label><div>${esc(v)}</div></div>`).join('')||'<div class="empty">No design profile yet.</div>'}
function proposalMarkup(m){const p=parse(m.proposal_json,null);if(!p)return '';const labels=[];if(p.archetype)labels.push(`Archetype: ${p.archetype}`);if(p.mood)labels.push(`Mood: ${p.mood}`);if(p.image_theme)labels.push(`Imagery: ${p.image_theme}`);if(p.headline)labels.push(`Headline: ${p.headline}`);if(p.cta)labels.push(`CTA: ${p.cta}`);if(p.sections?.length)labels.push(`Sections: ${p.sections.join(', ')}`);const applied=m.applied_at?`<span class="applied">Applied ${new Date(m.applied_at+'Z').toLocaleString()}</span>`:`<button class="admin-action compact purple" data-apply="${m.id}">Apply & Rebuild</button>`;return `<div class="proposal"><div class="proposal-title">Proposed website design</div><div class="chips">${labels.map(x=>`<span class="chip">${esc(x)}</span>`).join('')}</div><div class="apply-row">${applied}</div></div>`}
function renderMessages(){const msgs=state?.messages||[];if(!msgs.length){el('messages').innerHTML='<div class="empty-chat"><strong>Start the design conversation</strong>Describe what you want the public-facing website to feel like or emphasize.</div>';return}el('messages').innerHTML=msgs.map(m=>`<div class="msg ${m.role==='user'?'user':'assistant'} ${m.role==='assistant'&&!m.in_scope?'out':''}">${esc(m.content)}${m.role==='assistant'?proposalMarkup(m):''}</div>`).join('');el('messages').scrollTop=el('messages').scrollHeight;document.querySelectorAll('[data-apply]').forEach(b=>b.onclick=()=>applyProposal(Number(b.dataset.apply),b))}
function renderState(){el('profile').innerHTML=profileRows(state?.current_design);const p=state?.prospect;const link=el('openConcept');if(p?.concept_url&&Number(p.id)===selectedId){link.href=p.concept_url;link.style.display='inline-flex';setPreview(p.concept_url)}else{clearConceptLink()}renderMessages()}
async function loadProspects(){if(prospectsPromise)return prospectsPromise;prospectsPromise=(async()=>{const d=await window.adminApi('/api/admin/prospects');prospects=d.prospects||[];prospects.sort((a,b)=>String(a.business_name).localeCompare(String(b.business_name)));el('prospect').innerHTML='<option value="">Select a prospect...</option>'+prospects.map(p=>`<option value="${p.id}">${esc(p.business_name)}${p.city?` — ${esc(p.city)}`:''}</option>`).join('');const q=new URLSearchParams(location.search).get('prospect');if(q&&prospects.some(p=>String(p.id)===q)){el('prospect').value=q;selectedId=Number(q);await loadChat()}})();try{return await prospectsPromise}catch(e){prospectsPromise=null;throw e}}
async function loadChat(){const requestId=++loadSeq,id=selectedId;clearConceptLink();if(!id){state=null;el('message').disabled=true;el('send').disabled=true;renderState();return}el('message').disabled=true;el('send').disabled=true;const next=await window.adminApi(`/api/admin/design-chat/${id}`);if(requestId!==loadSeq||id!==selectedId)return;if(Number(next?.prospect?.id)!==id)throw new Error('Design Studio returned the wrong prospect. Refresh and try again.');state=next;el('message').disabled=false;el('send').disabled=false;history.replaceState(null,'',`?prospect=${id}`);renderState()}
async function sendMessage(e){e.preventDefault();if(!selectedId)return;const text=el('message').value.trim();if(!text)return;const btn=el('send');btn.disabled=true;btn.textContent='Thinking...';try{await window.adminApi(`/api/admin/design-chat/${selectedId}`,{method:'POST',body:JSON.stringify({message:text})});el('message').value='';await loadChat()}catch(err){notice(err.message,true)}finally{btn.disabled=false;btn.textContent='Send'}}
async function applyProposal(messageId,button){if(!confirm('Apply this website-design proposal and rebuild the concept site?'))return;button.disabled=true;button.textContent='Rebuilding...';try{const id=selectedId;const d=await window.adminApi(`/api/admin/design-chat/${id}/apply/${messageId}`,{method:'POST',body:'{}'});if(id!==selectedId)return;notice('Design applied and concept rebuilt.');await loadChat();if(d.concept_url&&id===selectedId){const link=el('openConcept');link.href=d.concept_url;link.style.display='inline-flex';setPreview(d.concept_url)}}catch(err){notice(err.message,true)}finally{button.disabled=false;button.textContent='Apply & Rebuild'}}
el('desktopPreview').onclick=()=>{el('previewShell').classList.remove('mobile');el('desktopPreview').classList.add('active');el('mobilePreview').classList.remove('active')};
el('mobilePreview').onclick=()=>{el('previewShell').classList.add('mobile');el('mobilePreview').classList.add('active');el('desktopPreview').classList.remove('active')};
el('prospect').addEventListener('change',async()=>{selectedId=el('prospect').value?Number(el('prospect').value):null;state=null;clearConceptLink();el('message').disabled=true;el('send').disabled=true;try{await loadChat()}catch(err){if(selectedId){notice(err.message,true)}else{renderState()}}});el('composer').addEventListener('submit',sendMessage);window.addEventListener('admin-authenticated',()=>loadProspects().catch(e=>notice(e.message,true)));loadProspects().catch(()=>{});
</script>
