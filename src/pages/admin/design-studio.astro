---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="AI Design Studio" eyebrow="Website Design Only" description="Have a conversation about how a prospect concept should look and feel. Design Studio is technically restricted from changing the CajunSites dashboard, billing, users, automations, source code, or other system settings." active="design">
<style is:global>
.ds-toolbar{display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:10px;padding:12px;background:#fff;border:1px solid #e9e2ed;border-radius:14px;margin-bottom:14px}.ds-toolbar select{min-height:44px;padding:0 12px}.ds-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.65fr);gap:14px;align-items:start}.chat-card{min-height:690px;display:grid;grid-template-rows:auto 1fr auto}.chat-head{padding:16px 18px;border-bottom:1px solid #eee9f1;display:flex;justify-content:space-between;gap:12px;align-items:center}.chat-head h3{margin:0}.chat-head p{margin:4px 0 0;color:#81758a;font-size:.72rem}.guard{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:999px;background:#e8f7ee;color:#17683a;font-size:.65rem;font-weight:900;white-space:nowrap}.messages{padding:18px;display:grid;gap:12px;align-content:start;overflow:auto;max-height:590px;background:#fcfbfe}.msg{max-width:78%;padding:12px 14px;border-radius:14px;font-size:.8rem;line-height:1.55;white-space:pre-wrap}.msg.user{justify-self:end;background:#451078;color:#fff;border-bottom-right-radius:4px}.msg.assistant{justify-self:start;background:#fff;border:1px solid #e9e2ed;color:#45374c;border-bottom-left-radius:4px}.msg.out{border-color:#f0cfb4;background:#fff8f0}.proposal{margin-top:10px;padding:10px;border-radius:10px;background:#f8f4fb;border:1px solid #eadff1}.proposal-title{font-size:.62rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#6d24b8;margin-bottom:7px}.chips{display:flex;flex-wrap:wrap;gap:5px}.chip{padding:5px 7px;border-radius:999px;background:#fff;border:1px solid #e6ddeb;font-size:.62rem;font-weight:800;color:#5b3474}.apply-row{display:flex;gap:7px;align-items:center;margin-top:9px}.applied{font-size:.66rem;color:#168c48;font-weight:850}.composer{display:grid;grid-template-columns:1fr auto;gap:9px;padding:13px;border-top:1px solid #eee9f1;background:#fff}.composer textarea{min-height:58px;max-height:150px;padding:10px 11px;resize:vertical}.sidebar-stack{display:grid;gap:14px;position:sticky;top:72px}.boundary{padding:16px}.boundary h3{margin:0 0 10px}.boundary p{font-size:.75rem;color:#665a6d;margin:0 0 10px}.boundary ul{padding-left:18px;margin:0;color:#665a6d;font-size:.72rem;line-height:1.65}.profile-box{padding:16px}.profile-box h3{margin:0 0 12px}.profile-row{padding:8px 0;border-top:1px solid #eee9f1}.profile-row:first-of-type{border-top:0}.profile-row label{display:block;font-size:.6rem;text-transform:uppercase;font-weight:900;color:#8b7f91}.profile-row div{font-size:.76rem;font-weight:750;color:#3e2850;margin-top:3px;overflow-wrap:anywhere}.empty-chat{padding:70px 20px;text-align:center;color:#83778a}.empty-chat strong{display:block;color:#3c145a;font-size:1rem;margin-bottom:6px}.notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}@media(max-width:1050px){.ds-grid{grid-template-columns:1fr}.sidebar-stack{position:static;grid-template-columns:1fr 1fr}.chat-card{min-height:620px}}@media(max-width:700px){.ds-toolbar,.composer,.sidebar-stack{grid-template-columns:1fr}.msg{max-width:92%}.chat-head{align-items:flex-start;flex-direction:column}.composer .admin-action{width:100%}}
</style>
<div id="notice" class="notice"></div>
<div class="ds-toolbar">
  <select id="prospect"><option value="">Select a prospect...</option></select>
  <a id="openConcept" class="admin-action" href="#" target="_blank" rel="noopener" style="display:none">Open Concept ↗</a>
</div>
<div class="ds-grid">
  <section class="surface chat-card">
    <div class="chat-head"><div><h3>Design Conversation</h3><p>Talk naturally about the selected website concept. Nothing is applied until you explicitly choose Apply & Rebuild.</p></div><span class="guard">✓ Website-design sandbox</span></div>
    <div id="messages" class="messages"><div class="empty-chat"><strong>Select a prospect</strong>Choose a prospect above to start a design conversation.</div></div>
    <form id="composer" class="composer"><textarea id="message" maxlength="2000" placeholder="Example: Make the site feel more premium, keep it local and approachable, and put the services before the customer journey." disabled></textarea><button id="send" class="admin-action purple" type="submit" disabled>Send</button></form>
  </section>
  <div class="sidebar-stack">
    <section class="surface boundary"><h3>Hard Boundary</h3><p>This assistant is intentionally unable to redesign or modify the CajunSites administrative application.</p><ul><li>Website concept design only</li><li>No dashboard or navigation changes</li><li>No billing, CRM, user, or settings changes</li><li>No source-code or infrastructure changes</li><li>No arbitrary tool or database access</li><li>Only validated design-profile fields can be applied</li></ul></section>
    <section class="surface profile-box"><h3>Current Design</h3><div id="profile"><div class="empty">Select a prospect.</div></div></section>
  </div>
</div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);let prospects=[],selectedId=null,state=null,loadSeq=0,prospectsPromise=null;
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='notice show'+(b?' error':'');setTimeout(()=>n.className='notice',5500)}
function parse(v,f={}){try{return v?JSON.parse(v):f}catch{return f}}
function clearConceptLink(){const link=el('openConcept');link.removeAttribute('href');link.style.display='none'}
function profileRows(p){if(!p)return '<div class="empty">No design profile yet.</div>';const rows=[['Archetype',p.archetype],['Mood',p.mood],['Image direction',p.image_theme],['Headline',p.headline],['CTA',p.cta],['Sections',(p.sections||[]).join(' · ')],['Journey',(p.process||[]).join(' → ')]].filter(([,v])=>v&&String(v).trim());return rows.map(([k,v])=>`<div class="profile-row"><label>${esc(k)}</label><div>${esc(v)}</div></div>`).join('')||'<div class="empty">No design profile yet.</div>'}
function proposalMarkup(m){const p=parse(m.proposal_json,null);if(!p)return '';const labels=[];if(p.archetype)labels.push(`Archetype: ${p.archetype}`);if(p.mood)labels.push(`Mood: ${p.mood}`);if(p.image_theme)labels.push(`Imagery: ${p.image_theme}`);if(p.headline)labels.push(`Headline: ${p.headline}`);if(p.cta)labels.push(`CTA: ${p.cta}`);if(p.sections?.length)labels.push(`Sections: ${p.sections.join(', ')}`);const applied=m.applied_at?`<span class="applied">✓ Applied ${new Date(m.applied_at+'Z').toLocaleString()}</span>`:`<button class="admin-action compact purple" data-apply="${m.id}">Apply & Rebuild</button>`;return `<div class="proposal"><div class="proposal-title">Proposed website design</div><div class="chips">${labels.map(x=>`<span class="chip">${esc(x)}</span>`).join('')}</div><div class="apply-row">${applied}</div></div>`}
function renderMessages(){const msgs=state?.messages||[];if(!msgs.length){el('messages').innerHTML='<div class="empty-chat"><strong>Start the design conversation</strong>Describe what you want the public-facing website to feel like or emphasize.</div>';return}el('messages').innerHTML=msgs.map(m=>`<div class="msg ${m.role==='user'?'user':'assistant'} ${m.role==='assistant'&&!m.in_scope?'out':''}">${esc(m.content)}${m.role==='assistant'?proposalMarkup(m):''}</div>`).join('');el('messages').scrollTop=el('messages').scrollHeight;document.querySelectorAll('[data-apply]').forEach(b=>b.onclick=()=>applyProposal(Number(b.dataset.apply),b))}
function renderState(){el('profile').innerHTML=profileRows(state?.current_design);const p=state?.prospect;const link=el('openConcept');if(p?.concept_url&&Number(p.id)===selectedId){link.href=p.concept_url;link.style.display='inline-flex'}else{clearConceptLink()}renderMessages()}
async function loadProspects(){if(prospectsPromise)return prospectsPromise;prospectsPromise=(async()=>{const d=await window.adminApi('/api/admin/prospects');prospects=d.prospects||[];prospects.sort((a,b)=>String(a.business_name).localeCompare(String(b.business_name)));el('prospect').innerHTML='<option value="">Select a prospect...</option>'+prospects.map(p=>`<option value="${p.id}">${esc(p.business_name)}${p.city?` — ${esc(p.city)}`:''}</option>`).join('');const q=new URLSearchParams(location.search).get('prospect');if(q&&prospects.some(p=>String(p.id)===q)){el('prospect').value=q;selectedId=Number(q);await loadChat()}})();try{return await prospectsPromise}catch(e){prospectsPromise=null;throw e}}
async function loadChat(){const requestId=++loadSeq,id=selectedId;clearConceptLink();if(!id){state=null;el('message').disabled=true;el('send').disabled=true;renderState();return}el('message').disabled=true;el('send').disabled=true;const next=await window.adminApi(`/api/admin/design-chat/${id}`);if(requestId!==loadSeq||id!==selectedId)return;if(Number(next?.prospect?.id)!==id)throw new Error('Design Studio returned the wrong prospect. Refresh and try again.');state=next;el('message').disabled=false;el('send').disabled=false;history.replaceState(null,'',`?prospect=${id}`);renderState()}
async function sendMessage(e){e.preventDefault();if(!selectedId)return;const text=el('message').value.trim();if(!text)return;const btn=el('send');btn.disabled=true;btn.textContent='Thinking...';try{await window.adminApi(`/api/admin/design-chat/${selectedId}`,{method:'POST',body:JSON.stringify({message:text})});el('message').value='';await loadChat()}catch(err){notice(err.message,true)}finally{btn.disabled=false;btn.textContent='Send'}}
async function applyProposal(messageId,button){if(!confirm('Apply this website-design proposal and rebuild the concept site?'))return;button.disabled=true;button.textContent='Rebuilding...';try{const id=selectedId;const d=await window.adminApi(`/api/admin/design-chat/${id}/apply/${messageId}`,{method:'POST',body:'{}'});if(id!==selectedId)return;notice('Design applied and concept rebuilt.');await loadChat();if(d.concept_url&&id===selectedId){const link=el('openConcept');link.href=d.concept_url;link.style.display='inline-flex'}}catch(err){notice(err.message,true)}finally{button.disabled=false;button.textContent='Apply & Rebuild'}}
el('prospect').addEventListener('change',async()=>{selectedId=el('prospect').value?Number(el('prospect').value):null;state=null;clearConceptLink();el('message').disabled=true;el('send').disabled=true;try{await loadChat()}catch(err){if(selectedId){notice(err.message,true)}else{renderState()}}});el('composer').addEventListener('submit',sendMessage);window.addEventListener('admin-authenticated',()=>loadProspects().catch(e=>notice(e.message,true)));loadProspects().catch(()=>{});
</script>
