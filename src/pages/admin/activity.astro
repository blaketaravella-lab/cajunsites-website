---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Activity" eyebrow="Operations History" description="Review lifecycle changes, research, concept builds, site updates, notes, and conversions." active="activity">
  <style>
    .timeline{display:grid;gap:0}.event{display:grid;grid-template-columns:18px 160px 170px 1fr;gap:12px;align-items:start;padding:14px 18px;border-bottom:1px solid #eee9f1}.event:last-child{border-bottom:0}.rail{position:relative;display:flex;justify-content:center;height:100%}.rail:before{content:"";position:absolute;top:14px;bottom:-14px;width:2px;background:#ece6f0}.event:last-child .rail:before{display:none}.dot{width:9px;height:9px;border-radius:50%;background:#7425d0;position:relative;z-index:1;margin-top:4px;box-shadow:0 0 0 4px #f4edf9}.time{font-size:.69rem;color:#8e8295;white-space:nowrap}.business{font-size:.77rem}.business strong{display:block;color:#382047}.business small{display:block;color:#94889a;margin-top:3px}.description{font-size:.78rem;color:#564a5d;line-height:1.5}.event-label{margin-bottom:5px}@media(max-width:820px){.event{grid-template-columns:18px 1fr}.time,.business,.description{grid-column:2}.time{grid-row:auto}.rail{grid-row:1/5}.event-label{grid-column:2}}
  </style>
  <section class="surface"><div class="surface-head"><div><h3>Operations Timeline</h3><p>A chronological audit of work performed across prospects and customers.</p></div></div><div id="timeline" class="timeline"><div class="empty">Loading activity...</div></div></section>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),label=t=>({'status_changed':'Status Changed','onboarding_received':'Onboarding Received','note_added':'Note Added','site_updated':'Site Updated','prospect_updated':'Prospect Updated','prospect_research':'Business Research','concept_build':'Concept Build','prospect_converted':'Prospect Converted'}[t]||String(t||'Activity').replaceAll('_',' ')),cls=t=>t==='prospect_converted'?'green':t==='concept_build'||t==='prospect_research'?'gold':t==='onboarding_received'?'green':'gray';async function load(){try{const d=await window.adminApi('/api/admin/activity'),a=d.activity||[];document.getElementById('timeline').innerHTML=a.length?a.map(x=>`<div class="event"><div class="rail"><span class="dot"></span></div><div class="time">${e(x.created_at)}</div><div class="business"><strong>${e(x.business_name||'System')}</strong>${x.email?`<small>${e(x.email)}</small>`:''}</div><div class="description"><div class="event-label"><span class="pill ${cls(x.event_type)}">${e(label(x.event_type))}</span></div>${e(x.description)}</div></div>`).join(''):`<div class="empty">${d.storageReady===false?'Apply the admin operations database migration to enable activity history.':'No activity has been recorded yet.'}</div>`}catch{}}window.addEventListener('admin-authenticated',load);load();
</script>