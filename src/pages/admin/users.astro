---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Internal Users" eyebrow="Access Control" description="Manage CajunSites internal accounts, roles, sessions, and access." active="users">
  <style is:global>
    .notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.users-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:14px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.form-grid .full{grid-column:1/-1}.field{display:grid;gap:5px}.field label{font-size:.64rem;font-weight:900;color:#6d6174;text-transform:uppercase}.field input,.field select{width:100%;padding:10px 11px}.actions{display:flex;gap:6px;flex-wrap:wrap}.muted{color:#8b7f91;font-size:.73rem;line-height:1.45}.role-help{display:grid;gap:8px}.role-card{padding:10px 11px;border:1px solid #eee8f1;border-radius:10px}.role-card strong{display:block;color:#42165f;margin-bottom:3px}.user-name{font-weight:850;color:#382047}.user-email{font-size:.7rem;color:#8c8093;margin-top:2px}.roleSelect{min-width:112px;padding:7px 9px}.security-note{padding:14px;border-radius:11px;background:#f8f3fc;color:#5c4967;font-size:.74rem;line-height:1.5}@media(max-width:1050px){.users-grid{grid-template-columns:1fr}}@media(max-width:620px){.form-grid{grid-template-columns:1fr}.form-grid .full{grid-column:auto}.actions{min-width:210px}}
  </style>
  <div id="notice" class="notice"></div>
  <div class="users-grid"><section class="surface"><div class="surface-head"><div><h3>Current Users</h3><p>Disabling or removing a user immediately invalidates their active sessions.</p></div></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last Login</th><th>Actions</th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Loading...</td></tr></tbody></table></div></section><div class="side-stack"><section class="surface"><div class="surface-head"><div><h3>Add Internal User</h3><p>Create an individual account with least-privilege access.</p></div></div><div class="surface-body"><form id="addForm" class="form-grid"><div class="field"><label for="name">Name</label><input id="name" required/></div><div class="field"><label for="email">Email</label><input id="email" type="email" required/></div><div class="field"><label for="role">Role</label><select id="role"><option value="operator">Operator</option><option value="admin">Admin</option><option value="read_only">Read Only</option><option value="owner">Owner</option></select></div><div class="field"><label for="password">Temporary Password</label><input id="password" type="password" minlength="12" required/></div><div class="full"><button class="admin-action primary" type="submit">Add User</button></div></form></div></section><section class="surface"><div class="surface-head"><div><h3>Role Definitions</h3><p>Keep owner access limited.</p></div></div><div class="surface-body"><div class="role-help"><div class="role-card"><strong>Owner</strong><div class="muted">Full access including users and sensitive settings.</div></div><div class="role-card"><strong>Admin</strong><div class="muted">Full operational access without user administration.</div></div><div class="role-card"><strong>Operator</strong><div class="muted">Customer, onboarding, production, notes, and sites.</div></div><div class="role-card"><strong>Read Only</strong><div class="muted">View dashboard data without making changes.</div></div></div><div class="security-note" style="margin-top:12px">Internal access uses server-side sessions and secure cookies. Password resets end existing sessions for the affected user.</div></div></section></div></div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),fmt=v=>v?new Date(v.replace?.(' ','T')||v).toLocaleString():'Never';let users=[];function notice(message,bad=false){const n=document.getElementById('notice');n.textContent=message;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',4500)}function render(){const rows=document.getElementById('rows');rows.innerHTML=users.length?users.map(u=>`<tr><td><div class="user-name">${e(u.name)}</div><div class="user-email">${e(u.email)}</div></td><td><select class="roleSelect" data-id="${u.id}" ${u.id===window.adminUser?.id?'disabled':''}><option value="owner" ${u.role==='owner'?'selected':''}>Owner</option><option value="admin" ${u.role==='admin'?'selected':''}>Admin</option><option value="operator" ${u.role==='operator'?'selected':''}>Operator</option><option value="read_only" ${u.role==='read_only'?'selected':''}>Read Only</option></select></td><td><span class="pill ${u.is_active?'green':'gray'}">${u.is_active?'Active':'Disabled'}</span></td><td>${e(fmt(u.last_login_at))}</td><td><div class="actions"><button class="admin-action compact toggle" data-id="${u.id}" ${u.id===window.adminUser?.id?'disabled':''}>${u.is_active?'Disable':'Enable'}</button><button class="admin-action compact reset" data-id="${u.id}">Reset Password</button><button class="admin-action compact danger remove" data-id="${u.id}" ${u.id===window.adminUser?.id?'disabled':''}>Remove</button></div></td></tr>`).join(''):'<tr><td colspan="5" class="empty">No internal users found.</td></tr>';document.querySelectorAll('.roleSelect').forEach(s=>s.onchange=()=>patchUser(Number(s.dataset.id),{role:s.value}));document.querySelectorAll('.toggle').forEach(b=>b.onclick=()=>{const u=users.find(x=>x.id===Number(b.dataset.id));if(u)patchUser(u.id,{is_active:!u.is_active})});document.querySelectorAll('.remove').forEach(b=>b.onclick=()=>removeUser(Number(b.dataset.id)));document.querySelectorAll('.reset').forEach(b=>b.onclick=()=>resetPassword(Number(b.dataset.id)))}async function load(){try{if(window.adminUser&&window.adminUser.role!=='owner'){document.getElementById('rows').innerHTML='<tr><td colspan="5" class="empty">Owner access is required.</td></tr>';return}const d=await window.adminApi('/api/admin/users');users=d.users||[];render()}catch(err){notice(err.message,true)}}async function patchUser(id,data){try{await window.adminApi(`/api/admin/users/${id}`,{method:'PATCH',body:JSON.stringify(data)});notice('Internal user updated.');await load()}catch(err){notice(err.message,true);await load()}}async function removeUser(id){const u=users.find(x=>x.id===id);if(!u||!confirm(`Remove ${u.name} from CajunSites internal access?`))return;try{await window.adminApi(`/api/admin/users/${id}`,{method:'DELETE'});notice(`${u.name} was removed.`);await load()}catch(err){notice(err.message,true)}}async function resetPassword(id){const u=users.find(x=>x.id===id);if(!u)return;const password=prompt(`Enter a new password for ${u.name}. Minimum 12 characters.`);if(password===null)return;try{await window.adminApi(`/api/admin/users/${id}/password`,{method:'POST',body:JSON.stringify({password})});notice(`Password reset for ${u.name}. Their existing sessions were ended.`)}catch(err){notice(err.message,true)}}document.getElementById('addForm').addEventListener('submit',async ev=>{ev.preventDefault();try{await window.adminApi('/api/admin/users',{method:'POST',body:JSON.stringify({name:document.getElementById('name').value,email:document.getElementById('email').value,role:document.getElementById('role').value,password:document.getElementById('password').value})});ev.target.reset();document.getElementById('role').value='operator';notice('Internal user added.');await load()}catch(err){notice(err.message,true)}});window.addEventListener('admin-authenticated',load);if(window.adminUser)load();
</script>