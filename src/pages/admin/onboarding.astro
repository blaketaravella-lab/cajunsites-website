---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Onboarding" eyebrow="Customer Intake" description="Review onboarding submissions, flag missing information, and release complete customers into the build queue." active="onboarding">
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span></div><div class="metric"><strong id="received">0</strong><span>Onboarding Received</span></div><div class="metric"><strong id="waiting">0</strong><span>Waiting on Customer</span></div></div>
  <div id="notice" style="display:none;margin-bottom:12px;padding:11px 13px;border-radius:10px;background:#e8f7ee;color:#17683a"></div>
  <div class="admin-card" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Contact</th><th>Status</th><th>Submitted</th><th>Details</th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card" id="detail" style="margin-top:14px"><div class="empty">Select a customer to review onboarding details.</div></div>
</AdminShell>
<script is:inline>
let customers=[];const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not submitted';
function flash(m){const n=document.getElementById('notice');n.textContent=m;n.style.display='block';setTimeout(()=>n.style.display='none',3500)}
async function status(id,s){try{await window.adminApi(`/api/admin/customers/${id}/status`,{method:'POST',body:JSON.stringify({status:s})});flash(`Customer moved to ${s}.`);await load();show(id)}catch(err){alert(err.message)}}
async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=d.customers||[];document.getElementById('awaiting').textContent=customers.filter(x=>x.status==='Paid - Awaiting Onboarding').length;document.getElementById('received').textContent=customers.filter(x=>x.status==='Onboarding Received').length;document.getElementById('waiting').textContent=customers.filter(x=>x.status==='Waiting on Customer').length;const list=customers.filter(x=>['Paid - Awaiting Onboarding','Onboarding Received','Waiting on Customer'].includes(x.status));document.getElementById('rows').innerHTML=list.length?list.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong></td><td>${e(x.customer_name||'Not provided')}<br><small>${e(x.email)}</small></td><td><span class="pill ${x.status.includes('Awaiting')?'gold':''}">${e(x.status)}</span></td><td>${e(fmt(x.onboarding_submitted_at))}</td><td><button data-id="${x.id}" class="admin-action view">Review</button></td></tr>`).join(''):'<tr><td colspan="5" class="empty">No onboarding customers right now.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id)))}catch{}}
function show(id){const x=customers.find(c=>c.id===id);if(!x)return;let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{};const pairs=Object.entries(p);let actions='';if(x.status==='Onboarding Received')actions=`<button class="admin-action" id="waiting">Waiting on Customer</button> <button class="admin-action primary" id="ready">Mark Ready to Build</button>`;if(x.status==='Waiting on Customer')actions=`<button class="admin-action primary" id="receivedAgain">Mark Onboarding Received</button>`;document.getElementById('detail').innerHTML=`<div style="display:flex;justify-content:space-between;gap:16px;align-items:flex-start"><div><h3 style="margin-bottom:6px">${e(x.business_name||'Customer')}</h3><p><strong>Status:</strong> ${e(x.status)}</p></div><div>${actions}</div></div>${pairs.length?`<div class="admin-grid">${pairs.map(([k,v])=>`<div><small style="text-transform:capitalize;color:var(--muted)">${e(k.replaceAll('_',' '))}</small><div style="overflow-wrap:anywhere">${e(v||'Not provided')}</div></div>`).join('')}</div>`:'<p>No stored onboarding submission yet.</p>'}`;document.getElementById('waiting')?.addEventListener('click',()=>status(x.id,'Waiting on Customer'));document.getElementById('ready')?.addEventListener('click',()=>status(x.id,'Ready to Build'));document.getElementById('receivedAgain')?.addEventListener('click',()=>status(x.id,'Onboarding Received'))}
window.addEventListener('admin-authenticated',load);load();
</script>