---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Onboarding" eyebrow="Customer Intake" description="Review submissions, resolve missing information, and release complete customers into production." active="onboarding">
  <style is:global>
    .notice{display:none;margin-bottom:12px;padding:11px 13px;border-radius:10px;background:#e8f7ee;color:#17683a}.intake-banner{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:17px 19px;margin-bottom:14px;background:linear-gradient(135deg,#fff,#faf5ff)}.intake-banner h3{margin:0}.intake-banner p{margin:4px 0 0;color:#807489;font-size:.78rem}.detail{margin-top:14px}.detail-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;padding:18px 19px;border-bottom:1px solid #eee9f1}.detail-head h3{font-size:1.2rem;margin-bottom:6px}.detail-actions{display:flex;gap:7px;flex-wrap:wrap}.answer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;padding:17px 19px}.answer{padding:11px 12px;border:1px solid #eee8f1;border-radius:11px;background:#fff}.answer small{display:block;text-transform:capitalize;color:#8a7e90;margin-bottom:5px;font-weight:800;font-size:.64rem}.contact-small{color:#8a7e90}.progress{display:flex;gap:6px;align-items:center}.progress-dot{width:8px;height:8px;border-radius:50%;background:#d8d4df}.progress-dot.active{background:#7425d0}.progress-dot.done{background:#168745}@media(max-width:900px){.answer-grid{grid-template-columns:1fr 1fr}.intake-banner,.detail-head{display:block}.detail-actions{margin-top:12px}}@media(max-width:620px){.answer-grid{grid-template-columns:1fr}.detail-actions{display:grid}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span><small>Paid, intake not received</small></div><div class="metric"><strong id="received">0</strong><span>Onboarding Received</span><small>Ready for review</small></div><div class="metric"><strong id="waiting">0</strong><span>Waiting on Customer</span><small>Missing information</small></div><div class="metric"><strong id="readyMetric">0</strong><span>Ready to Build</span><small>Released to fulfillment</small></div></div>
  <div id="notice" class="notice"></div>
  <section class="surface intake-banner"><div><h3>Customer Intake</h3><p>Review source information before the customer enters the build queue.</p></div><div class="progress"><span class="progress-dot done"></span><span class="progress-dot active"></span><span class="progress-dot"></span><span class="progress-dot"></span></div></section>
  <section class="surface"><div class="surface-head"><div><h3>Onboarding Queue</h3><p>Customers currently in the intake workflow.</p></div></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Contact</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Loading...</td></tr></tbody></table></div></section>
  <section class="surface detail" id="detail"><div class="empty">Select a customer to review onboarding details.</div></section>
</AdminShell>
<script is:inline>
let customers=[];const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not submitted';function flash(m){const n=document.getElementById('notice');n.textContent=m;n.style.display='block';setTimeout(()=>n.style.display='none',3500)}async function status(id,s){try{await window.adminApi(`/api/admin/customers/${id}/status`,{method:'POST',body:JSON.stringify({status:s})});flash(`Customer moved to ${s}.`);await load();show(id)}catch(err){alert(err.message)}}async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=d.customers||[];document.getElementById('awaiting').textContent=customers.filter(x=>x.status==='Paid - Awaiting Onboarding').length;document.getElementById('received').textContent=customers.filter(x=>x.status==='Onboarding Received').length;document.getElementById('waiting').textContent=customers.filter(x=>x.status==='Waiting on Customer').length;document.getElementById('readyMetric').textContent=customers.filter(x=>x.status==='Ready to Build').length;const list=customers.filter(x=>['Paid - Awaiting Onboarding','Onboarding Received','Waiting on Customer'].includes(x.status));document.getElementById('rows').innerHTML=list.length?list.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong></td><td>${e(x.customer_name||'Not provided')}<br><small class="contact-small">${e(x.email)}</small></td><td><span class="pill ${x.status.includes('Awaiting')?'gold':x.status==='Onboarding Received'?'green':'gray'}">${e(x.status)}</span></td><td>${e(fmt(x.onboarding_submitted_at))}</td><td><button data-id="${x.id}" class="admin-action compact view">Review</button></td></tr>`).join(''):'<tr><td colspan="5" class="empty">No onboarding customers right now.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id)))}catch{}}function show(id){const x=customers.find(c=>c.id===id);if(!x)return;let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{};const pairs=Object.entries(p);let actions='';if(x.status==='Onboarding Received')actions=`<button class="admin-action" id="waiting">Waiting on Customer</button><button class="admin-action primary" id="ready">Mark Ready to Build</button>`;if(x.status==='Waiting on Customer')actions=`<button class="admin-action purple" id="receivedAgain">Mark Onboarding Received</button>`;document.getElementById('detail').innerHTML=`<div class="detail-head"><div><h3>${e(x.business_name||'Customer')}</h3><span class="pill ${x.status==='Onboarding Received'?'green':x.status.includes('Awaiting')?'gold':'gray'}">${e(x.status)}</span></div><div class="detail-actions">${actions}</div></div>${pairs.length?`<div class="answer-grid">${pairs.map(([k,v])=>`<div class="answer"><small>${e(k.replaceAll('_',' '))}</small><div>${e(v||'Not provided')}</div></div>`).join('')}</div>`:'<div class="empty">No stored onboarding submission yet.</div>'}`;document.getElementById('waiting')?.addEventListener('click',()=>status(x.id,'Waiting on Customer'));document.getElementById('ready')?.addEventListener('click',()=>status(x.id,'Ready to Build'));document.getElementById('receivedAgain')?.addEventListener('click',()=>status(x.id,'Onboarding Received'))}window.addEventListener('admin-authenticated',load);load();
</script>