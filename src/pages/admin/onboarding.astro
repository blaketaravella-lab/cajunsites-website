---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Onboarding" eyebrow="Customer Intake" description="Review customers waiting on onboarding and inspect completed submissions." active="onboarding">
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span></div><div class="metric"><strong id="received">0</strong><span>Onboarding Received</span></div><div class="metric"><strong id="waiting">0</strong><span>Waiting on Customer</span></div></div>
  <div class="admin-card" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Contact</th><th>Status</th><th>Submitted</th><th>Details</th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card" id="detail" style="margin-top:14px"><div class="empty">Select a customer to review onboarding details.</div></div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not submitted';
async function load(){try{const d=await window.adminApi('/api/admin/customers');const c=d.customers||[];document.getElementById('awaiting').textContent=c.filter(x=>x.status==='Paid - Awaiting Onboarding').length;document.getElementById('received').textContent=c.filter(x=>x.status==='Onboarding Received').length;document.getElementById('waiting').textContent=c.filter(x=>x.status==='Waiting on Customer').length;const list=c.filter(x=>['Paid - Awaiting Onboarding','Onboarding Received','Waiting on Customer'].includes(x.status));document.getElementById('rows').innerHTML=list.length?list.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong></td><td>${e(x.customer_name||'Not provided')}<br><small>${e(x.email)}</small></td><td><span class="pill ${x.status.includes('Awaiting')?'gold':''}">${e(x.status)}</span></td><td>${e(fmt(x.onboarding_submitted_at))}</td><td><button data-id="${x.id}" class="view">View</button></td></tr>`).join(''):'<tr><td colspan="5" class="empty">No onboarding customers right now.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(list.find(x=>x.id===Number(b.dataset.id))))}catch(err){}}
function show(x){let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{};const pairs=Object.entries(p);document.getElementById('detail').innerHTML=`<h3>${e(x.business_name||'Customer')}</h3><p><strong>Status:</strong> ${e(x.status)}</p>${pairs.length?`<div class="admin-grid">${pairs.map(([k,v])=>`<div><small>${e(k.replaceAll('_',' '))}</small><div>${e(v||'Not provided')}</div></div>`).join('')}</div>`:'<p>No stored onboarding submission yet.</p>'}`}
window.addEventListener('admin-authenticated',load);load();
</script>