---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Build Queue" eyebrow="Fulfillment" description="Move customer sites through production, QA, review, revisions, approval, and launch." active="build">
  <style>
    .notice{display:none;margin-bottom:12px;padding:11px 13px;border-radius:10px;background:#e8f7ee;color:#17683a}.flow{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;margin-bottom:14px}.flow-step{padding:11px 9px;border:1px solid #e9e2ed;border-radius:11px;background:#fff;text-align:center;color:#7b6f82;font-size:.66rem;font-weight:850}.flow-step strong{display:block;color:#3f155f;font-size:.9rem;margin-bottom:3px}.next-actions{display:flex;gap:6px;flex-wrap:wrap}.contact-small{color:#8a7e90}.queue-meta{font-size:.7rem;color:#8a7e90}@media(max-width:1050px){.flow{overflow:auto;grid-template-columns:repeat(7,minmax(130px,1fr))}}@media(max-width:620px){.next-actions{min-width:220px}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="ready">0</strong><span>Ready to Build</span><small>Waiting for production</small></div><div class="metric"><strong id="building">0</strong><span>Building</span><small>Actively in progress</small></div><div class="metric"><strong id="review">0</strong><span>QA / Review</span><small>Validation and feedback</small></div><div class="metric"><strong id="launching">0</strong><span>Launch Ready</span><small>Approved or launching</small></div></div>
  <div class="flow"><div class="flow-step"><strong>1</strong>Ready</div><div class="flow-step"><strong>2</strong>Building</div><div class="flow-step"><strong>3</strong>Internal QA</div><div class="flow-step"><strong>4</strong>Customer Review</div><div class="flow-step"><strong>5</strong>Revisions</div><div class="flow-step"><strong>6</strong>Approved</div><div class="flow-step"><strong>7</strong>Launching</div></div>
  <div id="notice" class="notice"></div>
  <section class="surface"><div class="surface-head"><div><h3>Production Work</h3><p>Advance each customer only after the current stage is complete.</p></div></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Contact</th><th>Created</th><th>Next Step</th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Loading...</td></tr></tbody></table></div></section>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const stages=['Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'];const next={'Ready to Build':['Building','Start Build'],'Building':['Internal QA','Send to Internal QA'],'Internal QA':['Customer Review','Send to Customer Review'],'Customer Review':['Approved for Launch','Approve for Launch'],'Revisions':['Internal QA','Send Back to QA'],'Approved for Launch':['Launching','Start Launch'],'Launching':['Live','Mark Live']};const stageClass=s=>s==='Ready to Build'||s==='Approved for Launch'?'green':s==='Revisions'?'gold':'gray';function show(m){const n=document.getElementById('notice');n.textContent=m;n.style.display='block';setTimeout(()=>n.style.display='none',3500)}async function advance(id,status,business){if(!confirm(`${next[status]?.[1]||'Advance'} for ${business}?`))return;try{await window.adminApi(`/api/admin/customers/${id}/status`,{method:'POST',body:JSON.stringify({status:next[status][0]})});show(`${business} moved to ${next[status][0]}.`);await load()}catch(err){alert(err.message)}}async function sendRevision(id,business){if(!confirm(`Move ${business} to Revisions?`))return;try{await window.adminApi(`/api/admin/customers/${id}/status`,{method:'POST',body:JSON.stringify({status:'Revisions'})});show(`${business} moved to Revisions.`);await load()}catch(err){alert(err.message)}}async function load(){try{const d=await window.adminApi('/api/admin/customers');const c=(d.customers||[]).filter(x=>stages.includes(x.status));document.getElementById('ready').textContent=c.filter(x=>x.status==='Ready to Build').length;document.getElementById('building').textContent=c.filter(x=>x.status==='Building').length;document.getElementById('review').textContent=c.filter(x=>['Internal QA','Customer Review','Revisions'].includes(x.status)).length;document.getElementById('launching').textContent=c.filter(x=>['Approved for Launch','Launching'].includes(x.status)).length;document.getElementById('rows').innerHTML=c.length?c.map(x=>{const n=next[x.status],extra=x.status==='Customer Review'?`<button class="admin-action compact" data-revision="${x.id}" data-business="${e(x.business_name||x.email)}">Needs Revisions</button>`:'';return `<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><span class="queue-meta">Customer #${x.id}</span></td><td><span class="pill ${stageClass(x.status)}">${e(x.status)}</span></td><td>${e(x.customer_name||'Not provided')}<br><small class="contact-small">${e(x.email)}</small></td><td>${e(x.created_at||'')}</td><td><div class="next-actions">${n?`<button class="admin-action purple compact" data-id="${x.id}" data-status="${e(x.status)}" data-business="${e(x.business_name||x.email)}">${e(n[1])}</button>${extra}`:'<span class="pill gray">Review</span>'}</div></td></tr>`}).join(''):'<tr><td colspan="5" class="empty">The build queue is empty.</td></tr>';document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>advance(Number(b.dataset.id),b.dataset.status,b.dataset.business));document.querySelectorAll('[data-revision]').forEach(b=>b.onclick=()=>sendRevision(Number(b.dataset.revision),b.dataset.business))}catch{}}window.addEventListener('admin-authenticated',load);load();
</script>