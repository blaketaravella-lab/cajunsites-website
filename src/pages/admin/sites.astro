---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Sites" eyebrow="Production" description="Track preview URLs, customer domains, production URLs, templates, and live recurring-service customers." active="sites">
  <style>
    .site-link{display:inline-grid;place-items:center}.editor{margin-top:14px}.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.editor-grid label{display:grid;gap:6px;font-size:.74rem;font-weight:850;color:#5f5366;text-transform:uppercase;letter-spacing:.035em}.editor-grid input,.editor-grid select,.editor-grid textarea{width:100%;padding:11px 12px}.editor-grid textarea{min-height:110px;resize:vertical}.full{grid-column:1/-1}.editor-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.msg{margin-top:10px;color:#17683a;font-size:.84rem}.contact-small{color:var(--muted)}@media(max-width:700px){.editor-grid{grid-template-columns:1fr}.full{grid-column:auto}.editor-actions{display:grid}.editor-actions .admin-action{width:100%}}
  </style>
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="live">0</strong><span>Live</span></div><div class="metric"><strong id="active">0</strong><span>Active Customers</span></div><div class="metric"><strong id="launching">0</strong><span>Launching</span></div></div>
  <div class="admin-card" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Domain</th><th>Preview</th><th>Production</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card editor" id="editor"><div class="empty">Select a site to review or update production information.</div></div>
</AdminShell>
<script is:inline>
let customers=[];const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=(d.customers||[]).filter(x=>['Approved for Launch','Launching','Live','Active Customer'].includes(x.status));document.getElementById('live').textContent=customers.filter(x=>x.status==='Live').length;document.getElementById('active').textContent=customers.filter(x=>x.status==='Active Customer').length;document.getElementById('launching').textContent=customers.filter(x=>x.status==='Launching').length;document.getElementById('rows').innerHTML=customers.length?customers.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small class="contact-small">${e(x.email)}</small></td><td><span class="pill ${x.status==='Active Customer'?'green':x.status==='Live'?'green':'gold'}">${e(x.status)}</span></td><td>${e(x.site_domain||'Not set')}</td><td>${x.preview_url?`<a class="admin-action compact site-link" href="${e(x.preview_url)}" target="_blank" rel="noreferrer">Open Preview</a>`:'<span class="pill gray">Not Set</span>'}</td><td>${x.production_url?`<a class="admin-action compact site-link" href="${e(x.production_url)}" target="_blank" rel="noreferrer">Open Site</a>`:'<span class="pill gray">Not Set</span>'}</td><td><button class="admin-action compact" data-id="${x.id}">Manage</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No launch or production sites yet.</td></tr>';document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>edit(Number(b.dataset.id)))}catch{}}
function edit(id){const x=customers.find(c=>c.id===id);if(!x)return;document.getElementById('editor').innerHTML=`<h3>${e(x.business_name||'Customer Site')}</h3><div class="editor-grid"><label>Domain<input id="domain" value="${e(x.site_domain||'')}" placeholder="example.com" /></label><label>Template<select id="template"><option value="">Select template</option><option value="service-modern">Service Modern</option><option value="service-classic">Service Classic</option><option value="local-premium">Local Premium</option></select></label><label class="full">Preview URL<input id="preview" value="${e(x.preview_url||'')}" placeholder="https://preview.example.com" /></label><label class="full">Production URL<input id="production" value="${e(x.production_url||'')}" placeholder="https://example.com" /></label><label class="full">Internal Site Notes<textarea id="notes">${e(x.site_internal_notes||'')}</textarea></label></div><div class="editor-actions"><button class="admin-action primary" id="save">Save Site Information</button>${x.status==='Live'?`<button class="admin-action" id="activate">Mark Active Customer</button>`:''}</div><div id="msg" class="msg"></div>`;document.getElementById('template').value=x.template_key||'';document.getElementById('save').onclick=()=>save(x);document.getElementById('activate')?.addEventListener('click',()=>activate(x))}
async function save(x){try{await window.adminApi(`/api/admin/customers/${x.id}/site`,{method:'POST',body:JSON.stringify({domain:document.getElementById('domain').value,preview_url:document.getElementById('preview').value,production_url:document.getElementById('production').value,template_key:document.getElementById('template').value,internal_notes:document.getElementById('notes').value})});document.getElementById('msg').textContent='Site information saved.';await load()}catch(err){alert(err.message)}}
async function activate(x){try{await window.adminApi(`/api/admin/customers/${x.id}/status`,{method:'POST',body:JSON.stringify({status:'Active Customer'})});await load();document.getElementById('editor').innerHTML='<div class="empty">Customer marked Active.</div>'}catch(err){alert(err.message)}}
window.addEventListener('admin-authenticated',load);load();
</script>