---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Sites" eyebrow="Production" description="Track preview URLs, customer domains, production URLs, templates, and live recurring-service customers." active="sites">
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="live">0</strong><span>Live</span></div><div class="metric"><strong id="active">0</strong><span>Active Customers</span></div><div class="metric"><strong id="launching">0</strong><span>Launching</span></div></div>
  <div class="admin-card" style="padding:0;overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Domain</th><th>Preview</th><th>Production</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card" id="editor" style="margin-top:14px"><div class="empty">Select a site to review or update production information.</div></div>
</AdminShell>
<script is:inline>
let customers=[];const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=(d.customers||[]).filter(x=>['Approved for Launch','Launching','Live','Active Customer'].includes(x.status));document.getElementById('live').textContent=customers.filter(x=>x.status==='Live').length;document.getElementById('active').textContent=customers.filter(x=>x.status==='Active Customer').length;document.getElementById('launching').textContent=customers.filter(x=>x.status==='Launching').length;document.getElementById('rows').innerHTML=customers.length?customers.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small>${e(x.email)}</small></td><td><span class="pill green">${e(x.status)}</span></td><td>${e(x.site_domain||'Not set')}</td><td>${x.preview_url?`<a href="${e(x.preview_url)}" target="_blank">Open preview</a>`:'Not set'}</td><td>${x.production_url?`<a href="${e(x.production_url)}" target="_blank">Open site</a>`:'Not set'}</td><td><button class="admin-action" data-id="${x.id}">Manage</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No launch or production sites yet.</td></tr>';document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>edit(Number(b.dataset.id)))}catch{}}
function edit(id){const x=customers.find(c=>c.id===id);if(!x)return;document.getElementById('editor').innerHTML=`<h3>${e(x.business_name||'Customer Site')}</h3><div class="admin-grid" style="margin-top:12px"><label>Domain<input id="domain" value="${e(x.site_domain||'')}" placeholder="example.com" /></label><label>Preview URL<input id="preview" value="${e(x.preview_url||'')}" placeholder="https://preview.example.com" /></label><label>Production URL<input id="production" value="${e(x.production_url||'')}" placeholder="https://example.com" /></label><label>Template<select id="template"><option value="">Select template</option><option value="service-modern">Service Modern</option><option value="service-classic">Service Classic</option><option value="local-premium">Local Premium</option></select></label><label style="grid-column:1/-1">Internal site notes<textarea id="notes" style="width:100%;min-height:100px">${e(x.site_internal_notes||'')}</textarea></label></div><div style="margin-top:14px"><button class="admin-action primary" id="save">Save Site Information</button>${x.status==='Live'?` <button class="admin-action" id="activate">Mark Active Customer</button>`:''}</div><div id="msg" style="margin-top:10px;color:#17683a"></div>`;document.getElementById('template').value=x.template_key||'';document.getElementById('save').onclick=()=>save(x);document.getElementById('activate')?.addEventListener('click',()=>activate(x))}
async function save(x){try{await window.adminApi(`/api/admin/customers/${x.id}/site`,{method:'POST',body:JSON.stringify({domain:document.getElementById('domain').value,preview_url:document.getElementById('preview').value,production_url:document.getElementById('production').value,template_key:document.getElementById('template').value,internal_notes:document.getElementById('notes').value})});document.getElementById('msg').textContent='Site information saved.';await load()}catch(err){alert(err.message)}}
async function activate(x){try{await window.adminApi(`/api/admin/customers/${x.id}/status`,{method:'POST',body:JSON.stringify({status:'Active Customer'})});await load();document.getElementById('editor').innerHTML='<div class="empty">Customer marked Active.</div>'}catch(err){alert(err.message)}}
window.addEventListener('admin-authenticated',load);load();
</script>