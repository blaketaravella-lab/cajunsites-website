---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Sites" eyebrow="Production" description="Manage preview URLs, customer domains, production URLs, templates, and recurring-service sites." active="sites">
  <style>
    .site-link{display:inline-flex}.editor{margin-top:14px}.site-overview{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}.site-panel{padding:17px 18px}.site-panel h3{margin:0}.site-panel p{margin:4px 0 0;color:#807489;font-size:.76rem}.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:18px}.editor-grid label{display:grid;gap:5px;font-size:.65rem;font-weight:900;color:#6b5e72;text-transform:uppercase}.editor-grid input,.editor-grid select,.editor-grid textarea{width:100%;padding:10px 11px}.editor-grid textarea{min-height:105px;resize:vertical}.full{grid-column:1/-1}.editor-actions{display:flex;gap:8px;flex-wrap:wrap;padding:0 18px 18px}.msg{margin:0 18px 16px;color:#17683a;font-size:.78rem}.contact-small{color:#8a7e90}.domain{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.73rem;color:#4d3a59}@media(max-width:800px){.site-overview,.editor-grid{grid-template-columns:1fr}.full{grid-column:auto}.editor-actions{display:grid}}
  </style>
  <div class="stats-grid"><div class="metric"><strong id="live">0</strong><span>Live</span><small>Production websites</small></div><div class="metric"><strong id="active">0</strong><span>Active Customers</span><small>Recurring service</small></div><div class="metric"><strong id="launching">0</strong><span>Launching</span><small>Cutover in progress</small></div><div class="metric"><strong id="approved">0</strong><span>Approved</span><small>Ready for launch</small></div></div>
  <div class="site-overview"><section class="surface site-panel"><h3>Production Sites</h3><p>Domains and URLs should represent the final customer-approved configuration.</p></section><section class="surface site-panel"><h3>Lifecycle</h3><p>Approved → Launching → Live → Active Customer</p></section></div>
  <section class="surface"><div class="surface-head"><div><h3>Website Portfolio</h3><p>Open previews, production sites, or manage deployment details.</p></div></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Domain</th><th>Preview</th><th>Production</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="6" class="empty">Loading...</td></tr></tbody></table></div></section>
  <section class="surface editor" id="editor"><div class="empty">Select a site to review or update production information.</div></section>
</AdminShell>
<script is:inline>
let customers=[];const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=(d.customers||[]).filter(x=>['Approved for Launch','Launching','Live','Active Customer'].includes(x.status));document.getElementById('live').textContent=customers.filter(x=>x.status==='Live').length;document.getElementById('active').textContent=customers.filter(x=>x.status==='Active Customer').length;document.getElementById('launching').textContent=customers.filter(x=>x.status==='Launching').length;document.getElementById('approved').textContent=customers.filter(x=>x.status==='Approved for Launch').length;document.getElementById('rows').innerHTML=customers.length?customers.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small class="contact-small">${e(x.email)}</small></td><td><span class="pill ${x.status==='Active Customer'||x.status==='Live'?'green':'gold'}">${e(x.status)}</span></td><td><span class="domain">${e(x.site_domain||'Not set')}</span></td><td>${x.preview_url?`<a class="admin-action compact site-link" href="${e(x.preview_url)}" target="_blank">Open Preview</a>`:'<span class="pill gray">Not Set</span>'}</td><td>${x.production_url?`<a class="admin-action compact site-link" href="${e(x.production_url)}" target="_blank">Open Site</a>`:'<span class="pill gray">Not Set</span>'}</td><td><button class="admin-action compact" data-id="${x.id}">Manage</button></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No launch or production sites yet.</td></tr>';document.querySelectorAll('[data-id]').forEach(b=>b.onclick=()=>edit(Number(b.dataset.id)))}catch{}}function edit(id){const x=customers.find(c=>c.id===id);if(!x)return;document.getElementById('editor').innerHTML=`<div class="surface-head"><div><h3>${e(x.business_name||'Customer Site')}</h3><p>Production configuration and internal site metadata.</p></div><span class="pill ${x.status==='Live'||x.status==='Active Customer'?'green':'gold'}">${e(x.status)}</span></div><div class="editor-grid"><label>Domain<input id="domain" value="${e(x.site_domain||'')}" placeholder="example.com"/></label><label>Template<select id="template"><option value="">Select template</option><option value="service-modern">Service Modern</option><option value="service-classic">Service Classic</option><option value="local-premium">Local Premium</option></select></label><label class="full">Preview URL<input id="preview" value="${e(x.preview_url||'')}" placeholder="https://preview.example.com"/></label><label class="full">Production URL<input id="production" value="${e(x.production_url||'')}" placeholder="https://example.com"/></label><label class="full">Internal Site Notes<textarea id="notes">${e(x.site_internal_notes||'')}</textarea></label></div><div class="editor-actions"><button class="admin-action purple" id="save">Save Site Information</button>${x.status==='Live'?`<button class="admin-action primary" id="activate">Mark Active Customer</button>`:''}</div><div id="msg" class="msg"></div>`;document.getElementById('template').value=x.template_key||'';document.getElementById('save').onclick=()=>save(x);document.getElementById('activate')?.addEventListener('click',()=>activate(x))}async function save(x){try{await window.adminApi(`/api/admin/customers/${x.id}/site`,{method:'POST',body:JSON.stringify({domain:document.getElementById('domain').value,preview_url:document.getElementById('preview').value,production_url:document.getElementById('production').value,template_key:document.getElementById('template').value,internal_notes:document.getElementById('notes').value})});document.getElementById('msg').textContent='Site information saved.';await load()}catch(err){alert(err.message)}}async function activate(x){try{await window.adminApi(`/api/admin/customers/${x.id}/status`,{method:'POST',body:JSON.stringify({status:'Active Customer'})});await load();document.getElementById('editor').innerHTML='<div class="empty">Customer marked Active.</div>'}catch(err){alert(err.message)}}window.addEventListener('admin-authenticated',load);load();
</script>