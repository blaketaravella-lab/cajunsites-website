---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" active="prospects" hideHeader={true}>
  <div class="prospect-workspace">
    <a class="pw-back" href="/admin/prospects/">← Back to Prospects</a>
    <div class="pw-notice" id="notice"></div>
    <div id="detail"><div class="admin-card"><div class="empty">Loading prospect...</div></div></div>
  </div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let prospect=null;
const id=Number(new URLSearchParams(location.search).get('id'));
const stages=['Qualified','Concept Built','Contacted','Concept Viewed','Won'];
function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='pw-notice show'+(b?' error':'');setTimeout(()=>n.className='pw-notice',5000)}
function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}
function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}
function stageClass(x){return x.stage==='Won'?'green':x.stage==='Concept Built'?'gold':x.stage==='Lost'?'red':''}
function pipeline(x){const c=x.stage==='Lost'?-1:stages.indexOf(x.stage);return `<div class="pw-pipeline">${stages.map((s,i)=>`<div class="pw-step ${i<c?'done':i===c?'current':''}">${esc(s)}</div>`).join('')}<div class="pw-step ${x.customer_id?'current':''}">Customer</div></div>`}
function nextAction(x){if(x.customer_id)return {title:'Customer created',body:'This prospect has already been converted. Continue work from the customer record.'};if(!x.concept_url)return {title:'Build the concept',body:'Research is available. Create the prospect website before outreach or conversion.'};if(x.stage==='Qualified'||x.stage==='Concept Built')return {title:'Begin outreach',body:'The concept is ready. Contact the prospect and track whether the decision maker sees the site.'};if(x.stage==='Contacted'&&!x.concept_viewed)return {title:'Get the concept viewed',body:'Follow up with the prospect and confirm the concept reaches the decision maker.'};if(x.stage==='Concept Viewed')return {title:'Follow up on the viewed concept',body:'Capture the outcome, next follow-up date, and move the opportunity toward Won or Lost.'};return {title:'Keep the record current',body:'Update outcome, follow-up details, and stage as the opportunity changes.'}}
function researchCard(x){const r=parseResearch(x),facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8),status=x.research_status||'Not Run';return `<section class="pw-card"><div class="pw-card-head"><div><h3>Business Research</h3><p>Verified facts and services used to shape the concept site.</p></div><div class="pw-card-actions"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action compact" id="researchBusiness">${status==='Complete'?'Research Again':'Research Business'}</button></div></div><div class="pw-card-body">${x.research_error?`<div class="pw-error">${esc(x.research_error)}</div>`:''}${r?`<div class="pw-stats"><div class="pw-stat"><strong>${services.length}</strong><span>Verified services</span></div><div class="pw-stat"><strong>${facts.length}</strong><span>Verified facts</span></div><div class="pw-stat"><strong>${sources.length}</strong><span>Source links</span></div></div><div class="pw-research-summary">${esc(r.summary||'No summary returned.')}</div><div class="pw-evidence"><div class="pw-evidence-box"><h4>Key Services</h4>${services.map(s=>`<div class="pw-evidence-item">✓ ${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="pw-evidence-item">No services verified.</div>'}</div><div class="pw-evidence-box"><h4>Verified Facts</h4>${facts.map(f=>`<div class="pw-evidence-item"><strong>${esc(f.label)}:</strong> ${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="pw-evidence-item">No facts verified.</div>'}</div></div>${sources.length?`<div class="pw-sources">${sources.map(s=>`<a class="pw-source" href="${esc(s.url)}" target="_blank">${esc(s.title||'Source')} ↗</a>`).join('')}</div>`:''}`:'<div class="pw-research-summary">Run research to build a verified business profile before generating a concept.</div>'}</div></section>`}
function editor(x){return `<section class="pw-card"><div class="pw-card-head"><div><h3>Prospect Details</h3><p>Business identity, outreach tracking, and internal sales information.</p></div></div><div class="pw-card-body"><div class="pw-form-grid"><div class="pw-field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="pw-field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="pw-field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="pw-field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="pw-field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="pw-field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="pw-field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="pw-field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="pw-field full"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div><div class="pw-field"><label>Call Attempts</label><input id="p_calls" type="number" value="${Number(x.call_attempts||0)}"></div><div class="pw-field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="pw-field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="pw-field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="pw-field full"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="pw-field full"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="pw-field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div><div class="pw-field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="pw-form-actions"><button class="admin-action danger" id="deleteProspect">Remove Prospect</button><button class="admin-action primary" id="saveProspect">Save Changes</button></div></div></section>`}
function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="admin-card"><div class="empty">Prospect not found.</div></div>';return}const r=parseResearch(x),state=buildState(x),converted=!!x.customer_id,market=[x.city,x.state].filter(Boolean).join(', ')||'Market not set',summary=r?.summary||`${x.business_vertical||x.category||'Local business'} in ${market}.`,next=nextAction(x),lastUpdated=esc(x.updated_at||'Recently');el('detail').innerHTML=`<div class="prospect-workspace"><header class="pw-hero"><div><div class="pw-kicker">Sales prospect</div><h1 class="pw-title">${esc(x.business_name)}</h1><div class="pw-meta"><span>${esc(x.category||'Category not set')}</span><span>${esc(market)}</span>${x.business_vertical&&x.business_vertical!==x.category?`<span>${esc(x.business_vertical)}</span>`:''}</div><p class="pw-summary">${esc(summary)}</p></div><div class="pw-status"><div class="pw-status-item"><span class="pw-label">Stage</span><span class="pill ${stageClass(x)}">${esc(x.stage||'Qualified')}</span></div><div class="pw-status-item"><span class="pw-label">Last updated</span><span class="pw-value">${lastUpdated}</span></div></div></header><div class="pw-actions"><button class="admin-action purple" id="buildConcept">${x.concept_url?'Rebuild Concept':'Build Concept'}</button>${x.concept_url?`<a class="admin-action" href="${esc(x.concept_url)}" target="_blank">Open Concept ↗</a>`:''}<button class="admin-action" id="researchBusinessTop">${x.research_status==='Complete'?'Research Again':'Research Business'}</button>${converted?`<a class="admin-action primary" href="/admin/?customer=${Number(x.customer_id)}">Open Customer</a>`:`<button class="admin-action primary" id="convertCustomer" ${x.concept_url?'':'disabled'}>Convert to Customer</button>`}<span class="pw-primary-note">Concept: ${esc(state)}</span></div>${pipeline(x)}<div class="pw-tabs"><button class="pw-tab active" data-view="research">Business Research</button><button class="pw-tab" data-view="edit">Prospect Details</button></div><div class="pw-layout"><main class="pw-main"><div data-section="research">${researchCard(x)}</div><div data-section="edit" style="display:none">${editor(x)}</div></main><aside class="pw-side"><div class="pw-next"><span class="pw-label">Recommended next action</span><strong>${esc(next.title)}</strong><p>${esc(next.body)}</p></div><section class="pw-card pw-side-card"><h3 class="pw-side-title">Opportunity Snapshot</h3><div class="pw-detail"><span>Business</span><span>${esc(x.business_name)}</span></div><div class="pw-detail"><span>Category</span><span>${esc(x.category||'Not set')}</span></div><div class="pw-detail"><span>Market</span><span>${esc(market)}</span></div><div class="pw-detail"><span>Research</span><span>${esc(x.research_status||'Not Run')}</span></div><div class="pw-detail"><span>Concept</span><span>${esc(state)}</span></div><div class="pw-detail"><span>Call attempts</span><span>${Number(x.call_attempts||0)}</span></div><div class="pw-detail"><span>Next follow-up</span><span>${esc(x.next_follow_up||'Not scheduled')}</span></div></section><section class="pw-card pw-side-card"><h3 class="pw-side-title">Quick Actions</h3><div class="pw-links">${x.concept_url?`<a href="${esc(x.concept_url)}" target="_blank">Open concept site ↗</a><button id="copyUrl">Copy concept URL</button>`:''}<button id="editProspect">Edit prospect details</button></div></section></aside></div></div>`;wire()}
function wire(){el('researchBusiness')?.addEventListener('click',researchBusiness);el('researchBusinessTop')?.addEventListener('click',researchBusiness);el('buildConcept')?.addEventListener('click',buildConcept);el('convertCustomer')?.addEventListener('click',convertCustomer);el('copyUrl')?.addEventListener('click',()=>navigator.clipboard.writeText(prospect.concept_url).then(()=>notice('Concept URL copied.')));el('editProspect')?.addEventListener('click',()=>switchView('edit'));document.querySelectorAll('.pw-tab').forEach(b=>b.onclick=()=>switchView(b.dataset.view));el('saveProspect')?.addEventListener('click',save);el('deleteProspect')?.addEventListener('click',remove)}
function switchView(v){document.querySelectorAll('.pw-tab').forEach(b=>b.classList.toggle('active',b.dataset.view===v));document.querySelectorAll('[data-section]').forEach(s=>s.style.display=s.dataset.section===v?'block':'none')}
function formData(){return{business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value}}
async function save(s=false){try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(formData())});if(!s)notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}
async function researchBusiness(){try{if(el('p_business'))await save(true);await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}
async function buildConcept(){try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank')}catch(e){notice(e.message,true);await load()}}
async function convertCustomer(){if(!prospect?.concept_url){notice('Build a concept site before converting this prospect.',true);return}if(!confirm(`Convert ${prospect.business_name} to a customer and promote its current concept site as the starting customer website? No Stripe checkout or invoice will be sent.`))return;try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/convert`,{method:'POST',body:'{}'});if(!d.customer_id)throw new Error('Customer record was not returned.');notice('Prospect converted to customer.');location.href=d.customer_url||`/admin/?customer=${d.customer_id}`}catch(e){notice(e.message,true)}}
async function remove(){if(!confirm(`Remove ${prospect.business_name}?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}
async function load(){try{const d=await window.adminApi('/api/admin/prospects?include_converted=1');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="admin-card"><div class="empty">${esc(e.message)}</div></div>`}}
window.addEventListener('admin-authenticated',load);load();
</script>
