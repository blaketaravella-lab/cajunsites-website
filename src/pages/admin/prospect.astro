---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" active="prospects" hideHeader={true}>
<style is:global>
.page{display:grid;gap:14px}.topline{display:flex;justify-content:space-between;align-items:center}.back{color:#641bc0;text-decoration:none;font-size:.78rem;font-weight:850}.notice{display:none;padding:11px 14px;border-radius:10px;font-weight:700}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.profile{display:grid;grid-template-columns:124px minmax(0,1fr) 250px;gap:19px;align-items:center}.profile-visual{height:124px;border-radius:15px;background:radial-gradient(circle at 65% 35%,rgba(255,255,255,.18),transparent 22%),linear-gradient(145deg,#18232d,#455463);position:relative;overflow:hidden}.profile-visual:before{content:"";position:absolute;width:100px;height:42px;border:8px solid rgba(255,255,255,.18);border-radius:50%;left:14px;top:38px;transform:rotate(-8deg)}.profile-visual:after{content:"";position:absolute;width:84px;height:6px;border-radius:999px;background:#ffc21c;left:22px;bottom:20px;opacity:.85}.profile h1{margin:0;color:#280548;font-size:clamp(2rem,3.3vw,3rem);line-height:1;letter-spacing:-.05em}.profile-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;color:#786c80;font-size:.8rem;font-weight:700}.profile-summary{margin:9px 0 0;color:#6e6275;font-size:.84rem;line-height:1.55;max-width:820px}.stage-card{border:1px solid #e9e2ed;border-radius:13px;background:#fff;padding:14px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.stage-card label{display:block;font-size:.63rem;color:#8a7e90;font-weight:800;margin-bottom:6px}.stage-card strong{font-size:.72rem;color:#3e2850}.command{background:#fff;border:1px solid #e9e2ed;border-radius:16px;padding:13px}.action-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr 1.15fr;gap:9px}.action{min-height:68px;padding:10px 14px;border:1px solid #e5ddea;border-radius:11px;background:#fff;color:#42116e;text-decoration:none;display:flex;align-items:center;gap:11px;cursor:pointer;text-align:left}.action.purple{background:linear-gradient(135deg,#3b0767,#671ab8);color:#fff;border-color:#4d0b86}.action.gold{background:linear-gradient(135deg,#ffbd16,#ffd15a);color:#2b074a;border-color:#e9ad16}.action-icon{width:30px;font-size:1.35rem;text-align:center}.action strong{display:block;font-size:.8rem}.action span{display:block;font-size:.66rem;margin-top:3px;opacity:.72}.pipeline{display:grid;grid-template-columns:repeat(6,1fr);margin-top:16px;padding:0 14px 2px}.step{position:relative;text-align:center;padding-top:24px;font-size:.66rem;font-weight:800;color:#82768a}.step:before{content:"";position:absolute;top:5px;left:50%;width:17px;height:17px;border-radius:50%;background:#dcd8e5;z-index:2}.step:after{content:"";position:absolute;top:12px;left:-50%;width:100%;height:2px;background:#ddd9e5}.step:first-child:after{display:none}.step.done:before{background:#168c48}.step.done:after,.step.current:after{background:#6c23c5}.step.current{color:#58148f}.step.current:before{background:#7425d0;box-shadow:0 0 0 4px #f1e9fa}.tabs{display:flex;gap:3px;border-bottom:1px solid #e9e2ed;overflow:auto}.tab{border:0;background:none;padding:12px 15px;color:#81758a;font-weight:800;font-size:.75rem;white-space:nowrap;border-bottom:2px solid transparent;cursor:pointer}.tab.active{color:#641bc0;border-color:#7425d0}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:14px;align-items:start}.side{display:grid;gap:14px;position:sticky;top:72px}.card{background:#fff;border:1px solid #e9e2ed;border-radius:15px;overflow:hidden}.card-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:16px 18px;border-bottom:1px solid #eee9f1}.card-head h3{margin:0;font-size:.93rem}.card-head p{margin:4px 0 0;color:#81758a;font-size:.7rem}.card-body{padding:17px}.research-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:12px}.research-stat{border:1px solid #eee8f1;border-radius:11px;padding:11px}.research-stat strong{display:block;color:#3c145a;font-size:1.3rem}.research-stat span{font-size:.65rem;color:#81758a}.research-summary{padding:13px;border:1px solid #eee8f1;border-radius:11px;color:#55495b;font-size:.8rem;line-height:1.55}.evidence{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.evidence-box{border:1px solid #eee8f1;border-radius:11px;padding:12px}.evidence-box h4{margin:0 0 8px;color:#5d1b98;font-size:.65rem;text-transform:uppercase}.evidence-item{font-size:.73rem;line-height:1.5;margin:5px 0}.evidence-item a{color:#641bc0;font-weight:850;text-decoration:none}.sources{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.source-chip{font-size:.64rem;padding:5px 8px;border:1px solid #e7deeb;border-radius:999px;color:#641bc0;text-decoration:none;font-weight:800}.side-card{padding:16px}.side-card h3{margin:0 0 13px}.detail-row{padding:9px 0;border-bottom:1px solid #eee9f1}.detail-row:last-child{border:0}.detail-row label{display:block;color:#8a7e90;font-size:.61rem;font-weight:800;margin-bottom:3px}.detail-row div{font-size:.75rem;color:#3e284d;font-weight:700}.quick-links{display:grid;gap:6px}.quick-links a,.quick-links button{border:0;background:none;padding:4px 0;color:#641bc0;text-decoration:none;text-align:left;font-size:.74rem;font-weight:800;cursor:pointer}.editor{display:none}.editor.active{display:block}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.62rem;font-weight:900;color:#6b5e72;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;padding:10px}.field textarea{min-height:110px}.form-actions{display:flex;justify-content:space-between;gap:9px;margin-top:14px;padding-top:13px;border-top:1px solid #eee9f1}.errorbox{margin-bottom:10px;padding:9px 10px;border-radius:9px;background:#fff0f0;color:#8d2424;font-size:.72rem}@media(max-width:1050px){.profile{grid-template-columns:96px 1fr}.profile-visual{height:96px}.stage-card{grid-column:1/-1}.workspace{grid-template-columns:1fr}.side{position:static;grid-template-columns:1fr 1fr}}@media(max-width:760px){.profile{grid-template-columns:1fr}.profile-visual{display:none}.action-grid{grid-template-columns:1fr 1fr}.pipeline{overflow:auto;grid-template-columns:repeat(6,minmax(100px,1fr))}.side,.evidence,.form-grid{grid-template-columns:1fr}.field.full{grid-column:1}.research-stats{grid-template-columns:repeat(3,1fr)}}@media(max-width:520px){.action-grid{grid-template-columns:1fr}.profile h1{font-size:2rem}.form-actions{display:grid}.form-actions button{width:100%}}
</style>
<div class="page"><div class="topline"><a class="back" href="/admin/prospects/">← Back to Prospects</a></div><div class="notice" id="notice"></div><div id="detail"><div class="admin-card"><div class="empty">Loading prospect...</div></div></div></div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]));let prospect=null;const id=Number(new URLSearchParams(location.search).get('id')),stages=['Qualified','Concept Built','Contacted','Concept Viewed','Won'];function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='notice show'+(b?' error':'');setTimeout(()=>n.className='notice',5000)}function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}function pipeline(x){const c=x.stage==='Lost'?-1:stages.indexOf(x.stage);return `<div class="pipeline">${stages.map((s,i)=>`<div class="step ${i<c?'done':i===c?'current':''}">${esc(s)}</div>`).join('')}<div class="step ${x.customer_id?'current':''}">Customer</div></div>`}function researchCard(x){const r=parseResearch(x),facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8),status=x.research_status||'Not Run';return `<section class="card"><div class="card-head"><div><h3>Business Research</h3><p>Source-backed details used to customize the concept.</p></div><div style="display:flex;gap:7px;align-items:center"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action compact" id="researchBusiness">${status==='Complete'?'Research Again':'Research Business'}</button></div></div><div class="card-body">${x.research_error?`<div class="errorbox">${esc(x.research_error)}</div>`:''}${r?`<div class="research-stats"><div class="research-stat"><strong>${services.length}</strong><span>Verified Services</span></div><div class="research-stat"><strong>${facts.length}</strong><span>Verified Facts</span></div><div class="research-stat"><strong>${sources.length}</strong><span>Source Links</span></div></div><div class="research-summary">${esc(r.summary||'No summary returned.')}</div><div class="evidence"><div class="evidence-box"><h4>Key Services</h4>${services.map(s=>`<div class="evidence-item">✓ ${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="evidence-item">No services verified.</div>'}</div><div class="evidence-box"><h4>Verified Facts</h4>${facts.map(f=>`<div class="evidence-item"><strong>${esc(f.label)}:</strong> ${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="evidence-item">No facts verified.</div>'}</div></div><div class="sources">${sources.map(s=>`<a class="source-chip" href="${esc(s.url)}" target="_blank">${esc(s.title||'Source')} ↗</a>`).join('')}</div>`:'<div class="research-summary">Run research to build a verified business profile.</div>'}</div></section>`}function editor(x){return `<section class="card editor active" id="editor"><div class="card-head"><div><h3>Edit Prospect</h3><p>Business, contact, outreach, and internal record.</p></div></div><div class="card-body"><div class="form-grid"><div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field full"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div><div class="field"><label>Call Attempts</label><input id="p_calls" type="number" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="field full"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field full"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div><div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="form-actions"><button class="admin-action danger" id="deleteProspect">Remove Prospect</button><button class="admin-action primary" id="saveProspect">Save Changes</button></div></div></section>`}function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="admin-card"><div class="empty">Prospect not found.</div></div>';return}const r=parseResearch(x),state=buildState(x),converted=!!x.customer_id,market=[x.city,x.state].filter(Boolean).join(', ')||'Market not set',summary=r?.summary||`${x.business_vertical||x.category||'Local business'} in ${market}.`;el('detail').innerHTML=`<div class="page"><div class="profile"><div class="profile-visual"></div><div><h1>${esc(x.business_name)}</h1><div class="profile-meta"><span>◇ ${esc(x.category||'Category not set')}</span><span>⌖ ${esc(market)}</span>${x.business_vertical?`<span>▣ ${esc(x.business_vertical)}</span>`:''}</div><p class="profile-summary">${esc(summary)}</p></div><div class="stage-card"><div><label>Stage</label><span class="pill ${x.stage==='Concept Built'?'gold':x.stage==='Won'?'green':''}">${esc(x.stage||'Qualified')}</span></div><div><label>Last Updated</label><strong>${esc(x.updated_at||'Recently')}</strong></div></div></div><div class="command"><div class="action-grid"><button class="action purple" id="researchBusinessTop"><span class="action-icon">⌕</span><span><strong>${x.research_status==='Complete'?'Research Again':'Research Business'}</strong><span>Update business details</span></span></button><button class="action" id="buildConcept"><span class="action-icon">◇</span><span><strong>${x.concept_url?'Rebuild Concept':'Build Concept'}</strong><span>Generate a new version</span></span></button>${x.concept_url?`<a class="action" href="${esc(x.concept_url)}" target="_blank"><span class="action-icon">↗</span><span><strong>Open Concept</strong><span>View live preview</span></span></a>`:'<div class="action"><span class="action-icon">□</span><span><strong>No Concept Yet</strong><span>Build to create preview</span></span></div>'}${converted?`<div class="action gold"><span class="action-icon">✓</span><span><strong>Customer #${Number(x.customer_id)}</strong><span>Converted</span></span></div>`:`<button class="action gold" id="convertCustomer" ${x.concept_url?'':'disabled'}><span class="action-icon">♙</span><span><strong>Convert to Customer</strong><span>${x.concept_url?'Promote concept into customer site':'Build concept first'}</span></span></button>`}</div>${pipeline(x)}</div><div class="tabs"><button class="tab active" data-view="research">▤ Business Research</button><button class="tab" data-view="edit">✎ Prospect Details</button></div><div class="workspace"><div><div data-section="research">${researchCard(x)}</div><div data-section="edit" style="display:none">${editor(x)}</div></div><div class="side"><section class="card side-card"><h3>ⓘ Prospect Overview</h3><div class="detail-row"><label>Business Name</label><div>${esc(x.business_name)}</div></div><div class="detail-row"><label>Category</label><div>${esc(x.category||'Not set')}</div></div><div class="detail-row"><label>City</label><div>${esc(x.city||'Not set')}</div></div><div class="detail-row"><label>State</label><div>${esc(x.state||'Not set')}</div></div><div class="detail-row"><label>Stage</label><span class="pill gold">${esc(x.stage||'Qualified')}</span></div>${x.business_vertical?`<div class="detail-row"><label>Tags</label><span class="pill">${esc(x.business_vertical)}</span></div>`:''}</section><section class="card side-card"><h3>▤ Quick Actions</h3><div class="quick-links">${x.concept_url?`<a href="${esc(x.concept_url)}" target="_blank">↗ Open Concept Site</a><button id="copyUrl">▣ Copy Site URL</button>`:''}<button id="editProspect">✎ Edit Prospect</button></div></section></div></div></div>`;wire()}function wire(){el('researchBusiness')?.addEventListener('click',researchBusiness);el('researchBusinessTop')?.addEventListener('click',researchBusiness);el('buildConcept')?.addEventListener('click',buildConcept);el('convertCustomer')?.addEventListener('click',convertCustomer);el('copyUrl')?.addEventListener('click',()=>navigator.clipboard.writeText(prospect.concept_url).then(()=>notice('Concept URL copied.')));el('editProspect')?.addEventListener('click',()=>switchView('edit'));document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>switchView(b.dataset.view));el('saveProspect')?.addEventListener('click',save);el('deleteProspect')?.addEventListener('click',remove)}function switchView(v){document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.view===v));document.querySelectorAll('[data-section]').forEach(s=>s.style.display=s.dataset.section===v?'block':'none')}function formData(){return{business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value}}async function save(s=false){try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(formData())});if(!s)notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}async function researchBusiness(){try{if(el('p_business'))await save(true);await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}async function buildConcept(){try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank')}catch(e){notice(e.message,true);await load()}}async function convertCustomer(){if(!prospect?.concept_url){notice('Build a concept site before converting this prospect.',true);return}if(!confirm(`Convert ${prospect.business_name} to a customer and promote its current concept site as the starting customer website? No Stripe checkout or invoice will be sent.`))return;try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/convert`,{method:'POST',body:'{}'});if(!d.customer_id)throw new Error('Customer record was not returned.');notice('Prospect converted to customer.');location.href=d.customer_url||`/admin/?customer=${d.customer_id}`}catch(e){notice(e.message,true)}}async function remove(){if(!confirm(`Remove ${prospect.business_name}?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}async function load(){try{const d=await window.adminApi('/api/admin/prospects?include_converted=1');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="admin-card"><div class="empty">${esc(e.message)}</div></div>`}}window.addEventListener('admin-authenticated',load);load();
</script>