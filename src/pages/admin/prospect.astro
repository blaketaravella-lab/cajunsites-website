---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" eyebrow="Sales Pipeline" description="Review and update the prospect record, business research, concept site, and customer conversion." active="prospects">
  <a slot="actions" class="admin-action" style="display:inline-grid;place-items:center" href="/admin/prospects/">← Back to Prospects</a>
  <style>
    .page{display:grid;gap:14px}.summary{display:flex;justify-content:space-between;gap:22px;align-items:flex-start}.summary h2{margin:0;color:var(--purple-950);font-size:2rem;letter-spacing:-.03em}.summary p{margin:6px 0 0;color:var(--muted)}.summary-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:.72rem;font-weight:850;color:#5f5366;text-transform:uppercase;letter-spacing:.035em}.field input,.field select,.field textarea{width:100%;padding:11px 12px}.field textarea{min-height:120px;resize:vertical}.actions{display:flex;flex-wrap:wrap;gap:8px;padding-top:4px}.notice{display:none;padding:11px 13px;border-radius:10px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.panel{margin-top:16px;padding:16px 18px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,#fdfbfe,#fbf9fc)}.panel-row{display:flex;justify-content:space-between;gap:16px;align-items:center}.panel-copy strong{display:block;color:var(--purple-950);font-size:.9rem;margin-bottom:3px}.panel-copy span{font-size:.8rem;color:var(--muted);line-height:1.5}.build-error{margin-top:10px;padding:10px 12px;border-radius:10px;background:#fff2f2;color:#8d2424;font-size:.8rem}.section-title{margin:22px 0 12px;padding-top:18px;border-top:1px solid var(--line);font-size:.74rem;font-weight:850;color:var(--purple-700);text-transform:uppercase;letter-spacing:.1em}.research-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.research-box{background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px}.research-box h4{margin:0 0 8px;color:var(--purple-950);font-size:.78rem;text-transform:uppercase;letter-spacing:.04em}.research-list{display:grid;gap:7px}.research-item{font-size:.82rem;line-height:1.4}.research-item a{color:var(--purple-700);font-weight:750;text-decoration:none}.research-summary{font-size:.84rem;color:#4f4655;line-height:1.55}.source-list{display:flex;flex-wrap:wrap;gap:6px}.source-list a{font-size:.74rem;padding:5px 8px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--purple-700);font-weight:750;text-decoration:none}@media(max-width:900px){.form-grid,.research-grid{grid-template-columns:1fr}.summary,.panel-row{display:block}.summary-actions{justify-content:flex-start;margin-top:14px}.panel-row>.pill{margin-top:10px}}@media(max-width:620px){.summary h2{font-size:1.7rem}.summary-actions{display:grid;grid-template-columns:1fr}.summary-actions .admin-action{width:100%;justify-content:center}.panel{padding:14px}.actions{display:grid;grid-template-columns:1fr}.actions .admin-action{width:100%}}
  </style>
  <div class="page"><div class="notice" id="notice"></div><div class="admin-card" id="detail"><div class="empty">Loading prospect...</div></div></div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let prospect=null;const id=Number(new URLSearchParams(location.search).get('id'));
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',5000)}
function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}
function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}
function researchPanel(x){const r=parseResearch(x),status=x.research_status||'Not Run',running=status==='Researching';const facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8);return `<div class="panel"><div class="panel-row"><div class="panel-copy"><strong>Business Research</strong><span>${status==='Complete'?`Research completed${x.researched_at?` ${esc(x.researched_at)}`:''}. Verified public details can now shape the concept.`:'Research the public web for source-backed business details before building the concept.'}</span></div><div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action" id="researchBusiness" ${running?'disabled':''}>${running?'Researching...':status==='Complete'?'Research Again':'Research Business'}</button></div></div>${x.business_vertical?`<div class="meta"><span class="pill">Vertical: ${esc(x.business_vertical)}</span></div>`:''}${x.research_error?`<div class="build-error">Last research error: ${esc(x.research_error)}</div>`:''}${r?`<div class="research-grid"><div class="research-box"><h4>Summary</h4><div class="research-summary">${esc(r.summary||'No summary returned.')}</div></div><div class="research-box"><h4>Verified Services</h4><div class="research-list">${services.length?services.map(s=>`<div class="research-item">${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank" rel="noreferrer">source</a>`:''}</div>`).join(''):'<div class="research-item">No explicit services verified.</div>'}</div></div><div class="research-box"><h4>Verified Facts</h4><div class="research-list">${facts.length?facts.map(f=>`<div class="research-item"><strong>${esc(f.label)}:</strong> ${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank" rel="noreferrer">source</a>`:''}</div>`).join(''):'<div class="research-item">No additional facts verified.</div>'}</div></div><div class="research-box"><h4>Sources</h4><div class="source-list">${sources.length?sources.map(s=>`<a href="${esc(s.url)}" target="_blank" rel="noreferrer">${esc(s.title||'Source')}</a>`).join(''):'No sources stored.'}</div></div></div>`:''}</div>`}
function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="empty">Prospect not found.</div>';return}const state=buildState(x),building=state==='Building',buildLabel=x.concept_url?'Rebuild Concept':'Build Concept',converted=Boolean(x.customer_id);el('detail').innerHTML=`<div class="summary"><div><h2>${esc(x.business_name)}</h2><p>${esc(x.category||'Category not set')} · ${esc([x.city,x.state].filter(Boolean).join(', ')||'Market not set')}</p><div class="meta"><span class="pill ${x.stage==='Won'?'green':x.stage==='Concept Built'?'gold':x.stage==='Lost'?'red':''}">${esc(x.stage||'Qualified')}</span>${x.qualification?`<span class="pill">${esc(x.qualification)}</span>`:''}<span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span>${converted?`<span class="pill green">Customer #${Number(x.customer_id)}</span>`:''}</div></div><div class="summary-actions">${x.concept_url?`<a class="admin-action" style="display:inline-grid;place-items:center" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Concept</a>`:''}${converted?'':`<button class="admin-action primary" id="convertCustomer">Convert to Customer</button>`}<button class="admin-action" id="buildConcept" ${building?'disabled':''}>${building?'Building...':buildLabel}</button></div></div>
${researchPanel(x)}
<div class="panel"><div class="panel-row"><div class="panel-copy"><strong>Customer Conversion</strong><span>${converted?`Converted to Customer #${Number(x.customer_id)}${x.converted_at?` on ${esc(x.converted_at)}`:''}.`:'Starts the existing CajunSites Stripe checkout. The prospect becomes a customer only after Stripe confirms payment.'}</span></div>${converted?'<span class="pill green">Won</span>':'<span class="pill gray">Prospect</span>'}</div></div>
<div class="panel"><div class="panel-row"><div class="panel-copy"><strong>Concept Site Factory</strong><span>${x.concept_url?`Current preview: ${esc(x.concept_url)}`:'No concept site is attached yet. Build Concept automatically uses completed business research when available.'}</span></div><span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span></div>${x.concept_build_error?`<div class="build-error">Last build error: ${esc(x.concept_build_error)}</div>`:''}</div>
<div class="section-title">Business & Pipeline</div><div class="form-grid"><div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div><div class="section-title field full" style="margin-bottom:0">Contact & Outreach</div><div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div><div class="field"><label>Call Attempts</label><input id="p_calls" type="number" min="0" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="actions" style="margin-top:18px"><button class="admin-action primary" id="saveProspect">Save Changes</button><button class="admin-action danger" id="deleteProspect">Remove Prospect</button></div>`;el('saveProspect').onclick=save;el('deleteProspect').onclick=remove;el('buildConcept').onclick=buildConcept;if(el('convertCustomer'))el('convertCustomer').onclick=convertCustomer;if(el('researchBusiness'))el('researchBusiness').onclick=researchBusiness}
async function save(){const data={business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value};try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(data)});notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}
async function researchBusiness(){const b=el('researchBusiness');b.disabled=true;b.textContent='Researching...';try{await save();await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}
async function buildConcept(){const b=el('buildConcept');b.disabled=true;b.textContent='Building...';try{await save();const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice(d.research_status==='Complete'?'Research-backed concept built successfully.':'Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank','noopener,noreferrer')}catch(e){notice(e.message,true);await load()}}
async function convertCustomer(){const b=el('convertCustomer');b.disabled=true;b.textContent='Preparing Checkout...';try{await save();const d=await window.adminApi(`/api/admin/prospects/${id}/convert-checkout`,{method:'POST',body:'{}'});if(d.already_converted){notice(`Already converted to Customer #${d.customer_id}.`);await load();return}if(!d.checkout_url)throw new Error('Checkout link was not returned.');notice('Stripe checkout opened. The prospect will convert automatically after successful payment.');window.open(d.checkout_url,'_blank','noopener,noreferrer');b.disabled=false;b.textContent='Convert to Customer'}catch(e){notice(e.message,true);if(b){b.disabled=false;b.textContent='Convert to Customer'}}}
async function remove(){if(!confirm(`Remove ${prospect.business_name} from the prospect pipeline?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}
async function load(){if(!id){el('detail').innerHTML='<div class="empty">No prospect was selected.</div>';return}try{const d=await window.adminApi('/api/admin/prospects');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
window.addEventListener('admin-authenticated',load);load();
</script>
