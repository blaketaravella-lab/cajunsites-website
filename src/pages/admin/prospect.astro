---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect" eyebrow="Sales Pipeline" description="Research, build, and move the opportunity forward." active="prospects">
  <a slot="actions" class="admin-action" style="display:inline-grid;place-items:center" href="/admin/prospects/">← Prospects</a>
  <style>
    .page{display:grid;gap:16px}.notice{display:none;padding:12px 15px;border-radius:12px;font-weight:700}.notice.show{display:block;background:#e9f7ef;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.identity{position:relative;overflow:hidden;padding:30px;background:linear-gradient(135deg,var(--purple-950),#42106f);color:#fff;border:0}.identity:after{content:"";position:absolute;width:360px;height:360px;border-radius:50%;right:-130px;top:-230px;background:rgba(240,183,25,.12)}.identity-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:end}.identity-label{font-size:.7rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-400);margin-bottom:9px}.identity h2{margin:0;font-size:clamp(2rem,4vw,3.15rem);line-height:1;letter-spacing:-.05em}.identity-sub{margin:10px 0 0;color:#d9cfe2;font-size:.92rem}.identity-meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px}.identity .pill{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.14);color:#fff}.identity .pill.green{background:#dff6e8;color:#17683a}.identity .pill.gold{background:#fff0bd;color:#755400}.identity .pill.red{background:#fde5e5;color:#8d2424}.hero-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.identity .admin-action{background:#fff;color:var(--purple-950);border-color:#fff}.identity .admin-action.primary{background:var(--gold-500);border-color:var(--gold-500);color:#241235}.identity .admin-action.ghost{background:transparent;border-color:rgba(255,255,255,.25);color:#fff}.stagebar{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;padding:12px 14px}.stage-step{position:relative;padding:9px 8px;text-align:center;border-radius:9px;background:#f7f4f8;color:#8a7e90;font-size:.68rem;font-weight:850}.stage-step.done{background:#f0e9f5;color:var(--purple-700)}.stage-step.current{background:var(--purple-800);color:#fff;box-shadow:0 5px 14px rgba(64,20,110,.18)}.workspace{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(310px,.65fr);gap:16px;align-items:start}.maincol,.sidecol{display:grid;gap:16px}.sidecol{position:sticky;top:86px}.card{background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 8px 28px rgba(34,6,63,.045);overflow:hidden}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:20px 22px;border-bottom:1px solid var(--line)}.card-title{display:flex;gap:12px;align-items:flex-start}.icon{width:36px;height:36px;border-radius:11px;background:#f3edf7;color:var(--purple-700);display:grid;place-items:center;font-weight:900;flex:0 0 auto}.card-head h3{margin:0;color:var(--purple-950);font-size:1rem}.card-head p{margin:4px 0 0;color:var(--muted);font-size:.78rem;line-height:1.45}.card-body{padding:20px 22px}.research-summary{font-size:.9rem;line-height:1.65;color:#4e4553;padding:16px;border-radius:14px;background:#faf8fb;border:1px solid #eee8f1}.research-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:14px 0}.research-stat{padding:12px;border-radius:12px;background:#faf8fb;border:1px solid #eee8f1}.research-stat strong{display:block;color:var(--purple-950);font-size:1.25rem}.research-stat span{font-size:.67rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:850}.evidence{display:grid;grid-template-columns:1fr 1fr;gap:12px}.evidence-box{border:1px solid var(--line);border-radius:14px;padding:14px}.evidence-box h4{margin:0 0 10px;font-size:.68rem;letter-spacing:.09em;text-transform:uppercase;color:var(--purple-700)}.evidence-list{display:grid;gap:8px}.evidence-item{font-size:.78rem;line-height:1.45;color:#514758}.evidence-item a,.source-chip{color:var(--purple-700);font-weight:800;text-decoration:none}.sources{display:flex;gap:6px;flex-wrap:wrap}.source-chip{font-size:.68rem;padding:5px 8px;border:1px solid var(--line);border-radius:999px;background:#fff}.errorbox{padding:11px 13px;border-radius:11px;background:#fff1f1;color:#8d2424;font-size:.78rem;line-height:1.45}.quick-card{padding:18px}.quick-label{font-size:.66rem;text-transform:uppercase;letter-spacing:.09em;font-weight:900;color:var(--muted);margin-bottom:7px}.quick-value{font-size:.9rem;color:var(--purple-950);font-weight:800;overflow-wrap:anywhere}.quick-value.muted{font-weight:650;color:#645a69}.quick-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.quick-row:last-child{border:0;padding-bottom:0}.quick-row:first-child{padding-top:0}.concept-link{display:block;margin-top:13px;padding:12px 13px;border-radius:11px;background:#f7f2fa;color:var(--purple-700);font-size:.74rem;font-weight:800;text-decoration:none;overflow-wrap:anywhere}.conversion{background:linear-gradient(145deg,#fffaf0,#fff);border-color:#f1dfae}.conversion .icon{background:#fff0bd;color:#755400}.conversion-copy{font-size:.8rem;color:#665b48;line-height:1.55}.tabs{display:flex;gap:4px;padding:7px;background:#f6f2f7;border-radius:12px;margin-bottom:18px}.tab{flex:1;border:0;background:transparent;padding:9px;border-radius:8px;font:inherit;font-size:.75rem;font-weight:850;color:#746979;cursor:pointer}.tab.active{background:#fff;color:var(--purple-800);box-shadow:0 2px 8px rgba(34,6,63,.08)}.tabpane{display:none}.tabpane.active{display:block}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:.66rem;font-weight:900;color:#665a6c;text-transform:uppercase;letter-spacing:.065em}.field input,.field select,.field textarea{width:100%;padding:11px 12px}.field textarea{min-height:120px;resize:vertical}.form-actions{display:flex;justify-content:space-between;gap:10px;margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}@media(max-width:1080px){.workspace{grid-template-columns:1fr}.sidecol{position:static;grid-template-columns:1fr 1fr}.identity-grid{grid-template-columns:1fr}.hero-actions{justify-content:flex-start}.stagebar{overflow:auto;grid-template-columns:repeat(6,minmax(110px,1fr))}}@media(max-width:720px){.identity{padding:22px}.hero-actions{display:grid;grid-template-columns:1fr}.hero-actions .admin-action{justify-content:center}.sidecol,.evidence,.form-grid{grid-template-columns:1fr}.field.full{grid-column:1}.research-stats{grid-template-columns:repeat(3,1fr)}.card-head{padding:17px}.card-body{padding:17px}.form-actions{display:grid;grid-template-columns:1fr}.form-actions .admin-action{width:100%;justify-content:center}.tabs{overflow:auto}.tab{min-width:110px}}
  </style>
  <div class="page"><div class="notice" id="notice"></div><div id="detail"><div class="admin-card"><div class="empty">Loading prospect...</div></div></div></div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let prospect=null;const id=Number(new URLSearchParams(location.search).get('id'));const stages=['Qualified','Concept Built','Contacted','Concept Viewed','Won'];
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',6000)}function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}function stageBar(x){const current=x.stage==='Lost'?-1:stages.indexOf(x.stage);return `<div class="card stagebar">${stages.map((s,i)=>`<div class="stage-step ${i<current?'done':i===current?'current':''}">${esc(s)}</div>`).join('')}<div class="stage-step ${x.customer_id?'current':''}">Customer</div></div>`}
function researchCard(x){const r=parseResearch(x),status=x.research_status||'Not Run',facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8),running=status==='Researching';return `<section class="card"><div class="card-head"><div class="card-title"><div class="icon">⌕</div><div><h3>Business Intelligence</h3><p>Source-backed research used to tailor copy, services, and visual direction.</p></div></div><div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action" id="researchBusiness" ${running?'disabled':''}>${running?'Researching...':status==='Complete'?'Refresh Research':'Research Business'}</button></div></div><div class="card-body">${x.business_vertical?`<div style="margin-bottom:12px"><span class="pill gold">${esc(x.business_vertical)}</span></div>`:''}${x.research_error?`<div class="errorbox">${esc(x.research_error)}</div>`:''}${r?`<div class="research-summary">${esc(r.summary||'No summary returned.')}</div><div class="research-stats"><div class="research-stat"><strong>${services.length}</strong><span>Services</span></div><div class="research-stat"><strong>${facts.length}</strong><span>Facts</span></div><div class="research-stat"><strong>${sources.length}</strong><span>Sources</span></div></div><div class="evidence"><div class="evidence-box"><h4>Verified Services</h4><div class="evidence-list">${services.length?services.map(s=>`<div class="evidence-item">${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank" rel="noreferrer">↗</a>`:''}</div>`).join(''):'<div class="evidence-item">No explicit services verified.</div>'}</div></div><div class="evidence-box"><h4>Verified Facts</h4><div class="evidence-list">${facts.length?facts.map(f=>`<div class="evidence-item"><strong>${esc(f.label)}</strong><br>${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank" rel="noreferrer">↗</a>`:''}</div>`).join(''):'<div class="evidence-item">No additional facts verified.</div>'}</div></div></div><div style="margin-top:14px"><div class="quick-label">Sources</div><div class="sources">${sources.map(s=>`<a class="source-chip" href="${esc(s.url)}" target="_blank" rel="noreferrer">${esc(s.title||'Source')} ↗</a>`).join('')||'<span class="quick-value muted">No sources stored.</span>'}</div></div>`:'<div class="research-summary">Run research to create a verified business profile before building the concept.</div>'}</div></section>`}
function recordCard(x){return `<section class="card"><div class="card-head"><div class="card-title"><div class="icon">✎</div><div><h3>Prospect Record</h3><p>Edit business details and outreach without cluttering the working view.</p></div></div></div><div class="card-body"><div class="tabs"><button class="tab active" data-tab="business">Business</button><button class="tab" data-tab="contact">Contact</button><button class="tab" data-tab="outreach">Outreach</button><button class="tab" data-tab="notes">Notes</button></div><div class="tabpane active" data-pane="business"><div class="form-grid"><div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field full"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div></div></div><div class="tabpane" data-pane="contact"><div class="form-grid"><div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field full"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div></div></div><div class="tabpane" data-pane="outreach"><div class="form-grid"><div class="field"><label>Call Attempts</label><input id="p_calls" type="number" min="0" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="field full"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div></div></div><div class="tabpane" data-pane="notes"><div class="field"><label>Internal Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="form-actions"><button class="admin-action danger" id="deleteProspect">Remove Prospect</button><button class="admin-action primary" id="saveProspect">Save Changes</button></div></div></section>`}
function sideCards(x,state,converted){return `<div class="sidecol"><section class="card quick-card"><div class="quick-label">Opportunity Snapshot</div><div class="quick-row"><div><div class="quick-label">Contact</div><div class="quick-value">${esc(x.contact_name||'Not identified')}</div></div><div><div class="quick-label">Calls</div><div class="quick-value">${Number(x.call_attempts||0)}</div></div></div><div class="quick-row"><div><div class="quick-label">Phone</div><div class="quick-value muted">${esc(x.phone||'Not set')}</div></div><div><div class="quick-label">Follow-up</div><div class="quick-value muted">${esc(x.next_follow_up||'Not scheduled')}</div></div></div></section><section class="card quick-card"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><div><div class="quick-label">Concept Site</div><div class="quick-value">${esc(state)}</div></div><span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span></div>${x.concept_url?`<a class="concept-link" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">${esc(x.concept_url)} ↗</a>`:'<div class="quick-value muted" style="margin-top:10px">No preview deployed yet.</div>'}${x.concept_build_error?`<div class="errorbox" style="margin-top:10px">${esc(x.concept_build_error)}</div>`:''}</section><section class="card quick-card conversion"><div class="card-title"><div class="icon">$</div><div><div class="quick-label">Customer Conversion</div><div class="quick-value">${converted?`Customer #${Number(x.customer_id)}`:'Ready when sold'}</div></div></div><p class="conversion-copy">${converted?'Payment confirmed and the prospect is linked to its customer record.':'Checkout creates the customer automatically only after Stripe confirms payment.'}</p>${converted?'<span class="pill green">Converted</span>':'<span class="pill gray">Not converted</span>'}</section></div>`}
function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="admin-card"><div class="empty">Prospect not found.</div></div>';return}const state=buildState(x),building=state==='Building',converted=Boolean(x.customer_id),market=[x.city,x.state].filter(Boolean).join(', ')||'Market not set';el('detail').innerHTML=`<div class="page"><section class="card identity"><div class="identity-grid"><div><div class="identity-label">Prospect #${Number(x.id)}</div><h2>${esc(x.business_name)}</h2><p class="identity-sub">${esc(x.business_vertical||x.category||'Category not set')} · ${esc(market)}</p><div class="identity-meta"><span class="pill ${x.stage==='Won'?'green':x.stage==='Concept Built'?'gold':x.stage==='Lost'?'red':''}">${esc(x.stage||'Qualified')}</span>${x.qualification?`<span class="pill">${esc(x.qualification)}</span>`:''}<span class="pill ${x.research_status==='Complete'?'green':''}">${esc(x.research_status||'Research not run')}</span></div></div><div class="hero-actions">${x.concept_url?`<a class="admin-action ghost" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">View Concept ↗</a>`:''}<button class="admin-action ghost" id="buildConcept" ${building?'disabled':''}>${building?'Building...':x.concept_url?'Rebuild Concept':'Build Concept'}</button>${converted?'':`<button class="admin-action primary" id="convertCustomer">Convert to Customer</button>`}</div></div></section>${stageBar(x)}<div class="workspace"><div class="maincol">${researchCard(x)}${recordCard(x)}</div>${sideCards(x,state,converted)}</div></div>`;wire()}
function wire(){el('saveProspect').onclick=save;el('deleteProspect').onclick=remove;el('buildConcept').onclick=buildConcept;if(el('convertCustomer'))el('convertCustomer').onclick=convertCustomer;if(el('researchBusiness'))el('researchBusiness').onclick=researchBusiness;document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.tabpane').forEach(p=>p.classList.toggle('active',p.dataset.pane===b.dataset.tab))})}
function formData(){return{business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value}}
async function save(silent=false){try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(formData())});if(!silent)notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}async function researchBusiness(){const b=el('researchBusiness');b.disabled=true;b.textContent='Researching...';try{await save(true);await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}async function buildConcept(){const b=el('buildConcept');b.disabled=true;b.textContent='Building...';try{await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice(d.research_status==='Complete'?'Research-backed concept built successfully.':'Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank','noopener,noreferrer')}catch(e){notice(e.message,true);await load()}}async function convertCustomer(){const b=el('convertCustomer');b.disabled=true;b.textContent='Preparing Checkout...';try{await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/convert-checkout`,{method:'POST',body:'{}'});if(d.already_converted){notice(`Already converted to Customer #${d.customer_id}.`);await load();return}if(!d.checkout_url)throw new Error('Checkout link was not returned.');notice('Stripe checkout opened. Conversion completes after successful payment.');window.open(d.checkout_url,'_blank','noopener,noreferrer');b.disabled=false;b.textContent='Convert to Customer'}catch(e){notice(e.message,true);if(b){b.disabled=false;b.textContent='Convert to Customer'}}}async function remove(){if(!confirm(`Remove ${prospect.business_name} from the prospect pipeline?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}async function load(){if(!id){el('detail').innerHTML='<div class="admin-card"><div class="empty">No prospect selected.</div></div>';return}try{const d=await window.adminApi('/api/admin/prospects');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="admin-card"><div class="empty">${esc(e.message)}</div></div>`}}window.addEventListener('admin-authenticated',load);load();
</script>
