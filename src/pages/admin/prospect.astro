---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" eyebrow="Sales Pipeline" description="Research, build, and move the opportunity forward." active="prospects"><a slot="actions" class="admin-action" href="/admin/prospects/">← Back to Prospects</a><style>
.page{display:grid;gap:14px}.notice{display:none;padding:11px 14px;border-radius:10px;font-weight:700}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.profile{display:grid;grid-template-columns:130px minmax(0,1fr) 270px;gap:20px;align-items:center;padding:0 4px}.profile-visual{height:130px;border-radius:15px;background:linear-gradient(145deg,#1d2630,#4e5963);display:grid;place-items:center;overflow:hidden;position:relative}.profile-visual:before{content:"";position:absolute;width:90px;height:90px;border:12px solid rgba(255,255,255,.12);border-radius:50%;transform:rotate(-20deg)}.profile-visual span{position:relative;color:#fff;font-size:2rem;font-weight:950}.profile h2{margin:0;color:#280548;font-size:clamp(2rem,3.2vw,3rem);line-height:1;letter-spacing:-.05em}.profile-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:11px;color:#776b7d;font-size:.82rem;font-weight:700}.profile-summary{margin:10px 0 0;color:#6e6275;font-size:.88rem}.stage-card{border:1px solid #e9e2ed;border-radius:13px;background:#fff;padding:15px 16px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.stage-card label{display:block;font-size:.65rem;color:#827589;font-weight:800;margin-bottom:6px}.stage-card strong{color:#382048;font-size:.78rem}.action-pipeline{background:#fff;border:1px solid #e9e2ed;border-radius:16px;padding:14px}.action-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr 1.1fr;gap:9px}.action-tile{min-height:70px;padding:11px 15px;border:1px solid #e5ddea;border-radius:11px;background:#fff;color:#42116e;text-decoration:none;display:flex;align-items:center;gap:11px;cursor:pointer;text-align:left}.action-tile:hover{border-color:#cdbdd8;box-shadow:0 7px 17px rgba(40,5,72,.06)}.action-tile.purple{background:linear-gradient(135deg,#3d076c,#681ab8);color:#fff;border-color:#500c8c}.action-tile.gold{background:linear-gradient(135deg,#ffbd16,#ffd058);color:#2b074a;border-color:#efb018}.action-icon{font-size:1.45rem;width:28px;text-align:center}.action-copy strong{display:block;font-size:.82rem}.action-copy span{display:block;font-size:.68rem;margin-top:3px;opacity:.72}.pipeline{display:grid;grid-template-columns:repeat(6,1fr);margin-top:17px;padding:0 15px 2px}.pipe-step{text-align:center;position:relative;padding-top:24px;font-size:.67rem;font-weight:800;color:#807489}.pipe-step:before{content:"";position:absolute;top:5px;left:50%;width:18px;height:18px;border-radius:50%;background:#dcd9e7;z-index:2}.pipe-step:after{content:"";position:absolute;top:13px;left:-50%;width:100%;height:2px;background:#dcd9e7}.pipe-step:first-child:after{display:none}.pipe-step.done:before{background:#1b934c}.pipe-step.done:after,.pipe-step.current:after{background:#6b25c4}.pipe-step.current{color:#4c1483}.pipe-step.current:before{background:#7425d0;box-shadow:0 0 0 4px #f1e9fa}.tabs{display:flex;gap:4px;border-bottom:1px solid #e9e2ed;margin-top:5px;overflow:auto}.navtab{border:0;background:none;padding:13px 16px 12px;color:#81758a;font-weight:800;font-size:.76rem;white-space:nowrap;cursor:pointer;border-bottom:2px solid transparent}.navtab.active{color:#641bc0;border-color:#7425d0}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:14px;align-items:start}.maincol,.sidecol{display:grid;gap:14px}.sidecol{position:sticky;top:72px}.card{background:#fff;border:1px solid #e9e2ed;border-radius:15px;overflow:hidden}.card-head{display:flex;justify-content:space-between;gap:14px;align-items:center;padding:17px 19px;border-bottom:1px solid #eee9f1}.card-head h3{margin:0;font-size:.95rem}.card-head p{margin:4px 0 0;color:#807489;font-size:.72rem}.card-body{padding:18px}.research-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:13px}.research-stat{border:1px solid #e9e2ed;border-radius:11px;padding:12px}.research-stat strong{display:block;font-size:1.35rem;color:#39105d}.research-stat span{font-size:.67rem;color:#81758a}.research-summary{border:1px solid #eee8f1;border-radius:11px;padding:14px;color:#55495b;font-size:.82rem;line-height:1.6}.evidence{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.evidence-box{border:1px solid #eee8f1;border-radius:11px;padding:13px}.evidence-box h4{margin:0 0 9px;font-size:.68rem;text-transform:uppercase;color:#5d1b98}.evidence-item{font-size:.76rem;line-height:1.5;margin:6px 0}.evidence-item a{color:#681ab8;font-weight:850;text-decoration:none}.sources{display:flex;gap:6px;flex-wrap:wrap;margin-top:11px}.source-chip{font-size:.66rem;padding:5px 8px;border:1px solid #e7deeb;border-radius:999px;color:#5d1b98;text-decoration:none;font-weight:800}.side-card{padding:17px}.side-card h3{display:flex;align-items:center;gap:8px;margin:0 0 15px}.detail-row{padding:10px 0;border-bottom:1px solid #eee9f1}.detail-row:last-child{border:0}.detail-row label{display:block;color:#887b90;font-size:.63rem;font-weight:800;margin-bottom:4px}.detail-row div{font-size:.78rem;color:#3e284d;font-weight:700;overflow-wrap:anywhere}.quick-links{display:grid;gap:7px}.quick-links a,.quick-links button{border:0;background:none;padding:5px 0;color:#641bc0;text-decoration:none;text-align:left;font-size:.76rem;font-weight:800;cursor:pointer}.editor{display:none}.editor.active{display:block}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.64rem;font-weight:900;color:#6b5e72;text-transform:uppercase}.field input,.field select,.field textarea{width:100%;padding:10px 11px}.field textarea{min-height:110px}.form-actions{display:flex;justify-content:space-between;gap:9px;margin-top:15px;padding-top:14px;border-top:1px solid #eee9f1}.errorbox{margin-top:10px;padding:10px;border-radius:9px;background:#fff0f0;color:#8d2424;font-size:.74rem}@media(max-width:1050px){.profile{grid-template-columns:100px 1fr}.profile-visual{height:100px}.stage-card{grid-column:1/-1}.workspace{grid-template-columns:1fr}.sidecol{position:static;grid-template-columns:1fr 1fr}}@media(max-width:760px){.profile{grid-template-columns:1fr}.profile-visual{display:none}.action-grid{grid-template-columns:1fr 1fr}.pipeline{overflow:auto;grid-template-columns:repeat(6,minmax(100px,1fr))}.sidecol,.evidence,.form-grid{grid-template-columns:1fr}.field.full{grid-column:1}.research-stats{grid-template-columns:repeat(3,1fr)}}@media(max-width:520px){.action-grid{grid-template-columns:1fr}.profile h2{font-size:2rem}.form-actions{display:grid}.form-actions button{width:100%}}
</style><div class="page"><div class="notice" id="notice"></div><div id="detail"><div class="admin-card"><div class="empty">Loading prospect...</div></div></div></div></AdminShell><script is:inline>
const el=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let prospect=null;const id=Number(new URLSearchParams(location.search).get('id')),stages=['Qualified','Concept Built','Contacted','Concept Viewed','Won'];function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='notice show'+(b?' error':'');setTimeout(()=>n.className='notice',5000)}function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}function pipeline(x){const c=x.stage==='Lost'?-1:stages.indexOf(x.stage);return `<div class="pipeline">${stages.map((s,i)=>`<div class="pipe-step ${i<c?'done':i===c?'current':''}">${esc(s)}</div>`).join('')}<div class="pipe-step ${x.customer_id?'current':''}">Customer</div></div>`}function research(x){const r=parseResearch(x),facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8),status=x.research_status||'Not Run';return `<section class="card"><div class="card-head"><div><h3>Business Research</h3><p>Source-backed business details used to customize the concept.</p></div><div style="display:flex;gap:7px;align-items:center"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action compact" id="researchBusiness">${status==='Complete'?'Research Again':'Research Business'}</button></div></div><div class="card-body">${x.research_error?`<div class="errorbox">${esc(x.research_error)}</div>`:''}${r?`<div class="research-stats"><div class="research-stat"><strong>${services.length}</strong><span>Verified Services</span></div><div class="research-stat"><strong>${facts.length}</strong><span>Verified Facts</span></div><div class="research-stat"><strong>${sources.length}</strong><span>Source Links</span></div></div><div class="research-summary">${esc(r.summary||'No summary returned.')}</div><div class="evidence"><div class="evidence-box"><h4>Key Services</h4>${services.map(s=>`<div class="evidence-item">✓ ${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="evidence-item">No services verified.</div>'}</div><div class="evidence-box"><h4>Verified Facts</h4>${facts.map(f=>`<div class="evidence-item"><strong>${esc(f.label)}:</strong> ${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank">↗</a>`:''}</div>`).join('')||'<div class="evidence-item">No facts verified.</div>'}</div></div><div class="sources">${sources.map(s=>`<a class="source-chip" href="${esc(s.url)}" target="_blank">${esc(s.title||'Source')} ↗</a>`).join('')}</div>`:'<div class="research-summary">Run research to build a verified business profile.</div>'}</div></section>`}function editor(x){return `<section class="card editor" id="editor"><div class="card-head"><div><h3>Edit Prospect</h3><p>Update the underlying business and outreach record.</p></div></div><div class="card-body"><div class="form-grid"><div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field full"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div><div class="field"><label>Call Attempts</label><input id="p_calls" type="number" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="field full"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field full"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div><div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="form-actions"><button class="admin-action danger" id="deleteProspect">Remove Prospect</button><button class="admin-action primary" id="saveProspect">Save Changes</button></div></div></section>`}function render(){const x=prospect;if(!x)return;const r=parseResearch(x),state=buildState(x),converted=!!x.customer_id,market=[x.city,x.state].filter(Boolean).join(', ')||'Market not set',summary=r?.summary||`${x.business_vertical||x.category||'Local business'} in ${market}.`;el('detail').innerHTML=`<div class="page"><div class="profile"><div class="profile-visual"><span>${esc(String(x.business_name||'CS').slice(0,1))}</span></div><div><h2>${esc(x.business_name)}</h2><div class="profile-meta"><span>◇ ${esc(x.category||'Category not set')}</span><span>⌖ ${esc(market)}</span>${x.business_vertical?`<span>▣ ${esc(x.business_vertical)}</span>`:''}</div><p class="profile-summary">${esc(summary)}</p></div><div class="stage-card"><div><label>Stage</label><span class="pill ${x.stage==='Concept Built'?'gold':x.stage==='Won'?'green':''}">${esc(x.stage||'Qualified')}</span></div><div><label>Last Updated</label><strong>${esc(x.updated_at||'Recently')}</strong></div></div></div><div class="action-pipeline"><div class="action-grid"><button class="action-tile purple" id="researchBusinessTop"><span class="action-icon">⌕</span><span class="action-copy"><strong>${x.research_status==='Complete'?'Research Again':'Research Business'}</strong><span>Update business details</span></span></button><button class="action-tile" id="buildConcept"><span class="action-icon">◇</span><span class="action-copy"><strong>${x.concept_url?'Rebuild Concept':'Build Concept'}</strong><span>Generate a new version</span></span></button>${x.concept_url?`<a class="action-tile" href="${esc(x.concept_url)}" target="_blank"><span class="action-icon">↗</span><span class="action-copy"><strong>Open Concept</strong><span>View live preview</span></span></a>`:'<div class="action-tile"><span class="action-icon">□</span><span class="action-copy"><strong>No Concept Yet</strong><span>Build to create preview</span></span></div>'}${converted?`<div class="action-tile gold"><span class="action-icon">✓</span><span class="action-copy"><strong>Customer #${Number(x.customer_id)}</strong><span>Converted</span></span></div>`:`<button class="action-tile gold" id="convertCustomer"><span class="action-icon">♙</span><span class="action-copy"><strong>Convert to Customer</strong><span>Start Stripe checkout</span></span></button>`}</div>${pipeline(x)}</div><div class="tabs"><button class="navtab active" data-view="research">▤ Business Research</button><button class="navtab" data-view="edit">✎ Prospect Details</button></div><div class="workspace"><div class="maincol"><div data-section="research">${research(x)}</div><div data-section="edit" style="display:none">${editor(x)}</div></div><div class="sidecol"><section class="card side-card"><h3>ⓘ Prospect Overview</h3><div class="detail-row"><label>Business Name</label><div>${esc(x.business_name)}</div></div><div class="detail-row"><label>Category</label><div>${esc(x.category||'Not set')}</div></div><div class="detail-row"><label>City</label><div>${esc(x.city||'Not set')}</div></div><div class="detail-row"><label>State</label><div>${esc(x.state||'Not set')}</div></div><div class="detail-row"><label>Stage</label><span class="pill gold">${esc(x.stage||'Qualified')}</span></div>${x.business_vertical?`<div class="detail-row"><label>Tags</label><span class="pill">${esc(x.business_vertical)}</span></div>`:''}</section><section class="card side-card"><h3>▤ Quick Actions</h3><div class="quick-links">${x.concept_url?`<a href="${esc(x.concept_url)}" target="_blank">↗ Open Concept Site</a><button id="copyUrl">▣ Copy Site URL</button>`:''}<button id="editProspect">✎ Edit Prospect</button></div></section></div></div></div>`;wire()}function wire(){const rb=el('researchBusiness'),rt=el('researchBusinessTop');if(rb)rb.onclick=researchBusiness;if(rt)rt.onclick=researchBusiness;if(el('buildConcept'))el('buildConcept').onclick=buildConcept;if(el('convertCustomer'))el('convertCustomer').onclick=convertCustomer;if(el('copyUrl'))el('copyUrl').onclick=()=>navigator.clipboard.writeText(prospect.concept_url).then(()=>notice('Concept URL copied.'));if(el('editProspect'))el('editProspect').onclick=()=>switchView('edit');document.querySelectorAll('.navtab').forEach(b=>b.onclick=()=>switchView(b.dataset.view));if(el('saveProspect'))el('saveProspect').onclick=save;if(el('deleteProspect'))el('deleteProspect').onclick=remove}function switchView(v){document.querySelectorAll('.navtab').forEach(b=>b.classList.toggle('active',b.dataset.view===v));document.querySelectorAll('[data-section]').forEach(s=>s.style.display=s.dataset.section===v?'block':'none');if(v==='edit')el('editor')?.classList.add('active')}function formData(){return{business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value}}async function save(s=false){try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(formData())});if(!s)notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}async function researchBusiness(){try{if(el('p_business'))await save(true);await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}async function buildConcept(){try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank')}catch(e){notice(e.message,true);await load()}}async function convertCustomer(){try{if(el('p_business'))await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/convert-checkout`,{method:'POST',body:'{}'});if(d.already_converted){await load();return}if(!d.checkout_url)throw new Error('Checkout link was not returned.');window.open(d.checkout_url,'_blank')}catch(e){notice(e.message,true)}}async function remove(){if(!confirm(`Remove ${prospect.business_name}?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}async function load(){try{const d=await window.adminApi('/api/admin/prospects');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="admin-card"><div class="empty">${esc(e.message)}</div></div>`}}window.addEventListener('admin-authenticated',load);load();
</script>