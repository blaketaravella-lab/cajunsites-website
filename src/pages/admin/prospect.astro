---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" eyebrow="Sales Pipeline" description="Review and update the prospect record, outreach, follow-up, and concept site." active="prospects">
  <a slot="actions" class="admin-action" style="display:inline-grid;place-items:center;text-decoration:none" href="/admin/prospects/">← Back to Prospects</a>
  <style>
    .page{display:grid;gap:14px}.summary{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.summary h2{margin:0;color:var(--purple-950);font-size:2rem}.summary p{margin:5px 0 0}.summary-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.74rem;font-weight:800;color:#5f5366}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:10px;padding:11px;background:white}.field textarea{min-height:120px;resize:vertical}.actions{display:flex;flex-wrap:wrap;gap:8px}.danger{color:#8d2424}.notice{display:none;padding:11px 13px;border-radius:10px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.meta{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.build-panel{margin-top:18px;padding:16px;border:1px solid var(--line);border-radius:14px;background:#fbf9fc}.build-row{display:flex;justify-content:space-between;gap:16px;align-items:center}.build-copy strong{display:block;color:var(--purple-950)}.build-copy span{font-size:.8rem;color:var(--muted)}.build-error{margin-top:10px;color:#8d2424;font-size:.8rem}.admin-action[disabled]{opacity:.55;cursor:not-allowed}@media(max-width:900px){.form-grid{grid-template-columns:1fr}.summary,.build-row{display:block}.summary-actions{justify-content:flex-start;margin-top:14px}.build-row .admin-action{margin-top:12px}}
  </style>
  <div class="page">
    <div class="notice" id="notice"></div>
    <div class="admin-card" id="detail"><div class="empty">Loading prospect...</div></div>
  </div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot',"'":'&#39;'}[c]));
let prospect=null;const id=Number(new URLSearchParams(location.search).get('id'));
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',5000)}
function buildState(x){if(x.concept_state)return x.concept_state;return x.concept_url?'Built':'Not Built'}
function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="empty">Prospect not found.</div>';return}const state=buildState(x);const building=state==='Building';const buildLabel=x.concept_url?'Rebuild Concept':'Build Concept';el('detail').innerHTML=`<div class="summary"><div><h2>${esc(x.business_name)}</h2><p>${esc(x.category||'Category not set')} · ${esc([x.city,x.state].filter(Boolean).join(', ')||'Market not set')}</p><div class="meta"><span class="pill ${x.stage==='Won'?'green':x.stage==='Concept Built'?'gold':''}">${esc(x.stage||'Qualified')}</span>${x.qualification?`<span class="pill">${esc(x.qualification)}</span>`:''}<span class="pill ${state==='Built'?'green':state==='Build Failed'?'gold':''}">${esc(state)}</span></div></div><div class="summary-actions">${x.concept_url?`<a class="admin-action" style="display:inline-grid;place-items:center;text-decoration:none" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Concept</a>`:''}<button class="admin-action primary" id="buildConcept" ${building?'disabled':''}>${building?'Building...':buildLabel}</button></div></div><div class="build-panel"><div class="build-row"><div class="build-copy"><strong>Concept Site Factory</strong><span>${x.concept_url?`Current preview: ${esc(x.concept_url)}`:'No concept site is attached yet. Build one from the prospect record.'}</span></div><span class="pill ${state==='Built'?'green':''}">${esc(state)}</span></div>${x.concept_build_error?`<div class="build-error">Last build error: ${esc(x.concept_build_error)}</div>`:''}</div><div class="form-grid" style="margin-top:20px">
<div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div>
<div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div>
<div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div>
<div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div>
<div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div>
<div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div>
<div class="field"><label>Call Attempts</label><input id="p_calls" type="number" min="0" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div>
<div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div>
<div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="actions" style="margin-top:16px"><button class="admin-action primary" id="saveProspect">Save Changes</button><button class="admin-action danger" id="deleteProspect">Remove Prospect</button></div>`;el('saveProspect').onclick=save;el('deleteProspect').onclick=remove;el('buildConcept').onclick=buildConcept}
async function save(){const data={business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value};try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(data)});notice('Prospect updated.');await load()}catch(e){notice(e.message,true)}}
async function buildConcept(){const b=el('buildConcept');b.disabled=true;b.textContent='Building...';try{await save();const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank','noopener,noreferrer')}catch(e){notice(e.message,true);await load()}}
async function remove(){if(!confirm(`Remove ${prospect.business_name} from the prospect pipeline?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}
async function load(){if(!id){el('detail').innerHTML='<div class="empty">No prospect was selected.</div>';return}try{const d=await window.adminApi('/api/admin/prospects');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="empty">${esc(e.message)}</div>`}}
window.addEventListener('admin-authenticated',load);load();
</script>
