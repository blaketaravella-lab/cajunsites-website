---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospect Details" eyebrow="Sales Pipeline" description="Research the business, manage the concept, track outreach, and convert the prospect." active="prospects">
  <a slot="actions" class="admin-action" style="display:inline-grid;place-items:center" href="/admin/prospects/">← Back to Prospects</a>
  <style>
    .page{display:grid;gap:18px}.hero-card{padding:28px}.summary{display:flex;justify-content:space-between;gap:28px;align-items:flex-start}.summary-copy{min-width:0}.summary h2{margin:0;color:var(--purple-950);font-size:clamp(2rem,3vw,2.65rem);line-height:1.04;letter-spacing:-.045em}.summary p{margin:9px 0 0;color:var(--muted);font-size:.95rem}.meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:15px}.summary-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;max-width:520px}.workflow-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:16px}.panel{padding:20px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(180deg,#fff,#fdfbfe);box-shadow:0 8px 24px rgba(34,6,63,.035)}.panel-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.panel-copy{min-width:0}.panel-copy strong{display:block;color:var(--purple-950);font-size:1rem;margin-bottom:5px}.panel-copy span{display:block;font-size:.84rem;color:var(--muted);line-height:1.55}.panel-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.preview-url{margin-top:14px;padding:10px 12px;border-radius:10px;background:#f8f5fa;color:var(--purple-700);font-size:.78rem;overflow-wrap:anywhere}.build-error{margin-top:14px;padding:11px 13px;border:1px solid #f3caca;border-radius:11px;background:#fff4f4;color:#8d2424;font-size:.8rem;line-height:1.5}.research-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.research-box{background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px}.research-box h4{margin:0 0 9px;color:var(--purple-950);font-size:.72rem;text-transform:uppercase;letter-spacing:.075em}.research-list{display:grid;gap:8px}.research-item,.research-summary{font-size:.82rem;line-height:1.55;color:#514758}.research-item a{color:var(--purple-700);font-weight:800;text-decoration:none}.source-list{display:flex;flex-wrap:wrap;gap:6px}.source-list a{font-size:.72rem;padding:5px 8px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--purple-700);font-weight:800;text-decoration:none}.section-card{padding:24px 26px}.section-heading{display:flex;justify-content:space-between;gap:16px;align-items:end;padding-bottom:16px;margin-bottom:18px;border-bottom:1px solid var(--line)}.section-heading h3{margin:0;color:var(--purple-950);font-size:1.08rem}.section-heading p{margin:4px 0 0;color:var(--muted);font-size:.8rem}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:.7rem;font-weight:850;color:#5f5366;text-transform:uppercase;letter-spacing:.055em}.field input,.field select,.field textarea{width:100%;padding:12px 13px}.field textarea{min-height:120px;resize:vertical}.subhead{grid-column:1/-1;margin-top:6px;padding-top:20px;border-top:1px solid var(--line);font-size:.72rem;font-weight:850;color:var(--purple-700);text-transform:uppercase;letter-spacing:.1em}.actions{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:20px;padding-top:18px;border-top:1px solid var(--line)}.notice{display:none;padding:12px 14px;border-radius:11px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}@media(max-width:1050px){.workflow-grid{grid-template-columns:1fr}.summary{display:block}.summary-actions{justify-content:flex-start;max-width:none;margin-top:18px}}@media(max-width:720px){.hero-card,.section-card{padding:18px}.form-grid,.research-grid{grid-template-columns:1fr}.field.full,.subhead{grid-column:1}.panel-head{display:block}.panel-actions{justify-content:flex-start;margin-top:12px}.summary-actions{display:grid;grid-template-columns:1fr}.summary-actions .admin-action{width:100%;justify-content:center}.actions{display:grid;grid-template-columns:1fr}.actions .admin-action{width:100%;justify-content:center}}
  </style>
  <div class="page"><div class="notice" id="notice"></div><div id="detail"><div class="admin-card"><div class="empty">Loading prospect...</div></div></div></div>
</AdminShell>
<script is:inline>
const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let prospect=null;const id=Number(new URLSearchParams(location.search).get('id'));
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',6000)}function buildState(x){return x.concept_state||(x.concept_url?'Built':'Not Built')}function parseResearch(x){try{return x.research_json?JSON.parse(x.research_json):null}catch{return null}}
function researchPanel(x){const r=parseResearch(x),status=x.research_status||'Not Run',running=status==='Researching',facts=(r?.facts||[]).slice(0,8),services=(r?.services||[]).slice(0,8),sources=(r?.sources||[]).slice(0,8);return `<section class="panel"><div class="panel-head"><div class="panel-copy"><strong>Business Research</strong><span>${status==='Complete'?`Completed${x.researched_at?` ${esc(x.researched_at)}`:''}. Source-backed details are available to customize the concept.`:'Search public sources for verified business details and vertical-specific information.'}</span></div><div class="panel-actions"><span class="pill ${status==='Complete'?'green':status==='Failed'?'red':'gray'}">${esc(status)}</span><button class="admin-action" id="researchBusiness" ${running?'disabled':''}>${running?'Researching...':status==='Complete'?'Research Again':'Research Business'}</button></div></div>${x.business_vertical?`<div class="meta"><span class="pill">${esc(x.business_vertical)}</span></div>`:''}${x.research_error?`<div class="build-error"><strong>Research failed.</strong><br>${esc(x.research_error)}</div>`:''}${r?`<div class="research-grid"><div class="research-box"><h4>Summary</h4><div class="research-summary">${esc(r.summary||'No summary returned.')}</div></div><div class="research-box"><h4>Verified Services</h4><div class="research-list">${services.length?services.map(s=>`<div class="research-item">${esc(s.name)} ${s.source_url?`<a href="${esc(s.source_url)}" target="_blank" rel="noreferrer">Source ↗</a>`:''}</div>`).join(''):'<div class="research-item">No explicit services verified.</div>'}</div></div><div class="research-box"><h4>Verified Facts</h4><div class="research-list">${facts.length?facts.map(f=>`<div class="research-item"><strong>${esc(f.label)}:</strong> ${esc(f.value)} ${f.source_url?`<a href="${esc(f.source_url)}" target="_blank" rel="noreferrer">Source ↗</a>`:''}</div>`).join(''):'<div class="research-item">No additional facts verified.</div>'}</div></div><div class="research-box"><h4>Sources</h4><div class="source-list">${sources.length?sources.map(s=>`<a href="${esc(s.url)}" target="_blank" rel="noreferrer">${esc(s.title||'Source')} ↗</a>`).join(''):'No sources stored.'}</div></div></div>`:''}</section>`}
function render(){const x=prospect;if(!x){el('detail').innerHTML='<div class="admin-card"><div class="empty">Prospect not found.</div></div>';return}const state=buildState(x),building=state==='Building',converted=Boolean(x.customer_id);el('detail').innerHTML=`<div class="page"><section class="admin-card hero-card"><div class="summary"><div class="summary-copy"><h2>${esc(x.business_name)}</h2><p>${esc(x.category||'Category not set')} · ${esc([x.city,x.state].filter(Boolean).join(', ')||'Market not set')}</p><div class="meta"><span class="pill ${x.stage==='Won'?'green':x.stage==='Concept Built'?'gold':x.stage==='Lost'?'red':''}">${esc(x.stage||'Qualified')}</span>${x.qualification?`<span class="pill">${esc(x.qualification)}</span>`:''}<span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span>${converted?`<span class="pill green">Customer #${Number(x.customer_id)}</span>`:''}</div></div><div class="summary-actions">${x.concept_url?`<a class="admin-action" style="display:inline-grid;place-items:center" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Concept ↗</a>`:''}<button class="admin-action" id="buildConcept" ${building?'disabled':''}>${building?'Building...':x.concept_url?'Rebuild Concept':'Build Concept'}</button>${converted?'':`<button class="admin-action primary" id="convertCustomer">Convert to Customer</button>`}</div></div></section><div class="workflow-grid">${researchPanel(x)}<div style="display:grid;gap:16px"><section class="panel"><div class="panel-head"><div class="panel-copy"><strong>Concept Site</strong><span>${x.concept_url?'Preview is deployed and ready to review.':'No concept has been built yet.'}</span></div><span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span></div>${x.concept_url?`<div class="preview-url">${esc(x.concept_url)}</div>`:''}${x.concept_build_error?`<div class="build-error">${esc(x.concept_build_error)}</div>`:''}</section><section class="panel"><div class="panel-head"><div class="panel-copy"><strong>Customer Conversion</strong><span>${converted?`Linked to Customer #${Number(x.customer_id)}.`:'Opens the existing CajunSites Stripe checkout. Conversion occurs only after confirmed payment.'}</span></div>${converted?'<span class="pill green">Won</span>':'<span class="pill gray">Prospect</span>'}</div></section></div></div><section class="admin-card section-card"><div class="section-heading"><div><h3>Prospect Record</h3><p>Business details, pipeline status, contact information, and outreach tracking.</p></div></div><div class="form-grid"><div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div><div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div><div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div><div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div><div class="subhead">Contact & Outreach</div><div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div><div class="field"><label>Call Attempts</label><input id="p_calls" type="number" min="0" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div><div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field full"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div><div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="actions"><button class="admin-action danger" id="deleteProspect">Remove Prospect</button><button class="admin-action primary" id="saveProspect">Save Changes</button></div></section></div>`;el('saveProspect').onclick=save;el('deleteProspect').onclick=remove;el('buildConcept').onclick=buildConcept;if(el('convertCustomer'))el('convertCustomer').onclick=convertCustomer;if(el('researchBusiness'))el('researchBusiness').onclick=researchBusiness}
function formData(){return{business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value}}
async function save(silent=false){try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(formData())});if(!silent)notice('Prospect updated.');await load()}catch(e){notice(e.message,true);throw e}}async function researchBusiness(){const b=el('researchBusiness');b.disabled=true;b.textContent='Researching...';try{await save(true);await window.adminApi(`/api/admin/prospects/${id}/research`,{method:'POST',body:'{}'});notice('Business research completed.');await load()}catch(e){notice(e.message,true);await load()}}async function buildConcept(){const b=el('buildConcept');b.disabled=true;b.textContent='Building...';try{await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice(d.research_status==='Complete'?'Research-backed concept built successfully.':'Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank','noopener,noreferrer')}catch(e){notice(e.message,true);await load()}}async function convertCustomer(){const b=el('convertCustomer');b.disabled=true;b.textContent='Preparing Checkout...';try{await save(true);const d=await window.adminApi(`/api/admin/prospects/${id}/convert-checkout`,{method:'POST',body:'{}'});if(d.already_converted){notice(`Already converted to Customer #${d.customer_id}.`);await load();return}if(!d.checkout_url)throw new Error('Checkout link was not returned.');notice('Stripe checkout opened. Conversion will complete automatically after successful payment.');window.open(d.checkout_url,'_blank','noopener,noreferrer');b.disabled=false;b.textContent='Convert to Customer'}catch(e){notice(e.message,true);if(b){b.disabled=false;b.textContent='Convert to Customer'}}}async function remove(){if(!confirm(`Remove ${prospect.business_name} from the prospect pipeline?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});location.href='/admin/prospects/'}catch(e){notice(e.message,true)}}async function load(){if(!id){el('detail').innerHTML='<div class="admin-card"><div class="empty">No prospect was selected.</div></div>';return}try{const d=await window.adminApi('/api/admin/prospects');prospect=(d.prospects||[]).find(x=>Number(x.id)===id)||null;render()}catch(e){el('detail').innerHTML=`<div class="admin-card"><div class="empty">${esc(e.message)}</div></div>`}}window.addEventListener('admin-authenticated',load);load();
</script>
