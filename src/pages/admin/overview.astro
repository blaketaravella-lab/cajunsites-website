---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operations Overview" eyebrow="CajunSites" description="Sales pipeline, customer flow, production workload, billing health, and recent activity." active="overview">
  <div id="loadError" class="load-error"><span>Dashboard data could not be loaded.</span><button id="retry" class="admin-action compact">Retry</button></div>

  <section class="overview-hero">
    <div class="overview-hero-copy"><div class="overview-hero-icon">☀</div><div><h3>Start your day</h3><p>Review what needs attention, then keep the pipeline moving.</p></div></div>
    <div class="overview-actions"><a class="admin-action primary" href="/admin/prospects/">＋ Add Prospect</a><a class="admin-action" href="/admin/build-queue/">Build Queue</a><a class="admin-action" href="/admin/onboarding/">Onboarding</a></div>
  </section>

  <section class="overview-kpis">
    <a class="overview-kpi" href="/admin/prospects/" style="text-decoration:none"><div class="overview-kpi-icon">◎</div><div><strong id="prospects">0</strong><span>Open Prospects</span><small>Qualified through viewed</small></div></a>
    <a class="overview-kpi gold" href="/admin/" style="text-decoration:none"><div class="overview-kpi-icon">◉</div><div><strong id="customers">0</strong><span>Total Customers</span><small>Converted customer records</small></div></a>
    <a class="overview-kpi" href="/admin/build-queue/" style="text-decoration:none"><div class="overview-kpi-icon">◇</div><div><strong id="production">0</strong><span>In Production</span><small>Build through launch</small></div></a>
    <a class="overview-kpi green" href="/admin/billing/" style="text-decoration:none"><div class="overview-kpi-icon">$</div><div><strong id="mrr">$0</strong><span>Synced MRR</span><small>Stripe subscription revenue</small></div></a>
  </section>

  <section class="overview-main">
    <div class="overview-panel">
      <div class="overview-panel-head"><div><h3>Needs Attention</h3><p>Only exceptions and blockers.</p></div><strong id="attentionCount">0</strong></div>
      <div id="attention" class="attention-list"><div class="attention-empty">Loading...</div></div>
    </div>
    <div class="overview-panel">
      <div class="overview-panel-head"><div><h3>Pipeline</h3><p>Prospects by stage.</p></div><a class="admin-action compact" href="/admin/prospects/">View</a></div>
      <div id="pipeline" class="pipeline-list"></div>
    </div>
    <div class="overview-panel">
      <div class="overview-panel-head"><div><h3>Quick Stats</h3><p>Last 30 days.</p></div></div>
      <div class="quick-list"><div class="quick-row"><span>Research Cache Hit Rate</span><strong id="cacheRate">0%</strong></div><div class="quick-row"><span>Google Lookups</span><strong id="googleCalls">0</strong></div><div class="quick-row"><span>AI Operations</span><strong id="openaiCalls">0</strong></div><div class="quick-row"><span>Active Jobs</span><strong id="activeJobs">0</strong></div></div>
    </div>
  </section>

  <section class="overview-bottom">
    <section class="surface"><div class="surface-head"><div><h3>Priority Customer Work</h3><p>Customers that need the next operational action.</p></div><a class="admin-action compact" href="/admin/">View all customers</a></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Next Action</th></tr></thead><tbody id="priority"><tr><td colspan="3" class="empty">Loading...</td></tr></tbody></table></div></section>
    <section class="surface"><div class="surface-head"><div><h3>Recent Activity</h3><p>Latest operational changes.</p></div><a class="admin-action compact" href="/admin/activity/">History</a></div><div id="activity" class="activity-list"><div class="empty">Loading...</div></div></section>
  </section>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=v=>{if(!v)return'';const s=String(v).includes('T')?v:String(v).replace(' ','T')+'Z';const d=new Date(s);return Number.isNaN(d.getTime())?String(v):d.toLocaleString()};
const action=s=>({'Paid - Awaiting Onboarding':'Await onboarding','Onboarding Received':'Review submission','Waiting on Customer':'Follow up','Ready to Build':'Start build','Building':'Continue build','Internal QA':'Complete QA','Customer Review':'Await approval','Revisions':'Complete revisions','Approved for Launch':'Launch site','Launching':'Validate launch','Payment Issue':'Resolve billing issue'}[s]||'Review customer');
const statusClass=s=>s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'?'red':'gray';
function attentionMarkup(d){const items=[];const build=Number(d.prospects?.build_failures||0),research=Number(d.prospects?.research_failures||0),overdue=Number(d.prospects?.overdue_followups||0),billing=Number(d.billing?.unsynced_customers||0),fallbacks=Number(d.prospects?.generic_fallbacks||0);if(build)items.push({bad:true,title:`${build} concept build failure${build===1?'':'s'}`,sub:'Review failed concept builds',href:'/admin/prospects/'});if(research)items.push({bad:true,title:`${research} research failure${research===1?'':'s'}`,sub:'Review source and enrichment failures',href:'/admin/prospects/'});if(overdue)items.push({warn:true,title:`${overdue} overdue follow-up${overdue===1?'':'s'}`,sub:'Sales follow-up is past due',href:'/admin/prospects/'});if(billing)items.push({warn:true,title:`${billing} billing record${billing===1?'':'s'} not synced`,sub:'Open Billing to synchronize Stripe data',href:'/admin/billing/'});if(fallbacks)items.push({warn:true,title:`${fallbacks} generic visual fallback${fallbacks===1?'':'s'}`,sub:'Review concept imagery and design fit',href:'/admin/prospects/'});document.getElementById('attentionCount').textContent=items.length;document.getElementById('attention').innerHTML=items.length?items.slice(0,4).map(x=>`<a class="attention-item ${x.warn?'warn':''}" href="${x.href}" style="text-decoration:none"><span class="attention-dot"></span><div class="attention-copy"><strong>${e(x.title)}</strong><span>${e(x.sub)}</span></div><span>›</span></a>`).join(''):'<div class="attention-empty">Nothing needs attention right now.</div>'}
function pipelineMarkup(d){const s=d.prospects?.stage_counts||{},rows=[['Qualified',s.Qualified||0],['Concept Ready',s['Concept Built']||0],['Contacted',s.Contacted||0],['Viewed',s['Concept Viewed']||0],['Won',s.Won||0]],max=Math.max(1,...rows.map(([,n])=>Number(n)||0));document.getElementById('pipeline').innerHTML=rows.map(([label,count])=>`<div class="pipeline-row"><span>${label}</span><div class="pipeline-track"><div class="pipeline-fill" style="width:${Math.max(count?6:0,(Number(count)||0)/max*100)}%"></div></div><strong>${count}</strong></div>`).join('')}
async function load(){const err=document.getElementById('loadError');err.className='load-error';try{const d=await window.adminApi('/api/admin/dashboard-summary');document.getElementById('prospects').textContent=d.prospects?.open||0;document.getElementById('customers').textContent=d.customers?.total||0;document.getElementById('production').textContent=d.customers?.in_production||0;document.getElementById('mrr').textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:'USD',maximumFractionDigits:0}).format((d.billing?.actual_mrr_cents||0)/100);document.getElementById('cacheRate').textContent=(d.efficiency?.cache_hit_rate||0)+'%';document.getElementById('googleCalls').textContent=d.efficiency?.google_calls_30d||0;document.getElementById('openaiCalls').textContent=d.efficiency?.openai_calls_30d||0;document.getElementById('activeJobs').textContent=(d.jobs?.counts?.Queued||0)+(d.jobs?.counts?.Running||0);attentionMarkup(d);pipelineMarkup(d);const p=d.customers?.priority||[];document.getElementById('priority').innerHTML=p.length?p.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small>${e(x.email)}</small></td><td><span class="pill ${statusClass(x.status)}">${e(x.status)}</span></td><td>${e(action(x.status))}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">No priority customer work right now.</td></tr>';const a=d.activity||[];document.getElementById('activity').innerHTML=a.length?a.slice(0,6).map(x=>`<div class="activity-item"><div class="activity-dot"></div><div><strong>${e(x.description)}</strong><div class="activity-time">${e(fmt(x.created_at))}</div></div></div>`).join(''):'<div class="empty">No recent activity yet.</div>'}catch(ex){err.className='load-error show'}}
window.addEventListener('admin-authenticated',load);document.getElementById('retry').onclick=load;load();
</script>
