---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operations Overview" eyebrow="CajunSites" description="Customer flow, production workload, recurring revenue, and recent activity." active="overview">
  <style>
    .overview-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.55fr);gap:14px}.section-title{display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;border-radius:9px;background:#f1eafa;color:#641bc0;display:grid;place-items:center;font-weight:900}.activity-list{display:grid}.activity-item{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:12px 0;border-bottom:1px solid #eee9f1}.activity-item:last-child{border:0}.activity-dot{width:9px;height:9px;border-radius:50%;background:#7425d0;margin:5px auto}.activity-item strong{font-size:.79rem;line-height:1.4}.activity-time{font-size:.66rem;color:#93879a;margin-top:3px}.priority-email{color:#8d8194}.welcome{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:17px 19px;margin-bottom:14px;background:linear-gradient(135deg,#fff,#faf5ff)}.welcome h3{margin:0}.welcome p{margin:4px 0 0;color:#807489;font-size:.78rem}.quick-actions{display:flex;gap:7px;flex-wrap:wrap}@media(max-width:1000px){.overview-grid{grid-template-columns:1fr}.welcome{display:block}.quick-actions{margin-top:12px}}
  </style>
  <div class="surface welcome"><div><h3>Today at CajunSites</h3><p>Focus on the next customer action, then keep the pipeline moving.</p></div><div class="quick-actions"><a class="admin-action purple" href="/admin/prospects/">◎ Prospect Pipeline</a><a class="admin-action" href="/admin/build-queue/">◇ Build Queue</a><a class="admin-action" href="/admin/onboarding/">✓ Onboarding</a></div></div>
  <div class="stats-grid"><div class="metric"><strong id="total">0</strong><span>Total Customers</span><small>All paid customers</small></div><div class="metric"><strong id="onboarding">0</strong><span>Needs Onboarding Review</span><small>Requires intake action</small></div><div class="metric"><strong id="production">0</strong><span>In Production</span><small>Build through launch</small></div><div class="metric"><strong id="mrr">$0</strong><span>Recurring MRR</span><small>Current monthly base</small></div></div>
  <div class="overview-grid">
    <section class="surface"><div class="surface-head"><div class="section-title"><div class="section-icon">!</div><div><h3>Priority Work</h3><p>Customers that need the next operational action.</p></div></div><a class="admin-action compact" href="/admin/">View Customers</a></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Next Action</th></tr></thead><tbody id="priority"><tr><td colspan="3" class="empty">Loading...</td></tr></tbody></table></div></section>
    <section class="surface"><div class="surface-head"><div class="section-title"><div class="section-icon">◷</div><div><h3>Recent Activity</h3><p>Latest operational changes.</p></div></div><a class="admin-action compact" href="/admin/activity/">History</a></div><div class="surface-body"><div id="activity" class="activity-list"><div class="empty">Loading...</div></div></div></section>
  </div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const action=s=>({'Paid - Awaiting Onboarding':'Await onboarding','Onboarding Received':'Review submission','Waiting on Customer':'Follow up','Ready to Build':'Start build','Building':'Continue build','Internal QA':'Complete QA','Customer Review':'Await approval','Revisions':'Complete revisions','Approved for Launch':'Launch site','Launching':'Validate launch','Payment Issue':'Resolve billing issue'}[s]||'Review customer');const statusClass=s=>s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'?'red':'gray';async function load(){try{const d=await window.adminApi('/api/admin/overview');const c=d.customers||[];document.getElementById('total').textContent=c.length;document.getElementById('onboarding').textContent=c.filter(x=>['Onboarding Received','Waiting on Customer'].includes(x.status)).length;document.getElementById('production').textContent=c.filter(x=>['Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'].includes(x.status)).length;document.getElementById('mrr').textContent='$'+(c.filter(x=>x.status!=='Cancelled').length*49).toLocaleString();const p=c.filter(x=>!['Live','Active Customer','Cancelled'].includes(x.status)).slice(0,8);document.getElementById('priority').innerHTML=p.length?p.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small class="priority-email">${e(x.email)}</small></td><td><span class="pill ${statusClass(x.status)}">${e(x.status)}</span></td><td>${e(action(x.status))}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">No priority work right now.</td></tr>';const a=d.activity||[];document.getElementById('activity').innerHTML=a.length?a.slice(0,8).map(x=>`<div class="activity-item"><div class="activity-dot"></div><div><strong>${e(x.description)}</strong><div class="activity-time">${e(x.created_at)}</div></div></div>`).join(''):'<div class="empty">No recent activity yet.</div>'}catch{}}window.addEventListener('admin-authenticated',load);load();
</script>