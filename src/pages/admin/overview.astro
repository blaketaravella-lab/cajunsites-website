---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operations Overview" eyebrow="CajunSites" description="Sales pipeline, customer flow, production workload, billing health, and recent activity." active="overview">
  <style is:global>
    .overview-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(290px,.55fr);gap:14px}.section-title{display:flex;align-items:center;gap:9px}.section-icon{width:31px;height:31px;border-radius:9px;background:#f1eafa;color:#641bc0;display:grid;place-items:center;font-weight:900}.activity-list{display:grid}.activity-item{display:grid;grid-template-columns:28px 1fr;gap:10px;padding:12px 0;border-bottom:1px solid #eee9f1}.activity-item:last-child{border:0}.activity-dot{width:9px;height:9px;border-radius:50%;background:#7425d0;margin:5px auto}.activity-item strong{font-size:.79rem;line-height:1.4}.activity-time{font-size:.66rem;color:#93879a;margin-top:3px}.priority-email{color:#8d8194}.welcome{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:17px 19px;margin-bottom:14px;background:linear-gradient(135deg,#fff,#faf5ff)}.welcome h3{margin:0}.welcome p{margin:4px 0 0;color:#807489;font-size:.78rem}.quick-actions{display:flex;gap:7px;flex-wrap:wrap}.prospect-alerts{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin:14px 0}.prospect-alert{padding:13px 14px;border:1px solid #e9e2ed;border-radius:12px;background:#fff;text-decoration:none}.prospect-alert strong{display:block;font-size:1.45rem;color:#3b0c67;line-height:1}.prospect-alert span{display:block;font-size:.68rem;color:#766a7d;margin-top:6px;font-weight:800}.prospect-alert.warn strong{color:#9b4d00}.prospect-alert.bad strong{color:#9b2424}.load-error{display:none;padding:12px 14px;border-radius:11px;background:#fdecec;color:#8d2424;margin-bottom:12px}.load-error.show{display:flex;justify-content:space-between;align-items:center;gap:10px}@media(max-width:1000px){.overview-grid{grid-template-columns:1fr}.welcome{display:block}.quick-actions{margin-top:12px}.prospect-alerts{grid-template-columns:repeat(3,1fr)}}@media(max-width:620px){.prospect-alerts{grid-template-columns:1fr 1fr}}
  </style>
  <div class="surface welcome"><div><h3>Today at CajunSites</h3><p>Work the sales exceptions first, then move paid customers to their next milestone.</p></div><div class="quick-actions"><a class="admin-action purple" href="/admin/prospects/">◎ Prospect Pipeline</a><a class="admin-action" href="/admin/build-queue/">◇ Build Queue</a><a class="admin-action" href="/admin/onboarding/">✓ Onboarding</a></div></div>
  <div id="loadError" class="load-error"><span>Dashboard data could not be loaded.</span><button id="retry" class="admin-action compact">Retry</button></div>
  <div class="stats-grid"><div class="metric"><strong id="prospects">0</strong><span>Open Prospects</span><small>Qualified through viewed</small></div><div class="metric"><strong id="customers">0</strong><span>Total Customers</span><small>Paid customer records</small></div><div class="metric"><strong id="production">0</strong><span>In Production</span><small>Build through launch</small></div><div class="metric"><strong id="mrr">$0</strong><span>Active Base MRR</span><small>Modeled at $49 per healthy subscription</small></div></div>
  <div class="prospect-alerts">
    <a class="prospect-alert warn" href="/admin/prospects/"><strong id="overdue">0</strong><span>Overdue Follow-Ups</span></a>
    <a class="prospect-alert bad" href="/admin/prospects/"><strong id="researchFailures">0</strong><span>Research Failures</span></a>
    <a class="prospect-alert bad" href="/admin/prospects/"><strong id="buildFailures">0</strong><span>Build Failures</span></a>
    <a class="prospect-alert warn" href="/admin/prospects/"><strong id="unpaid">0</strong><span>Checkout Started, Unpaid</span></a>
    <a class="prospect-alert warn" href="/admin/prospects/"><strong id="fallbacks">0</strong><span>Generic Visual Fallbacks</span></a>
  </div>
  <div class="overview-grid">
    <section class="surface"><div class="surface-head"><div class="section-title"><div class="section-icon">!</div><div><h3>Priority Customer Work</h3><p>Paid customers that need the next operational action.</p></div></div><a class="admin-action compact" href="/admin/">View Customers</a></div><div style="overflow:auto"><table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Next Action</th></tr></thead><tbody id="priority"><tr><td colspan="3" class="empty">Loading...</td></tr></tbody></table></div></section>
    <section class="surface"><div class="surface-head"><div class="section-title"><div class="section-icon">◷</div><div><h3>Recent Activity</h3><p>Latest operational changes.</p></div></div><a class="admin-action compact" href="/admin/activity/">History</a></div><div class="surface-body"><div id="activity" class="activity-list"><div class="empty">Loading...</div></div></div></section>
  </div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const fmt=v=>{if(!v)return'';const s=String(v).includes('T')?v:String(v).replace(' ','T')+'Z';const d=new Date(s);return Number.isNaN(d.getTime())?String(v):d.toLocaleString()};const action=s=>({'Paid - Awaiting Onboarding':'Await onboarding','Onboarding Received':'Review submission','Waiting on Customer':'Follow up','Ready to Build':'Start build','Building':'Continue build','Internal QA':'Complete QA','Customer Review':'Await approval','Revisions':'Complete revisions','Approved for Launch':'Launch site','Launching':'Validate launch','Payment Issue':'Resolve billing issue'}[s]||'Review customer');const statusClass=s=>s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'?'red':'gray';async function load(){const err=document.getElementById('loadError');err.className='load-error';try{const [d,m]=await Promise.all([window.adminApi('/api/admin/overview'),window.adminApi('/api/admin/metrics')]);const c=d.customers||[],sc=m.prospects?.stage_counts||{};document.getElementById('prospects').textContent=(sc.Qualified||0)+(sc['Concept Built']||0)+(sc.Contacted||0)+(sc['Concept Viewed']||0);document.getElementById('customers').textContent=c.length;document.getElementById('production').textContent=c.filter(x=>['Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'].includes(x.status)).length;document.getElementById('mrr').textContent='$'+((m.customers?.active_mrr_customers||0)*49).toLocaleString();document.getElementById('overdue').textContent=m.prospects?.overdue_followups||0;document.getElementById('researchFailures').textContent=m.prospects?.research_failures||0;document.getElementById('buildFailures').textContent=m.prospects?.build_failures||0;document.getElementById('unpaid').textContent=m.prospects?.checkout_started_unpaid||0;document.getElementById('fallbacks').textContent=m.prospects?.generic_fallbacks||0;const p=c.filter(x=>!['Live','Active Customer','Cancelled'].includes(x.status)).slice(0,8);document.getElementById('priority').innerHTML=p.length?p.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small class="priority-email">${e(x.email)}</small></td><td><span class="pill ${statusClass(x.status)}">${e(x.status)}</span></td><td>${e(action(x.status))}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">No priority customer work right now.</td></tr>';const a=d.activity||[];document.getElementById('activity').innerHTML=a.length?a.slice(0,8).map(x=>`<div class="activity-item"><div class="activity-dot"></div><div><strong>${e(x.description)}</strong><div class="activity-time">${e(fmt(x.created_at))}</div></div></div>`).join(''):'<div class="empty">No recent activity yet.</div>'}catch(ex){err.className='load-error show'}}window.addEventListener('admin-authenticated',load);document.getElementById('retry').onclick=load;load();
</script>