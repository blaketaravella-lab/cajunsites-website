---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operations Overview" eyebrow="CajunSites" description="See customer flow, production workload, recurring revenue, and recent internal activity at a glance." active="overview">
  <style>
    .section-head{padding:18px 18px 14px;border-bottom:1px solid var(--line)}.section-head h3{margin:0}.section-head p{margin:5px 0 0;color:var(--muted);font-size:.84rem}.activity-list{display:grid;gap:0;margin-top:4px}.activity-item{padding:12px 0;border-bottom:1px solid var(--line)}.activity-item:last-child{border-bottom:0}.activity-item strong{font-size:.86rem;line-height:1.45}.activity-time{font-size:.72rem;color:var(--muted);margin-top:4px}.priority-email{color:var(--muted)}@media(max-width:900px){.overview-grid{grid-template-columns:1fr!important}}
  </style>
  <div class="admin-grid" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px">
    <div class="metric"><strong id="total">0</strong><span>Total Customers</span></div>
    <div class="metric"><strong id="onboarding">0</strong><span>Needs Onboarding Review</span></div>
    <div class="metric"><strong id="production">0</strong><span>In Production</span></div>
    <div class="metric"><strong id="mrr">$0</strong><span>Recurring MRR</span></div>
  </div>
  <div class="admin-grid overview-grid" style="grid-template-columns:1.2fr .8fr">
    <div class="admin-card" style="padding:0;overflow:auto">
      <div class="section-head"><h3>Priority Work</h3><p>Customers that need the next operational action.</p></div>
      <table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Next Action</th></tr></thead><tbody id="priority"><tr><td colspan="3" class="empty">Loading...</td></tr></tbody></table>
    </div>
    <div class="admin-card"><h3>Recent Activity</h3><p style="margin:0;color:var(--muted);font-size:.84rem">Latest operational changes across CajunSites.</p><div id="activity" class="activity-list"><div class="empty">Loading...</div></div></div>
  </div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const action=s=>({ 'Paid - Awaiting Onboarding':'Await onboarding','Onboarding Received':'Review submission','Waiting on Customer':'Follow up','Ready to Build':'Start build','Building':'Continue build','Internal QA':'Complete QA','Customer Review':'Await approval','Revisions':'Complete revisions','Approved for Launch':'Launch site','Launching':'Validate launch','Payment Issue':'Resolve billing issue' }[s]||'Review customer');
const statusClass=s=>s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'?'red':'gray';
async function load(){try{const d=await window.adminApi('/api/admin/overview');const c=d.customers||[];document.getElementById('total').textContent=c.length;document.getElementById('onboarding').textContent=c.filter(x=>['Onboarding Received','Waiting on Customer'].includes(x.status)).length;document.getElementById('production').textContent=c.filter(x=>['Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'].includes(x.status)).length;document.getElementById('mrr').textContent='$'+(c.filter(x=>x.status!=='Cancelled').length*49).toLocaleString();const p=c.filter(x=>!['Live','Active Customer','Cancelled'].includes(x.status)).slice(0,8);document.getElementById('priority').innerHTML=p.length?p.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small class="priority-email">${e(x.email)}</small></td><td><span class="pill ${statusClass(x.status)}">${e(x.status)}</span></td><td>${e(action(x.status))}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">No priority work right now.</td></tr>';const a=d.activity||[];document.getElementById('activity').innerHTML=a.length?a.slice(0,8).map(x=>`<div class="activity-item"><strong>${e(x.description)}</strong><div class="activity-time">${e(x.created_at)}</div></div>`).join(''):'<div class="empty">No recent activity yet.</div>'}catch{}}
window.addEventListener('admin-authenticated',load);load();
</script>