---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Operations Overview" eyebrow="CajunSites" description="See customer flow, production workload, recurring revenue, and recent internal activity at a glance." active="overview">
  <div class="admin-grid" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px">
    <div class="metric"><strong id="total">0</strong><span>Total Customers</span></div>
    <div class="metric"><strong id="onboarding">0</strong><span>Needs Onboarding Review</span></div>
    <div class="metric"><strong id="production">0</strong><span>In Production</span></div>
    <div class="metric"><strong id="mrr">$0</strong><span>Recurring MRR</span></div>
  </div>
  <div class="admin-grid" style="grid-template-columns:1.2fr .8fr">
    <div class="admin-card" style="padding:0;overflow:auto">
      <div style="padding:18px"><h3 style="margin:0">Priority Work</h3><p style="margin:5px 0 0">Customers that need the next operational action.</p></div>
      <table class="admin-table"><thead><tr><th>Business</th><th>Status</th><th>Next Action</th></tr></thead><tbody id="priority"><tr><td colspan="3" class="empty">Loading...</td></tr></tbody></table>
    </div>
    <div class="admin-card"><h3>Recent Activity</h3><div id="activity" style="display:grid;gap:12px;margin-top:14px"><div class="empty">Loading...</div></div></div>
  </div>
</AdminShell>
<script is:inline>
const e=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const action=s=>({ 'Paid - Awaiting Onboarding':'Await onboarding','Onboarding Received':'Review submission','Waiting on Customer':'Follow up','Ready to Build':'Start build','Building':'Continue build','Internal QA':'Complete QA','Customer Review':'Await approval','Revisions':'Complete revisions','Approved for Launch':'Launch site','Launching':'Validate launch','Payment Issue':'Resolve billing issue' }[s]||'Review customer');
async function load(){try{const d=await window.adminApi('/api/admin/overview');const c=d.customers||[];document.getElementById('total').textContent=c.length;document.getElementById('onboarding').textContent=c.filter(x=>['Onboarding Received','Waiting on Customer'].includes(x.status)).length;document.getElementById('production').textContent=c.filter(x=>['Ready to Build','Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'].includes(x.status)).length;document.getElementById('mrr').textContent='$'+(c.filter(x=>x.status!=='Cancelled').length*49).toLocaleString();const p=c.filter(x=>!['Live','Active Customer','Cancelled'].includes(x.status)).slice(0,8);document.getElementById('priority').innerHTML=p.length?p.map(x=>`<tr><td><strong>${e(x.business_name||'Unnamed business')}</strong><br><small>${e(x.email)}</small></td><td><span class="pill ${x.status==='Ready to Build'?'green':x.status.includes('Awaiting')?'gold':''}">${e(x.status)}</span></td><td>${e(action(x.status))}</td></tr>`).join(''):'<tr><td colspan="3" class="empty">No priority work right now.</td></tr>';const a=d.activity||[];document.getElementById('activity').innerHTML=a.length?a.slice(0,8).map(x=>`<div style="border-bottom:1px solid var(--line);padding-bottom:10px"><strong style="font-size:.86rem">${e(x.description)}</strong><div style="font-size:.72rem;color:var(--muted);margin-top:3px">${e(x.created_at)}</div></div>`).join(''):'<div class="empty">Activity history will appear after the operations migration is applied.</div>'}catch{}}
window.addEventListener('admin-authenticated',load);load();
</script>