---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Visual Systems" eyebrow="Website Factory" description="The design systems used to turn verified prospect research into distinct website concepts." active="templates">
  <div class="vs-metrics stats-grid">
    <div class="metric"><strong>7</strong><span>Archetypes</span><small>Conversion patterns</small></div>
    <div class="metric"><strong>3</strong><span>Layouts</span><small>Split, full, editorial</small></div>
    <div class="metric"><strong id="assignedCount">0</strong><span>Assigned</span><small>Prospects with a system</small></div>
    <div class="metric"><strong id="fallbackCount">0</strong><span>Fallbacks</span><small>Need design review</small></div>
  </div>

  <section class="surface registry">
    <div class="surface-head"><div><h3>Design Archetypes</h3><p>The concept engine selects an archetype from verified business identity, services, audience, and conversion goal.</p></div><span class="pill purple">visual-family-v7</span></div>
    <div class="archetype-grid">
      <article class="archetype" style="--accent:#b9422e"><span class="archetype-index">01</span><div><h3>Rapid Response Service</h3><p>Urgent, phone-led services where speed and immediate action matter.</p><small>Towing · Roadside · Emergency service</small></div><strong>Call Now</strong></article>
      <article class="archetype" style="--accent:#4e6f45"><span class="archetype-index">02</span><div><h3>Local Service Business</h3><p>Clear services, trust signals, and a direct request path.</p><small>Trades · Repair · Cleaning · Home services</small></div><strong>Request Service</strong></article>
      <article class="archetype" style="--accent:#765b8f"><span class="archetype-index">03</span><div><h3>Appointment Business</h3><p>Experience-forward presentation with an easy booking path.</p><small>Beauty · Wellness · Fitness · Healthcare</small></div><strong>Book or Contact</strong></article>
      <article class="archetype" style="--accent:#c85d2b"><span class="archetype-index">04</span><div><h3>Visit & Experience</h3><p>Reasons to visit, signature offerings, and location context.</p><small>Restaurants · Cafés · Destinations</small></div><strong>Plan Your Visit</strong></article>
      <article class="archetype" style="--accent:#347e91"><span class="archetype-index">05</span><div><h3>Showcase Business</h3><p>Products, work, and visual experience take center stage.</p><small>Retail · Floral · Portfolio businesses</small></div><strong>Explore or Contact</strong></article>
      <article class="archetype" style="--accent:#526477"><span class="archetype-index">06</span><div><h3>Professional & Trust</h3><p>Expertise, credibility, and a confident consultation path.</p><small>Legal · Financial · Consulting · Insurance</small></div><strong>Contact the Office</strong></article>
      <article class="archetype" style="--accent:#39755e"><span class="archetype-index">07</span><div><h3>Family & Community</h3><p>A welcoming structure for programs, trust, and next steps.</p><small>Childcare · Education · Community services</small></div><strong>Contact Us</strong></article>
    </div>
  </section>

  <div class="vs-grid">
    <section class="surface"><div class="surface-head"><div><h3>Layout System</h3><p>Each archetype receives a stable layout variation.</p></div></div><div class="layout-list"><div class="layout-option"><span class="layout-icon split"></span><div><strong>Split</strong><small>Focused copy balanced with representative imagery</small></div></div><div class="layout-option"><span class="layout-icon full"></span><div><strong>Full</strong><small>Immersive image-led presentation</small></div></div><div class="layout-option"><span class="layout-icon editorial"></span><div><strong>Editorial</strong><small>Structured storytelling with strong typography</small></div></div></div></section>
    <section class="surface"><div class="surface-head"><div><h3>Industry Imagery</h3><p>Representative visuals selected from the verified vertical.</p></div></div><div class="motifs"><span>Food</span><span>Vehicle</span><span>Car Wash</span><span>Home Services</span><span>Beauty</span><span>Wellness</span><span>Learning</span><span>Floral</span><span>Fitness</span><span>Pet</span><span>Healthcare</span><span>Retail</span><span>Professional</span></div><p class="registry-note">Generic imagery is a fallback condition and should be reviewed in Design Studio before outreach.</p></section>
  </div>

  <section class="surface assignments">
    <div class="surface-head"><div><h3>Prospect Assignments</h3><p>Current visual system selections from the live prospect records.</p></div><a class="admin-action compact" href="/admin/design-studio/">Open Design Studio</a></div>
    <div class="table-wrap"><table class="admin-table"><thead><tr><th>Prospect</th><th>Visual Family</th><th>Variant</th><th>Version</th><th>Status</th><th></th></tr></thead><tbody id="systemRows"><tr><td colspan="6" class="empty">Loading visual systems...</td></tr></tbody></table></div>
  </section>
</AdminShell>
<style is:global>
.vs-metrics{margin-bottom:14px}.registry{margin-bottom:14px}.archetype-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:16px}.archetype{position:relative;display:grid;grid-template-columns:38px minmax(0,1fr);gap:12px;padding:15px;border:1px solid #e8e3ea;border-left:3px solid var(--accent);border-radius:10px;background:#fff}.archetype:last-child{grid-column:1/-1}.archetype-index{display:grid;place-items:center;width:34px;height:34px;border-radius:9px;background:color-mix(in srgb,var(--accent) 12%,white);color:var(--accent);font-size:.7rem;font-weight:800}.archetype h3{margin:0 0 5px;font-size:.9rem}.archetype p{margin:0;color:#655c69;font-size:.78rem}.archetype small{display:block;margin-top:8px;color:#8a818d;font-size:.69rem}.archetype>strong{grid-column:2;color:var(--accent);font-size:.7rem}.vs-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:14px;margin-bottom:14px}.layout-list{display:grid;padding:8px 16px 16px}.layout-option{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #eeeaf0}.layout-option:first-child{border-top:0}.layout-option strong,.layout-option small{display:block}.layout-option strong{font-size:.82rem}.layout-option small{margin-top:2px;color:#817886;font-size:.7rem}.layout-icon{position:relative;width:46px;height:30px;flex:none;border:1px solid #d9d2dd;border-radius:5px;background:#f8f5fa;overflow:hidden}.layout-icon:before{content:"";position:absolute;background:#51256b}.layout-icon.split:before{inset:0 50% 0 0}.layout-icon.full:before{inset:0}.layout-icon.full:after{content:"";position:absolute;inset:8px;background:rgba(255,255,255,.65);border-radius:2px}.layout-icon.editorial:before{inset:0 38% 0 0}.layout-icon.editorial:after{content:"";position:absolute;right:5px;top:6px;width:12px;height:2px;background:#8f8594;box-shadow:0 5px 0 #8f8594,0 10px 0 #8f8594}.motifs{display:flex;gap:7px;flex-wrap:wrap;padding:16px 16px 8px}.motifs span{padding:6px 9px;border-radius:999px;background:#f2eef4;color:#544b59;font-size:.7rem;font-weight:650}.registry-note{margin:4px 16px 16px;padding:10px 12px;border-radius:8px;background:#fff8df;color:#6d5205;font-size:.72rem}.assignments{margin-bottom:24px}.assignments .surface-head .admin-action{flex:none}.table-wrap{overflow:auto}.family-name{font-weight:650}.family-sub{display:block;margin-top:3px;color:#8a818d;font-size:.68rem}.pill.purple{background:#f0e8f5;color:#51256b}.fallback{color:#8d2525;font-weight:700}
@media(max-width:950px){.vs-grid{grid-template-columns:1fr}.archetype-grid{grid-template-columns:1fr}.archetype:last-child{grid-column:auto}}@media(max-width:620px){.archetype-grid{padding:10px}.archetype{grid-template-columns:34px minmax(0,1fr);padding:12px}.assignments .surface-head .admin-action{width:100%}}
</style>
<script is:inline>
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const label=v=>String(v||'').replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
async function loadSystems(){try{const d=await window.adminApi('/api/admin/prospects?include_converted=1'),all=d.prospects||[],assigned=all.filter(p=>p.visual_family||p.visual_variant||p.concept_url),fallbacks=assigned.filter(p=>Number(p.visual_fallback||0));document.getElementById('assignedCount').textContent=assigned.length;document.getElementById('fallbackCount').textContent=fallbacks.length;document.getElementById('systemRows').innerHTML=assigned.length?assigned.map(p=>`<tr><td><strong>${esc(p.business_name)}</strong><span class="family-sub">${esc([p.city,p.state].filter(Boolean).join(', '))}</span></td><td><span class="family-name">${esc(label(p.visual_family)||'Not classified')}</span></td><td>${esc(label(p.visual_variant)||'Default')}</td><td>${esc(p.visual_version||'Legacy')}</td><td>${p.visual_fallback?'<span class="fallback">Fallback review</span>':'<span class="pill green">Assigned</span>'}</td><td><a class="admin-action compact" href="/admin/prospect/?id=${p.id}">View</a></td></tr>`).join(''):'<tr><td colspan="6" class="empty">No visual systems have been assigned yet. Build a prospect concept to create the first assignment.</td></tr>'}catch(err){document.getElementById('systemRows').innerHTML=`<tr><td colspan="6" class="empty">${esc(err.message)}</td></tr>`}}
window.addEventListener('admin-authenticated',loadSystems);loadSystems();
</script>