---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospects" eyebrow="Sales Pipeline" description="Research prospects, build concepts, track outreach, and convert wins." active="prospects">
  <button slot="actions" class="admin-action primary" id="addBtn" type="button">＋ Add Prospect</button>
  <style>
    .notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.pipeline-summary{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-bottom:14px}.focus-card{padding:18px 19px;background:linear-gradient(135deg,#3c0868,#6519b3);color:#fff;border:0}.focus-card h3{color:#fff;margin:0}.focus-card p{margin:5px 0 0;color:#ddcfea;font-size:.78rem}.focus-stats{display:flex;gap:20px;margin-top:17px}.focus-stats strong{display:block;font-size:1.6rem}.focus-stats span{font-size:.66rem;color:#d9cce5}.toolbar{display:grid;grid-template-columns:1fr 190px 160px;gap:9px;margin-bottom:14px}.toolbar input,.toolbar select{min-height:40px;padding:0 11px}.wrap{overflow:auto}.subtle{font-size:.72rem;color:#8a7e90}.row-actions{display:flex;gap:6px;flex-wrap:wrap}.concept-status{display:grid;gap:5px;justify-items:start}.stage-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#7624d1;margin-right:5px}@media(max-width:1000px){.pipeline-summary{grid-template-columns:1fr}.toolbar{grid-template-columns:1fr}}@media(max-width:620px){.focus-stats{justify-content:space-between;gap:8px}.row-actions{min-width:170px}}
  </style>
  <div class="notice" id="notice"></div>
  <div class="pipeline-summary"><section class="surface focus-card"><h3>Prospect Pipeline</h3><p>Build a strong concept before outreach, then move qualified prospects toward payment.</p><div class="focus-stats"><div><strong id="total">0</strong><span>Total Prospects</span></div><div><strong id="built">0</strong><span>Concepts Built</span></div><div><strong id="won">0</strong><span>Won</span></div></div></section><div class="stats-grid" style="grid-template-columns:1fr 1fr;margin:0"><div class="metric"><strong id="contacted">0</strong><span>Contacted / Viewed</span><small>Active outreach</small></div><div class="metric"><strong id="needsConcept">0</strong><span>Need Concept</span><small>Qualified, not built</small></div></div></div>
  <div class="toolbar-card toolbar"><input id="search" type="search" placeholder="Search business, category, city..."/><select id="stage"><option value="">All Stages</option><option>Qualified</option><option>Concept Built</option><option>Contacted</option><option>Concept Viewed</option><option>Won</option><option>Lost</option></select><select id="sort"><option value="newest">Newest First</option><option value="business">Business A-Z</option><option value="followup">Follow-Up</option></select></div>
  <section class="surface"><div class="surface-head"><div><h3>Opportunities</h3><p>Use View for the full research, concept, and conversion workspace.</p></div></div><div class="wrap"><table class="admin-table"><thead><tr><th>Business</th><th>Market</th><th>Stage</th><th>Concept</th><th>Outreach</th><th>Follow-Up</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div></section>
</AdminShell>
<script is:inline>
let prospects=[];const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',5000)}function pill(s){return `<span class="pill ${s==='Won'?'green':s==='Concept Built'?'gold':s==='Lost'?'red':''}"><span class="stage-dot"></span>${esc(s||'Qualified')}</span>`}function conceptPill(state){return `<span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span>`}function metrics(){el('total').textContent=prospects.length;el('built').textContent=prospects.filter(x=>x.concept_state==='Built'||x.concept_url).length;el('contacted').textContent=prospects.filter(x=>['Contacted','Concept Viewed'].includes(x.stage)).length;el('won').textContent=prospects.filter(x=>x.stage==='Won').length;el('needsConcept').textContent=prospects.filter(x=>!x.concept_url&&x.stage==='Qualified').length}function filtered(){const q=el('search').value.trim().toLowerCase(),stage=el('stage').value,sort=el('sort').value;const a=prospects.filter(x=>(!q||`${x.business_name||''} ${x.category||''} ${x.city||''}`.toLowerCase().includes(q))&&(!stage||x.stage===stage));a.sort((a,b)=>sort==='business'?String(a.business_name).localeCompare(String(b.business_name)):sort==='followup'?String(a.next_follow_up||'9999').localeCompare(String(b.next_follow_up||'9999')):b.id-a.id);return a}function renderRows(){const a=filtered();el('rows').innerHTML=a.length?a.map(x=>{const state=x.concept_state||(x.concept_url?'Built':'Not Built'),building=state==='Building';return `<tr><td><strong>${esc(x.business_name)}</strong><br><span class="subtle">${esc(x.category||'Not set')}</span></td><td>${esc([x.city,x.state].filter(Boolean).join(', ')||'Not set')}</td><td>${pill(x.stage)}</td><td><div class="concept-status">${conceptPill(state)}${x.concept_url?`<a class="subtle" href="${esc(x.concept_url)}" target="_blank">Open preview ↗</a>`:''}</div></td><td>${Number(x.call_attempts||0)} call${Number(x.call_attempts||0)===1?'':'s'}<br><span class="subtle">${x.decision_maker_reached?'Decision maker reached':x.concept_viewed?'Concept viewed':'Not reached'}</span></td><td>${esc(x.next_follow_up||'Not scheduled')}</td><td><div class="row-actions"><a class="admin-action compact" href="/admin/prospect/?id=${x.id}">View</a>${!x.concept_url?`<button class="admin-action purple compact build" data-id="${x.id}" ${building?'disabled':''}>${building?'Building...':'Build Concept'}</button>`:''}</div></td></tr>`}).join(''):'<tr><td colspan="7" class="empty">No prospects match your filters.</td></tr>';document.querySelectorAll('.build').forEach(b=>b.onclick=()=>buildConcept(Number(b.dataset.id),b))}async function buildConcept(id,button){button.disabled=true;button.textContent='Building...';try{const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank')}catch(e){notice(e.message,true);await load()}}async function add(){const business=prompt('Business name');if(!business)return;try{const d=await window.adminApi('/api/admin/prospects',{method:'POST',body:JSON.stringify({business_name:business,stage:'Qualified'})});location.href=`/admin/prospect/?id=${d.id}`}catch(e){notice(e.message,true)}}async function load(){try{const d=await window.adminApi('/api/admin/prospects');prospects=d.prospects||[];metrics();renderRows()}catch(e){el('rows').innerHTML=`<tr><td colspan="7" class="empty">${esc(e.message)}</td></tr>`}}window.addEventListener('admin-authenticated',load);el('addBtn').onclick=add;['search','stage','sort'].forEach(id=>el(id).addEventListener(id==='search'?'input':'change',renderRows));load();
</script>