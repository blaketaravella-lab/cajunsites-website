---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospects" eyebrow="Sales Pipeline" description="Track concept sites, outreach, follow-up, and conversion before a prospect becomes a paying CajunSites customer." active="prospects">
  <button slot="actions" class="admin-action primary" id="addBtn" type="button">Add Prospect</button>
  <style>
    .toolbar{display:grid;grid-template-columns:1fr 220px 180px;gap:10px;margin-bottom:14px}.toolbar input,.toolbar select{min-height:42px;padding:0 12px}.wrap{overflow:auto}.subtle{font-size:.76rem;color:#786c80}.notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.row-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}.concept-status{display:grid;gap:6px;justify-items:start}.preview{display:inline-grid;place-items:center}.admin-action[disabled]{opacity:.55;cursor:not-allowed}@media(max-width:900px){.toolbar{grid-template-columns:1fr}.wrap{border-radius:16px}}@media(max-width:620px){.toolbar{gap:8px}.row-actions{min-width:180px}}
  </style>
  <div class="notice" id="notice"></div>
  <div class="admin-grid" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px">
    <div class="metric"><strong id="total">0</strong><span>Total Prospects</span></div>
    <div class="metric"><strong id="built">0</strong><span>Concepts Built</span></div>
    <div class="metric"><strong id="contacted">0</strong><span>Contacted / Viewed</span></div>
    <div class="metric"><strong id="won">0</strong><span>Won</span></div>
  </div>
  <div class="toolbar">
    <input id="search" type="search" placeholder="Search business, category, city..." />
    <select id="stage"><option value="">All Stages</option><option>Qualified</option><option>Concept Built</option><option>Contacted</option><option>Concept Viewed</option><option>Won</option><option>Lost</option></select>
    <select id="sort"><option value="newest">Newest First</option><option value="business">Business A-Z</option><option value="followup">Follow-Up</option></select>
  </div>
  <div class="admin-card wrap" style="padding:0"><table class="admin-table"><thead><tr><th>Business</th><th>Category / Market</th><th>Stage</th><th>Concept</th><th>Outreach</th><th>Next Follow-Up</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div>
</AdminShell>
<script is:inline>
let prospects=[];const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',5000)}
function pill(s){return `<span class="pill ${s==='Won'?'green':s==='Concept Built'?'gold':s==='Lost'?'red':''}">${esc(s||'Qualified')}</span>`}
function conceptPill(state){return `<span class="pill ${state==='Built'?'green':state==='Build Failed'?'red':'gray'}">${esc(state)}</span>`}
function metrics(){el('total').textContent=prospects.length;el('built').textContent=prospects.filter(x=>(x.concept_state==='Built')||!!x.concept_url).length;el('contacted').textContent=prospects.filter(x=>['Contacted','Concept Viewed'].includes(x.stage)).length;el('won').textContent=prospects.filter(x=>x.stage==='Won').length}
function filtered(){const q=el('search').value.trim().toLowerCase(),stage=el('stage').value,sort=el('sort').value;const a=prospects.filter(x=>(!q||`${x.business_name||''} ${x.category||''} ${x.city||''}`.toLowerCase().includes(q))&&(!stage||x.stage===stage));a.sort((a,b)=>sort==='business'?String(a.business_name).localeCompare(String(b.business_name)):sort==='followup'?String(a.next_follow_up||'9999').localeCompare(String(b.next_follow_up||'9999')):b.id-a.id);return a}
function conceptCell(x){const state=x.concept_state||(x.concept_url?'Built':'Not Built');if(x.concept_url)return `<div class="concept-status"><a class="admin-action compact preview" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Preview</a>${conceptPill(state)}</div>`;return conceptPill(state)}
function renderRows(){const a=filtered();el('rows').innerHTML=a.length?a.map(x=>{const state=x.concept_state||(x.concept_url?'Built':'Not Built');const building=state==='Building';return `<tr><td><strong>${esc(x.business_name)}</strong></td><td>${esc(x.category||'Not set')}<br><span class="subtle">${esc([x.city,x.state].filter(Boolean).join(', '))}</span></td><td>${pill(x.stage)}</td><td>${conceptCell(x)}</td><td>${Number(x.call_attempts||0)} call${Number(x.call_attempts||0)===1?'':'s'}<br><span class="subtle">${x.decision_maker_reached?'Decision maker reached':x.concept_viewed?'Concept viewed':'Not reached'}</span></td><td>${esc(x.next_follow_up||'Not scheduled')}</td><td><div class="row-actions"><a class="admin-action compact" style="display:inline-grid;place-items:center" href="/admin/prospect/?id=${x.id}">View</a>${!x.concept_url?`<button class="admin-action primary compact build" data-id="${x.id}" ${building?'disabled':''}>${building?'Building...':'Build Concept'}</button>`:''}</div></td></tr>`}).join(''):'<tr><td colspan="7" class="empty">No prospects match your filters.</td></tr>';document.querySelectorAll('.build').forEach(b=>b.onclick=()=>buildConcept(Number(b.dataset.id),b))}
async function buildConcept(id,button){button.disabled=true;button.textContent='Building...';try{const d=await window.adminApi(`/api/admin/prospects/${id}/build-concept`,{method:'POST',body:'{}'});notice('Concept site built successfully.');await load();if(d.concept_url)window.open(d.concept_url,'_blank','noopener,noreferrer')}catch(e){notice(e.message,true);await load()}}
async function add(){const business=prompt('Business name');if(!business)return;try{const d=await window.adminApi('/api/admin/prospects',{method:'POST',body:JSON.stringify({business_name:business,stage:'Qualified'})});notice('Prospect added.');location.href=`/admin/prospect/?id=${d.id}`}catch(e){notice(e.message,true)}}
async function load(){try{const d=await window.adminApi('/api/admin/prospects');prospects=d.prospects||[];metrics();renderRows()}catch(e){el('rows').innerHTML=`<tr><td colspan="7" class="empty">${esc(e.message)}</td></tr>`}}
window.addEventListener('admin-authenticated',load);el('addBtn').onclick=add;['search','stage','sort'].forEach(id=>el(id).addEventListener(id==='search'?'input':'change',renderRows));load();
</script>
