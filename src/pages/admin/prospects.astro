---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Prospects" eyebrow="Sales Pipeline" description="Track concept sites, outreach, follow-up, and conversion before a prospect becomes a paying CajunSites customer." active="prospects">
  <button slot="actions" class="admin-action primary" id="addBtn" type="button">Add Prospect</button>
  <style>
    .toolbar{display:grid;grid-template-columns:1fr 220px 180px;gap:10px;margin-bottom:14px}.toolbar input,.toolbar select{min-height:42px}.wrap{overflow:auto}.subtle{font-size:.76rem;color:#786c80}.concept{font-weight:800;color:var(--purple-800);text-decoration:none}.detail{margin-top:14px}.form-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.field{display:grid;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:.74rem;font-weight:800;color:#5f5366}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:9px;padding:10px;background:white}.field textarea{min-height:90px;resize:vertical}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.danger{color:#8d2424}.notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}@media(max-width:900px){.toolbar,.form-grid{grid-template-columns:1fr}}
  </style>
  <div class="notice" id="notice"></div>
  <div class="admin-grid" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:14px">
    <div class="metric"><strong id="total">0</strong><span>Total Prospects</span></div>
    <div class="metric"><strong id="built">0</strong><span>Concepts Built</span></div>
    <div class="metric"><strong id="contacted">0</strong><span>Contacted / Viewed</span></div>
    <div class="metric"><strong id="won">0</strong><span>Won</span></div>
  </div>
  <div class="toolbar">
    <input id="search" type="search" placeholder="Search business, category, city..." />
    <select id="stage"><option value="">All Stages</option><option>Qualified</option><option>Concept Built</option><option>Contacted</option><option>Concept Viewed</option><option>Won</option><option>Lost</option></select>
    <select id="sort"><option value="newest">Newest First</option><option value="business">Business A-Z</option><option value="followup">Follow-Up</option></select>
  </div>
  <div class="admin-card wrap" style="padding:0"><table class="admin-table"><thead><tr><th>Business</th><th>Category / Market</th><th>Stage</th><th>Concept</th><th>Outreach</th><th>Next Follow-Up</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card detail" id="detail"><div class="empty">Select a prospect to review or edit details.</div></div>
</AdminShell>
<script is:inline>
let prospects=[];let selected=null;const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',4000)}
function pill(s){return `<span class="pill ${s==='Won'?'green':s==='Concept Built'?'gold':''}">${esc(s||'Qualified')}</span>`}
function metrics(){el('total').textContent=prospects.length;el('built').textContent=prospects.filter(x=>['Concept Built','Contacted','Concept Viewed','Won'].includes(x.stage)).length;el('contacted').textContent=prospects.filter(x=>['Contacted','Concept Viewed'].includes(x.stage)).length;el('won').textContent=prospects.filter(x=>x.stage==='Won').length}
function filtered(){const q=el('search').value.trim().toLowerCase(),stage=el('stage').value,sort=el('sort').value;const a=prospects.filter(x=>(!q||`${x.business_name||''} ${x.category||''} ${x.city||''}`.toLowerCase().includes(q))&&(!stage||x.stage===stage));a.sort((a,b)=>sort==='business'?String(a.business_name).localeCompare(String(b.business_name)):sort==='followup'?String(a.next_follow_up||'9999').localeCompare(String(b.next_follow_up||'9999')):b.id-a.id);return a}
function renderRows(){const a=filtered();el('rows').innerHTML=a.length?a.map(x=>`<tr><td><strong>${esc(x.business_name)}</strong><br><span class="subtle">${esc(x.qualification||'')}</span></td><td>${esc(x.category||'Not set')}<br><span class="subtle">${esc([x.city,x.state].filter(Boolean).join(', '))}</span></td><td>${pill(x.stage)}</td><td>${x.concept_url?`<a class="concept" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Preview</a>`:'<span class="subtle">URL not recorded</span>'}</td><td>${Number(x.call_attempts||0)} call${Number(x.call_attempts||0)===1?'':'s'}<br><span class="subtle">${x.decision_maker_reached?'Decision maker reached':x.concept_viewed?'Concept viewed':'Not reached'}</span></td><td>${esc(x.next_follow_up||'Not scheduled')}</td><td><button class="admin-action view" data-id="${x.id}">View</button></td></tr>`).join(''):'<tr><td colspan="7" class="empty">No prospects match your filters.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id)))}
function show(id){const x=prospects.find(p=>p.id===id);if(!x)return;selected=id;el('detail').innerHTML=`<h2 style="margin-top:0;color:var(--purple-950)">${esc(x.business_name)}</h2><div class="form-grid">
<div class="field"><label>Business Name</label><input id="p_business" value="${esc(x.business_name)}"></div>
<div class="field"><label>Category</label><input id="p_category" value="${esc(x.category||'')}"></div>
<div class="field"><label>Stage</label><select id="p_stage">${['Qualified','Concept Built','Contacted','Concept Viewed','Won','Lost'].map(s=>`<option ${x.stage===s?'selected':''}>${s}</option>`).join('')}</select></div>
<div class="field"><label>City</label><input id="p_city" value="${esc(x.city||'')}"></div><div class="field"><label>State</label><input id="p_state" value="${esc(x.state||'')}"></div><div class="field"><label>Qualification</label><input id="p_qualification" value="${esc(x.qualification||'')}"></div>
<div class="field full"><label>Concept URL</label><input id="p_url" value="${esc(x.concept_url||'')}"></div>
<div class="field"><label>Contact Name</label><input id="p_contact" value="${esc(x.contact_name||'')}"></div><div class="field"><label>Phone</label><input id="p_phone" value="${esc(x.phone||'')}"></div><div class="field"><label>Email</label><input id="p_email" value="${esc(x.email||'')}"></div>
<div class="field"><label>Call Attempts</label><input id="p_calls" type="number" min="0" value="${Number(x.call_attempts||0)}"></div><div class="field"><label>Decision Maker Reached</label><select id="p_reached"><option value="0" ${!x.decision_maker_reached?'selected':''}>No</option><option value="1" ${x.decision_maker_reached?'selected':''}>Yes</option></select></div><div class="field"><label>Concept Viewed</label><select id="p_viewed"><option value="0" ${!x.concept_viewed?'selected':''}>No</option><option value="1" ${x.concept_viewed?'selected':''}>Yes</option></select></div>
<div class="field"><label>Next Follow-Up</label><input id="p_followup" type="date" value="${esc(x.next_follow_up||'')}"></div><div class="field"><label>Outcome</label><input id="p_outcome" value="${esc(x.outcome||'')}"></div><div class="field"><label>Website Gate</label><input id="p_gate" value="${esc(x.website_gate||'')}"></div>
<div class="field full"><label>Notes</label><textarea id="p_notes">${esc(x.notes||'')}</textarea></div></div><div class="actions"><button class="admin-action primary" id="saveProspect">Save Changes</button>${x.concept_url?`<a class="admin-action" style="display:inline-grid;place-items:center;text-decoration:none" href="${esc(x.concept_url)}" target="_blank" rel="noreferrer">Open Concept</a>`:''}<button class="admin-action danger" id="deleteProspect">Remove Prospect</button></div>`;el('saveProspect').onclick=()=>save(x.id);el('deleteProspect').onclick=()=>remove(x.id,x.business_name)}
async function save(id){const data={business_name:el('p_business').value,category:el('p_category').value,stage:el('p_stage').value,city:el('p_city').value,state:el('p_state').value,qualification:el('p_qualification').value,concept_url:el('p_url').value,contact_name:el('p_contact').value,phone:el('p_phone').value,email:el('p_email').value,call_attempts:Number(el('p_calls').value||0),decision_maker_reached:el('p_reached').value==='1',concept_viewed:el('p_viewed').value==='1',next_follow_up:el('p_followup').value,outcome:el('p_outcome').value,website_gate:el('p_gate').value,notes:el('p_notes').value};try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'PATCH',body:JSON.stringify(data)});notice('Prospect updated.');await load();show(id)}catch(e){notice(e.message,true)}}
async function remove(id,name){if(!confirm(`Remove ${name} from the prospect pipeline?`))return;try{await window.adminApi(`/api/admin/prospects/${id}`,{method:'DELETE'});selected=null;notice('Prospect removed.');await load();el('detail').innerHTML='<div class="empty">Select a prospect to review or edit details.</div>'}catch(e){notice(e.message,true)}}
async function add(){const business=prompt('Business name');if(!business)return;try{await window.adminApi('/api/admin/prospects',{method:'POST',body:JSON.stringify({business_name:business,stage:'Qualified'})});notice('Prospect added.');await load()}catch(e){notice(e.message,true)}}
async function load(){try{const d=await window.adminApi('/api/admin/prospects');prospects=d.prospects||[];metrics();renderRows();if(selected)show(selected)}catch(e){el('rows').innerHTML=`<tr><td colspan="7" class="empty">${esc(e.message)}</td></tr>`}}
window.addEventListener('admin-authenticated',load);el('addBtn').onclick=add;['search','stage','sort'].forEach(id=>el(id).addEventListener(id==='search'?'input':'change',renderRows));load();
</script>
