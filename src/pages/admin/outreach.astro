---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Outreach" eyebrow="Sales Workspace" description="Call qualified prospects, send reviewed concepts, and track every result." active="outreach">
  <div class="outreach-shell">
    <section class="stats-grid outreach-stats">
      <div class="metric"><strong id="due">0</strong><span>Due Today</span><small>Scheduled follow-ups</small></div>
      <div class="metric"><strong id="ready">0</strong><span>Ready to Call</span><small>Concept published</small></div>
      <div class="metric"><strong id="calls">0</strong><span>Calls Logged</span><small>All recorded attempts</small></div>
      <div class="metric"><strong id="engaged">0</strong><span>Engaged</span><small>Viewed or interested</small></div>
    </section>
    <section class="surface outreach-toolbar"><input id="search" type="search" placeholder="Search business, category, city, or contact" aria-label="Search outreach queue"/><select id="filter" aria-label="Filter outreach queue"><option value="active">Active Queue</option><option value="ready">Ready to Call</option><option value="due">Follow-Ups Due</option><option value="attempted">Attempted, Not Reached</option><option value="reached">Decision Maker Reached</option><option value="engaged">Concept Viewed / Interested</option><option value="closed">Closed</option><option value="dnc">Do Not Contact</option><option value="all">All Prospects</option></select></section>
    <div class="outreach-layout">
      <section class="surface queue-card"><div class="surface-head"><div><h3>Call Queue</h3><p id="queueCount">Loading prospects...</p></div></div><div id="queue" class="queue"><div class="empty">Loading...</div></div></section>
      <aside class="surface workspace" id="workspace"><div class="empty workspace-empty"><strong>Select a prospect</strong><p>Choose a business from the queue to open its calling workspace.</p></div></aside>
    </div>
    <section class="surface activity-card"><div class="surface-head"><div><h3>Recent Outreach</h3><p>Calls and concept emails recorded by the team.</p></div></div><div id="activity" class="timeline"><div class="empty">No outreach recorded yet.</div></div></section>
  </div>
</AdminShell>
<style is:global>
.outreach-shell{display:grid;gap:14px}.outreach-stats{margin:0}.outreach-toolbar{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:10px;padding:14px}.outreach-toolbar input,.outreach-toolbar select{width:100%;min-height:44px;border:1px solid #ded9e1;border-radius:8px;background:#fff;padding:0 12px}.outreach-layout{display:grid;grid-template-columns:minmax(380px,.9fr) minmax(440px,1.1fr);gap:14px;align-items:start}.queue-card,.workspace,.activity-card{padding:18px}.surface-head p{margin:3px 0 0;color:#827987;font-size:.82rem}.queue{display:grid;gap:8px;margin-top:14px}.queue-item{width:100%;border:1px solid #e8e3ea;background:#fff;border-radius:10px;padding:13px;text-align:left;cursor:pointer;display:grid;gap:8px;color:#28222c}.queue-item:hover,.queue-item.active{border-color:#6b388c;background:#fbf8fd;box-shadow:0 0 0 1px #6b388c}.queue-top,.queue-meta,.queue-flags{display:flex;justify-content:space-between;align-items:center;gap:10px}.queue-name{font-size:.92rem;font-weight:750;line-height:1.3}.queue-meta{justify-content:flex-start;color:#746c78;font-size:.77rem;flex-wrap:wrap}.queue-flags{justify-content:flex-start;flex-wrap:wrap}.tag{display:inline-flex;padding:4px 7px;border-radius:999px;background:#f1edf3;color:#5a5060;font-size:.68rem;font-weight:650}.tag.gold{background:#fff3c5;color:#705100}.tag.green{background:#e4f6ea;color:#176136}.tag.red{background:#fde8e8;color:#8d2525}.workspace{position:sticky;top:72px;min-height:420px}.workspace-empty{padding:100px 20px}.workspace-empty strong{font-size:1.05rem}.workspace-empty p{color:#827987}.work-head{display:flex;justify-content:space-between;gap:18px}.work-head h2{margin:0 0 5px;font-size:1.65rem;line-height:1.15;letter-spacing:-.025em}.work-head p{margin:0;color:#776f7b;font-size:.82rem}.workspace-status{align-self:flex-start;flex:0 0 auto;min-height:28px;padding:5px 10px;border:1px solid #d9c9e2;background:#f6f0f9;color:#51256b;font-size:.72rem;font-weight:750;line-height:1;white-space:nowrap;box-shadow:0 1px 2px rgba(41,16,60,.05)}.workspace-status.green{border-color:#b9dfc6;background:#eaf7ee;color:#176136}.workspace-status.red{border-color:#efc2c2;background:#fdf0f0;color:#8d2525}.work-actions{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}.work-actions a,.work-actions button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border:1px solid #dcd6df;background:#fff;border-radius:8px;padding:0 12px;color:#362b3c;text-decoration:none;font-weight:650;cursor:pointer}.work-actions .primary{background:#f0b719;border-color:#d39a08;color:#24122f}.contact-form{border:1px solid #e5dfe8;border-radius:10px;background:#faf9fb;padding:14px;margin:14px 0;display:grid;gap:11px}.contact-form-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.contact-form-head h3{margin:0;font-size:.96rem}.contact-form-head small{color:#827987;font-size:.72rem}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.contact-grid .field:last-child{grid-column:1/-1}.contact-save{justify-self:start;min-height:38px;border:1px solid #51256b;border-radius:8px;background:#fff;color:#51256b;padding:0 13px;font-weight:700;cursor:pointer}.contact-save:hover{background:#f7f1fa}.contact-save:disabled{opacity:.55;cursor:wait}.work-actions button:disabled{opacity:.45;cursor:not-allowed}.script{background:#29103c;color:#fff;border-radius:11px;padding:17px;margin:14px 0}.script small{display:block;text-transform:uppercase;letter-spacing:.1em;color:#e7c75d;font-weight:750;margin-bottom:8px}.script p{margin:0;font-size:.94rem;line-height:1.7}.work-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}.detail{border:1px solid #e8e3ea;border-radius:8px;padding:10px}.detail span{display:block;font-size:.67rem;color:#867d89;text-transform:uppercase;letter-spacing:.05em}.detail strong{display:block;margin-top:4px;font-size:.86rem;line-height:1.35;overflow-wrap:anywhere}.form{border-top:1px solid #ebe6ed;margin-top:17px;padding-top:17px;display:grid;gap:11px}.form h3{margin:0}.field{display:grid;gap:5px}.field label{font-size:.74rem;font-weight:650;color:#615768}.field input,.field select,.field textarea{width:100%;border:1px solid #dcd6df;border-radius:8px;padding:10px;background:#fff;font:inherit;color:#28222c}.field input:focus,.field select:focus,.field textarea:focus,.outreach-toolbar input:focus,.outreach-toolbar select:focus{outline:3px solid rgba(81,37,107,.13);border-color:#6b388c}.field textarea{min-height:78px;resize:vertical}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.submit{min-height:44px;border:1px solid #51256b;border-radius:8px;background:#51256b;color:#fff;font-weight:700;cursor:pointer}.email-box{background:#faf8fb;border:1px solid #e4dee7;border-radius:10px;padding:14px;margin-top:14px;display:none}.email-box.open{display:grid;gap:10px}.email-box textarea{min-height:220px}.email-note{font-size:.72rem;color:#786f7c;margin:0}.timeline{display:grid;margin-top:12px}.event{display:grid;grid-template-columns:120px 1fr auto;gap:12px;padding:11px 0;border-top:1px solid #ede8ef;align-items:start}.event:first-child{border-top:0}.event-channel{font-size:.73rem;font-weight:700;text-transform:uppercase;color:#6a3b83}.event-main strong{display:block;font-size:.86rem}.event-main span,.event time{font-size:.73rem;color:#827987}.notice{padding:10px 12px;border-radius:8px;background:#e8f6ec;color:#1d6539;font-size:.8rem}.notice.error{background:#fde9e9;color:#8e2626}.empty{text-align:center;color:#827987}.activity-card{margin-bottom:24px}
@media(max-width:1050px){.outreach-layout{grid-template-columns:1fr}.workspace{position:static}.workspace-empty{padding:50px 20px}}@media(max-width:700px){.outreach-toolbar,.form-row,.work-grid,.contact-grid{grid-template-columns:1fr}.contact-grid .field:last-child{grid-column:auto}.queue-card,.workspace,.activity-card{padding:13px}.event{grid-template-columns:82px 1fr}.event time{grid-column:2}.work-head{display:grid}.work-actions>*{flex:1}.outreach-layout{display:flex;flex-direction:column}.queue-card,.workspace{width:100%}}
</style>
<script is:inline>
const el=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let outreachData={prospects:[],events:[],call_results:[]},selectedId=null;
const today=()=>new Date().toISOString().slice(0,10),formatDate=v=>v?new Date(v).toLocaleString([],v.length<=10?{dateStyle:'medium'}:{dateStyle:'medium',timeStyle:'short'}):'Not set';
function active(p){return !p.customer_id&&!p.do_not_contact&&!['Won','Lost'].includes(p.stage)}
function filtered(){const q=el('search').value.trim().toLowerCase(),f=el('filter').value;return outreachData.prospects.filter(p=>{const match=!q||[p.business_name,p.category,p.city,p.contact_name,p.phone,p.email].some(v=>String(v||'').toLowerCase().includes(q));if(!match)return false;if(f==='active')return active(p);if(f==='ready')return active(p)&&p.concept_url&&!p.call_attempts;if(f==='due')return active(p)&&p.next_follow_up&&p.next_follow_up<=today();if(f==='attempted')return active(p)&&p.call_attempts&&!p.decision_maker_reached;if(f==='reached')return active(p)&&p.decision_maker_reached;if(f==='engaged')return active(p)&&(p.concept_viewed||['Interested','Demonstration Scheduled'].includes(p.last_call_result));if(f==='closed')return ['Won','Lost'].includes(p.stage);if(f==='dnc')return !!p.do_not_contact;return true})}
function renderStats(){const ps=outreachData.prospects;el('due').textContent=ps.filter(p=>active(p)&&p.next_follow_up&&p.next_follow_up<=today()).length;el('ready').textContent=ps.filter(p=>active(p)&&p.concept_url&&!p.call_attempts).length;el('calls').textContent=ps.reduce((n,p)=>n+Number(p.call_attempts||0),0);el('engaged').textContent=ps.filter(p=>p.concept_viewed||['Interested','Demonstration Scheduled','Won'].includes(p.last_call_result)).length}
function renderQueue(){const ps=filtered();el('queueCount').textContent=`${ps.length} prospect${ps.length===1?'':'s'} in this view`;el('queue').innerHTML=ps.length?ps.map(p=>`<button class="queue-item ${Number(p.id)===selectedId?'active':''}" data-id="${p.id}"><div class="queue-top"><span class="queue-name">${esc(p.business_name)}</span><span class="tag ${p.do_not_contact?'red':p.next_follow_up&&p.next_follow_up<=today()?'gold':p.concept_viewed?'green':''}">${esc(p.do_not_contact?'Do Not Contact':p.outreach_status||p.stage)}</span></div><div class="queue-meta"><span>${esc(p.category||'Uncategorized')}</span><span>•</span><span>${esc([p.city,p.state].filter(Boolean).join(', ')||'Market not set')}</span></div><div class="queue-flags"><span class="tag">${Number(p.call_attempts||0)} call${Number(p.call_attempts||0)===1?'':'s'}</span>${p.next_follow_up?`<span class="tag">Follow-up ${esc(formatDate(p.next_follow_up))}</span>`:''}${p.concept_url?'<span class="tag green">Concept ready</span>':'<span class="tag red">No concept</span>'}</div></button>`).join(''):'<div class="empty">No prospects match this view.</div>';document.querySelectorAll('.queue-item').forEach(b=>b.onclick=()=>selectProspect(Number(b.dataset.id)))}
function callScript(p){const who=p.contact_name?`Hi, is this ${esc(p.contact_name.split(/\s+/)[0])}?`:'Hi, may I speak with the owner or the person responsible for your website?';return `${who} This is Cooper with CajunSites. I noticed ${esc(p.business_name)} doesn’t have a website listed, so we created a complimentary concept showing what one could look like. There’s no charge or obligation. Could I text or email you the preview?`}
function emailText(p){const first=p.contact_name?p.contact_name.split(/\s+/)[0]:'there';return `Hi ${first},\n\nI’m Cooper with CajunSites. We help local small businesses get professional websites without the usual agency pricing.\n\nI noticed ${p.business_name} does not have a website listed, so we created a complimentary concept showing what a website for your business could look like.\n\nView your website concept: ${p.concept_url||''}\n\nThere is no charge or obligation. If you like the direction, reply to this email and I can explain how we would personalize and launch it for your business.\n\nCooper\nCajunSites\nWebsites Built for Small Business\nhello@cajunsites.com`}
function selectProspect(id){selectedId=id;renderQueue();const p=outreachData.prospects.find(x=>Number(x.id)===id);if(!p)return;const emailAction=outreachData.email_enabled?`<button id="emailToggle" ${!p.email||!p.concept_url||p.do_not_contact?'disabled':''}>Email Concept</button>`:'';const emailForm=outreachData.email_enabled?`<form class="email-box" id="emailForm"><h3>Email Concept</h3><p class="email-note">Review the complete message before sending. CajunSites adds the required postal address and unsubscribe footer.</p><div class="field"><label for="emailSubject">Subject</label><input id="emailSubject" value="We created a website concept for ${esc(p.business_name)}" required></div><div class="field"><label for="emailMessage">Message</label><textarea id="emailMessage" required>${esc(emailText(p))}</textarea></div><button class="submit" id="sendEmail">Send through Resend</button></form>`:'';el('workspace').innerHTML=`<div class="work-head"><div><h2>${esc(p.business_name)}</h2><p>${esc([p.category,p.city,p.state].filter(Boolean).join(' • '))}</p></div><span class="tag workspace-status ${p.do_not_contact?'red':p.concept_viewed?'green':''}">${esc(p.outreach_status||p.stage)}</span></div><div id="workNotice"></div><div class="work-actions">${emailAction}${p.concept_url?`<a href="${esc(p.concept_url)}" target="_blank" rel="noopener">Open Concept ↗</a>`:'<button disabled>No Concept</button>'}<a href="/admin/prospect/?id=${p.id}">Full Prospect</a></div><form class="contact-form" id="contactForm"><div class="contact-form-head"><h3>Contact Details</h3><small>Shared with Full Prospect</small></div><div class="contact-grid"><div class="field"><label for="contactName">Contact</label><input id="contactName" value="${esc(p.contact_name||'')}" placeholder="Owner or decision maker" autocomplete="name"></div><div class="field"><label for="contactPhone">Phone number</label><input id="contactPhone" type="tel" value="${esc(p.phone||'')}" placeholder="(504) 555-0123" autocomplete="tel"></div><div class="field"><label for="contactEmail">Email</label><input id="contactEmail" type="email" value="${esc(p.email||'')}" placeholder="name@business.com" autocomplete="email"></div></div><button class="contact-save" type="submit">Save Contact Details</button></form><div class="script"><small>Approved call direction</small><p>${callScript(p)}</p></div><div class="work-grid"><div class="detail"><span>Contact</span><strong>${esc(p.contact_name||'Ask for owner')}</strong></div><div class="detail"><span>Email</span><strong>${esc(p.email||'Not available')}</strong></div><div class="detail"><span>Last result</span><strong>${esc(p.last_call_result||'No calls recorded')}</strong></div><div class="detail"><span>Next follow-up</span><strong>${esc(formatDate(p.next_follow_up))}</strong></div></div><form class="form" id="callForm"><h3>Record Call Result</h3><div class="form-row"><div class="field"><label for="callResult">Result</label><select id="callResult" required><option value="">Select result</option>${outreachData.call_results.map(x=>`<option>${esc(x)}</option>`).join('')}</select></div><div class="field"><label for="followup">Next follow-up</label><input id="followup" type="date" value="${esc(p.next_follow_up||'')}"></div></div><div class="field"><label for="callNotes">Call notes</label><textarea id="callNotes" placeholder="Decision maker, objection, requested callback, or next step"></textarea></div><button class="submit">Save Call Result</button></form>${emailForm}`;wireWorkspace(p);if(innerWidth<1050)el('workspace').scrollIntoView({behavior:'smooth',block:'start'})}
function showNotice(message,error=false){const box=el('workNotice');if(box)box.innerHTML=`<div class="notice ${error?'error':''}">${esc(message)}</div>`}
function wireWorkspace(p){el('emailToggle')?.addEventListener('click',()=>el('emailForm').classList.toggle('open'));el('contactForm')?.addEventListener('submit',async e=>{e.preventDefault();const btn=e.submitter;btn.disabled=true;btn.textContent='Saving...';try{await window.adminApi(`/api/admin/prospects/${p.id}`,{method:'PATCH',body:JSON.stringify({contact_name:el('contactName').value,phone:el('contactPhone').value,email:el('contactEmail').value})});await load(p.id);showNotice('Contact details saved to the prospect record.')}catch(err){showNotice(err.message,true);btn.disabled=false;btn.textContent='Save Contact Details'}});el('callForm')?.addEventListener('submit',async e=>{e.preventDefault();const btn=e.submitter;btn.disabled=true;try{await window.adminApi(`/api/admin/prospects/${p.id}/outreach-call`,{method:'POST',body:JSON.stringify({result:el('callResult').value,next_follow_up:el('followup').value,notes:el('callNotes').value})});await load(p.id);showNotice('Call result recorded.')}catch(err){showNotice(err.message,true)}finally{btn.disabled=false}});el('emailForm')?.addEventListener('submit',async e=>{e.preventDefault();const btn=el('sendEmail');if(!confirm(`Send this email to ${p.email}?`))return;btn.disabled=true;btn.textContent='Sending...';try{await window.adminApi(`/api/admin/prospects/${p.id}/outreach-email`,{method:'POST',body:JSON.stringify({subject:el('emailSubject').value,message:el('emailMessage').value})});await load(p.id);showNotice('Concept email accepted by Resend.')}catch(err){showNotice(err.message,true)}finally{btn.disabled=false;btn.textContent='Send through Resend'}})}
function renderActivity(){el('activity').innerHTML=outreachData.events.length?outreachData.events.slice(0,30).map(e=>`<div class="event"><span class="event-channel">${esc(e.channel)}</span><div class="event-main"><strong>${esc(e.business_name)} · ${esc(e.result||e.event_type)}</strong><span>${esc(e.notes||'No additional notes')}</span></div><time>${esc(formatDate(e.created_at))}</time></div>`).join(''):'<div class="empty">No outreach recorded yet.</div>'}
async function load(reselect=selectedId){try{outreachData=await window.adminApi('/api/admin/outreach');renderStats();renderQueue();renderActivity();if(reselect&&outreachData.prospects.some(p=>Number(p.id)===Number(reselect)))selectProspect(Number(reselect))}catch(err){el('queue').innerHTML=`<div class="empty">${esc(err.message)}</div>`}}
el('search').addEventListener('input',renderQueue);el('filter').addEventListener('change',renderQueue);window.addEventListener('admin-authenticated',()=>load());load();
</script>
