---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Customers" eyebrow="Customer Management" description="Track payments, onboarding, internal notes, and customer website progress." active="customers">
  <button slot="actions" id="refresh" class="admin-action" type="button">Refresh</button>
  <style>
    .toolbar{display:grid;grid-template-columns:1fr 220px 150px;gap:10px;padding:10px;background:white;border:1px solid var(--line);border-radius:16px;margin-bottom:14px;box-shadow:0 8px 24px rgba(34,6,63,.025)}.toolbar input,.toolbar select{min-height:42px;padding:0 12px}.table-wrap{overflow:auto}.contact{display:flex;flex-direction:column;gap:2px}.subtle{display:block;font-size:.76rem;color:#7c7083}.detail{margin-top:14px;scroll-margin-top:88px}.detail-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:16px}.detail-head h2{margin:0 0 8px;color:var(--purple-950);font-size:1.75rem;letter-spacing:-.03em}.detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.info{border:1px solid var(--line);border-radius:14px;padding:16px;background:#fdfbfe}.info h3{font-size:.9rem;color:var(--purple-950);margin-bottom:12px}dl{display:grid;grid-template-columns:110px 1fr;gap:8px 10px;font-size:.8rem}dt{color:#786c80;font-weight:650}dd{margin:0;overflow-wrap:anywhere}.answers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:12px}.answer{border:1px solid var(--line);border-radius:12px;padding:13px;background:#fdfbfe}.answer small{display:block;text-transform:capitalize;color:#786c80;margin-bottom:4px;font-weight:700}.notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.notes-layout{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}.notes-list{display:grid;gap:8px}.note{padding:11px 12px;background:#fbf9fc;border:1px solid var(--line);border-radius:10px}.note small{display:block;color:var(--muted);margin-top:4px}.notes-form textarea{width:100%;min-height:100px;padding:11px 12px;resize:vertical}.linkish{color:var(--purple-700);font-weight:750;text-decoration:none}.linkish:hover{text-decoration:underline}.payment{font-weight:750}.section-label{margin:20px 0 8px;color:var(--purple-700);font-size:.72rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}@media(max-width:1050px){.detail-grid,.answers{grid-template-columns:1fr 1fr}}@media(max-width:900px){.toolbar,.notes-layout{grid-template-columns:1fr}.detail-head{display:block}.detail-head .admin-action{margin-top:12px}}@media(max-width:620px){.detail-grid,.answers{grid-template-columns:1fr}.notes-form .admin-action{width:100%;margin-top:8px}}
  </style>
  <div class="notice" id="notice"></div>
  <div class="admin-grid" style="grid-template-columns:repeat(5,minmax(0,1fr));margin-bottom:14px"><div class="metric"><strong id="total">0</strong><span>Total Customers</span></div><div class="metric"><strong id="awaiting">0</strong><span>Paid - Awaiting Onboarding</span></div><div class="metric"><strong id="received">0</strong><span>Onboarding Received</span></div><div class="metric"><strong id="readyCount">0</strong><span>Ready to Build</span></div><div class="metric"><strong id="active">0</strong><span>Building / Live</span></div></div>
  <div class="toolbar"><input id="search" type="search" placeholder="Search customers, business name, or email..." /><select id="status"><option value="">All Statuses</option><option>Paid - Awaiting Onboarding</option><option>Onboarding Received</option><option>Waiting on Customer</option><option>Ready to Build</option><option>Building</option><option>Internal QA</option><option>Customer Review</option><option>Revisions</option><option>Approved for Launch</option><option>Launching</option><option>Live</option><option>Active Customer</option><option>Payment Issue</option><option>Cancelled</option></select><select id="sort"><option value="newest">Newest First</option><option value="oldest">Oldest First</option><option value="business">Business A-Z</option></select></div>
  <div class="admin-card table-wrap" style="padding:0"><table class="admin-table"><thead><tr><th>Business Name</th><th>Contact</th><th>Status</th><th>Payment</th><th>Onboarding</th><th>Created</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card detail" id="detail"><div class="empty">Select a customer to review their details.</div></div>
</AdminShell>
<script is:inline>
let customers=[];let selected=null;const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not available';const pill=s=>`<span class="pill ${s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'||s==='Cancelled'?'red':'gray'}">${esc(s||'Unknown')}</span>`;
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',4000)}
function metrics(){const s=customers.map(x=>x.status);el('total').textContent=customers.length;el('awaiting').textContent=s.filter(x=>x==='Paid - Awaiting Onboarding').length;el('received').textContent=s.filter(x=>x==='Onboarding Received').length;el('readyCount').textContent=s.filter(x=>x==='Ready to Build').length;el('active').textContent=s.filter(x=>['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching','Live','Active Customer'].includes(x)).length}
function list(){const q=el('search').value.trim().toLowerCase(),st=el('status').value,so=el('sort').value;const a=customers.filter(x=>(!q||`${x.business_name||''} ${x.customer_name||''} ${x.email||''}`.toLowerCase().includes(q))&&(!st||x.status===st));a.sort((a,b)=>so==='oldest'?a.id-b.id:so==='business'?String(a.business_name||'').localeCompare(String(b.business_name||'')):b.id-a.id);return a}
function rows(){const a=list();el('rows').innerHTML=a.length?a.map(x=>`<tr><td><strong>${esc(x.business_name||'Unnamed business')}</strong></td><td><div class="contact"><span>${esc(x.customer_name||'Not provided')}</span><span class="subtle">${esc(x.email)}</span></div></td><td>${pill(x.status)}</td><td><span class="payment">Paid</span><span class="subtle">$499 launch + $49/mo</span></td><td>${x.onboarding_completed?'<span class="pill green">Complete</span>':'<span class="pill gray">Not Submitted</span>'}</td><td>${esc(fmt(x.created_at))}</td><td><button class="admin-action compact view" data-id="${x.id}">View</button></td></tr>`).join(''):'<tr><td colspan="7" class="empty">No customers match your filters.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id),true))}
async function show(id,scroll=false){const x=customers.find(c=>c.id===id);if(!x)return;selected=id;let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{};let notes=[];try{const d=await window.adminApi(`/api/admin/customers/${id}/notes`);notes=d.notes||[]}catch{};const can=x.status==='Onboarding Received';const siteUrl=x.production_url||x.preview_url||'';el('detail').innerHTML=`<div class="detail-head"><div><h2>${esc(x.business_name||'Unnamed business')}</h2><div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">${pill(x.status)} <span class="pill gray">Customer #${x.id}</span></div></div><button class="admin-action primary" id="readyBtn" ${can?'':'disabled'}>${can?'Mark Ready to Build':esc(x.status)}</button></div><div class="detail-grid"><div class="info"><h3>Contact Information</h3><dl><dt>Name</dt><dd>${esc(x.customer_name||'Not provided')}</dd><dt>Email</dt><dd>${esc(x.email)}</dd><dt>Business</dt><dd>${esc(x.business_name||'Not provided')}</dd></dl></div><div class="info"><h3>Payment Information</h3><dl><dt>Status</dt><dd><span class="pill green">Paid</span></dd><dt>Initial checkout</dt><dd>$548.00</dd><dt>Recurring</dt><dd>$49.00 / month</dd><dt>Session</dt><dd>${esc(x.stripe_checkout_session_id)}</dd></dl></div><div class="info"><h3>Site Information</h3><dl><dt>Domain</dt><dd>${esc(x.site_domain||'Not set')}</dd><dt>Template</dt><dd>${esc(x.template_key||'Not set')}</dd><dt>Site</dt><dd>${siteUrl?`<a class="linkish" href="${esc(siteUrl)}" target="_blank" rel="noreferrer">Open site</a>`:'Not provisioned'}</dd></dl></div></div><div class="section-label">Onboarding Details</div>${Object.keys(p).length?`<div class="answers">${Object.entries(p).map(([k,v])=>`<div class="answer"><small>${esc(k.replaceAll('_',' '))}</small><div>${esc(v||'Not provided')}</div></div>`).join('')}</div>`:'<div class="empty">No stored submission yet.</div>'}<div class="notes-layout"><div><h3>Internal Notes</h3><div class="notes-list">${notes.length?notes.map(n=>`<div class="note">${esc(n.note)}<small>${esc(fmt(n.created_at))}</small></div>`).join(''):'<p style="color:var(--muted)">No internal notes yet.</p>'}</div></div><div class="notes-form"><h3>Add Internal Note</h3><textarea id="newNote" placeholder="Add context, follow-up items, customer preferences, or fulfillment notes..."></textarea><button class="admin-action primary" id="addNote">Add Note</button></div></div>`;if(can)el('readyBtn').onclick=()=>markReady(x);el('addNote').onclick=()=>addNote(x);if(scroll)el('detail').scrollIntoView({behavior:'smooth',block:'start'})}
async function addNote(x){const note=el('newNote').value.trim();if(!note)return;try{await window.adminApi(`/api/admin/customers/${x.id}/notes`,{method:'POST',body:JSON.stringify({note})});notice('Internal note added.');await show(x.id)}catch(err){notice(err.message,true)}}
async function markReady(x){if(!confirm(`Mark ${x.business_name||x.email} as Ready to Build?`))return;try{await window.adminApi(`/api/admin/customers/${x.id}/ready`,{method:'POST',body:'{}'});notice(`${x.business_name||'Customer'} is ready to build.`);await load();show(x.id)}catch(err){notice(err.message,true)}}
async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=d.customers||[];metrics();rows();if(selected)show(selected)}catch{}}
window.addEventListener('admin-authenticated',load);el('refresh').onclick=load;['search','status','sort'].forEach(i=>el(i).addEventListener(i==='search'?'input':'change',rows));load();
</script>