---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Customers" eyebrow="Customer Management" description="Track payments, onboarding, notes, and website progress." active="customers">
  <button slot="actions" id="refresh" class="admin-action" type="button">↻ Refresh</button>
  <style>
    .notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}.table-wrap{overflow:auto}.contact{display:flex;flex-direction:column;gap:2px}.subtle{font-size:.72rem;color:#8b7f91}.detail{margin-top:14px;scroll-margin-top:76px}.customer-hero{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;padding:19px;border-bottom:1px solid #eee9f1}.customer-hero h2{margin:0 0 7px;color:#280548;font-size:1.65rem;letter-spacing:-.035em}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:17px 19px}.info{border:1px solid #eee8f1;border-radius:12px;padding:14px}.info h3{font-size:.82rem;margin-bottom:10px}dl{display:grid;grid-template-columns:95px 1fr;gap:7px 9px;font-size:.75rem}dt{color:#887b90;font-weight:700}dd{margin:0;overflow-wrap:anywhere}.answer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.answer{border:1px solid #eee8f1;border-radius:11px;padding:11px}.answer small{display:block;color:#887b90;margin-bottom:4px;font-size:.65rem;text-transform:capitalize;font-weight:800}.notes-layout{display:grid;grid-template-columns:1fr 1fr;gap:14px}.notes-list{display:grid;gap:7px}.note{padding:10px 11px;border:1px solid #eee8f1;border-radius:10px;background:#fdfbff}.note small{display:block;color:#918597;margin-top:4px}.notes-form textarea{width:100%;min-height:95px;padding:10px}.section-label{font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:#641bc0;margin-bottom:9px}.linkish{color:#641bc0;font-weight:800;text-decoration:none}@media(max-width:1000px){.detail-grid,.answer-grid{grid-template-columns:1fr 1fr}}@media(max-width:720px){.customer-hero{display:block}.detail-grid,.answer-grid,.notes-layout{grid-template-columns:1fr}.customer-hero .admin-action{margin-top:12px}}
  </style>
  <div id="notice" class="notice"></div>
  <div class="stats-grid"><div class="metric"><strong id="total">0</strong><span>Total Customers</span><small>All paid accounts</small></div><div class="metric"><strong id="awaiting">0</strong><span>Awaiting Onboarding</span><small>Paid, intake pending</small></div><div class="metric"><strong id="readyCount">0</strong><span>Ready to Build</span><small>Ready for fulfillment</small></div><div class="metric"><strong id="active">0</strong><span>Building / Live</span><small>Active delivery</small></div></div>
  <div class="toolbar-card"><input id="search" type="search" placeholder="Search customers, business, or email..."/><select id="status"><option value="">All Statuses</option><option>Paid - Awaiting Onboarding</option><option>Onboarding Received</option><option>Waiting on Customer</option><option>Ready to Build</option><option>Building</option><option>Internal QA</option><option>Customer Review</option><option>Revisions</option><option>Approved for Launch</option><option>Launching</option><option>Live</option><option>Active Customer</option><option>Payment Issue</option><option>Cancelled</option></select><select id="sort"><option value="newest">Newest First</option><option value="oldest">Oldest First</option><option value="business">Business A-Z</option></select></div>
  <section class="surface"><div class="surface-head"><div><h3>Customer Portfolio</h3><p>Open a customer for onboarding, site, payment, and note details.</p></div></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>Business</th><th>Contact</th><th>Status</th><th>Payment</th><th>Onboarding</th><th>Created</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div></section>
  <section class="surface detail" id="detail"><div class="empty">Select a customer to review their workspace.</div></section>
</AdminShell>
<script is:inline>
let customers=[],selected=null;const el=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not available',pill=s=>`<span class="pill ${s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':s==='Payment Issue'||s==='Cancelled'?'red':'gray'}">${esc(s||'Unknown')}</span>`;function notice(m,b=false){const n=el('notice');n.textContent=m;n.className='notice show'+(b?' error':'');setTimeout(()=>n.className='notice',4000)}function metrics(){const s=customers.map(x=>x.status);el('total').textContent=customers.length;el('awaiting').textContent=s.filter(x=>x==='Paid - Awaiting Onboarding').length;el('readyCount').textContent=s.filter(x=>x==='Ready to Build').length;el('active').textContent=s.filter(x=>['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching','Live','Active Customer'].includes(x)).length}function list(){const q=el('search').value.trim().toLowerCase(),st=el('status').value,so=el('sort').value;const a=customers.filter(x=>(!q||`${x.business_name||''} ${x.customer_name||''} ${x.email||''}`.toLowerCase().includes(q))&&(!st||x.status===st));a.sort((a,b)=>so==='oldest'?a.id-b.id:so==='business'?String(a.business_name||'').localeCompare(String(b.business_name||'')):b.id-a.id);return a}function rows(){const a=list();el('rows').innerHTML=a.length?a.map(x=>`<tr><td><strong>${esc(x.business_name||'Unnamed business')}</strong></td><td><div class="contact"><span>${esc(x.customer_name||'Not provided')}</span><span class="subtle">${esc(x.email)}</span></div></td><td>${pill(x.status)}</td><td><span class="pill green">Paid</span><br><span class="subtle">$499 + $49/mo</span></td><td>${x.onboarding_completed?'<span class="pill green">Complete</span>':'<span class="pill gray">Not Submitted</span>'}</td><td>${esc(fmt(x.created_at))}</td><td><button class="admin-action compact view" data-id="${x.id}">View</button></td></tr>`).join(''):'<tr><td colspan="7" class="empty">No customers match your filters.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id),true))}async function show(id,scroll=false){const x=customers.find(c=>c.id===id);if(!x)return;selected=id;let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{}let notes=[];try{const d=await window.adminApi(`/api/admin/customers/${id}/notes`);notes=d.notes||[]}catch{}const can=x.status==='Onboarding Received',siteUrl=x.production_url||x.preview_url||'';el('detail').innerHTML=`<div class="customer-hero"><div><h2>${esc(x.business_name||'Unnamed business')}</h2><div style="display:flex;gap:7px;flex-wrap:wrap">${pill(x.status)}<span class="pill">Customer #${x.id}</span></div></div><button class="admin-action primary" id="readyBtn" ${can?'':'disabled'}>${can?'Mark Ready to Build':esc(x.status)}</button></div><div class="detail-grid"><div class="info"><h3>Contact</h3><dl><dt>Name</dt><dd>${esc(x.customer_name||'Not provided')}</dd><dt>Email</dt><dd>${esc(x.email)}</dd><dt>Business</dt><dd>${esc(x.business_name||'Not provided')}</dd></dl></div><div class="info"><h3>Billing</h3><dl><dt>Status</dt><dd><span class="pill green">Paid</span></dd><dt>Initial</dt><dd>$548.00</dd><dt>Recurring</dt><dd>$49.00 / month</dd></dl></div><div class="info"><h3>Website</h3><dl><dt>Domain</dt><dd>${esc(x.site_domain||'Not set')}</dd><dt>Template</dt><dd>${esc(x.template_key||'Not set')}</dd><dt>Site</dt><dd>${siteUrl?`<a class="linkish" href="${esc(siteUrl)}" target="_blank">Open site ↗</a>`:'Not provisioned'}</dd></dl></div></div><div class="surface-body"><div class="section-label">Onboarding Details</div>${Object.keys(p).length?`<div class="answer-grid">${Object.entries(p).map(([k,v])=>`<div class="answer"><small>${esc(k.replaceAll('_',' '))}</small><div>${esc(v||'Not provided')}</div></div>`).join('')}</div>`:'<div class="empty">No stored submission yet.</div>'}<div style="height:18px"></div><div class="notes-layout"><div><div class="section-label">Internal Notes</div><div class="notes-list">${notes.length?notes.map(n=>`<div class="note">${esc(n.note)}<small>${esc(fmt(n.created_at))}</small></div>`).join(''):'<div class="subtle">No internal notes yet.</div>'}</div></div><div class="notes-form"><div class="section-label">Add Note</div><textarea id="newNote" placeholder="Add context, follow-up items, customer preferences..."></textarea><button class="admin-action purple" id="addNote">Add Note</button></div></div></div>`;if(can)el('readyBtn').onclick=()=>markReady(x);el('addNote').onclick=()=>addNote(x);if(scroll)el('detail').scrollIntoView({behavior:'smooth',block:'start'})}async function addNote(x){const note=el('newNote').value.trim();if(!note)return;try{await window.adminApi(`/api/admin/customers/${x.id}/notes`,{method:'POST',body:JSON.stringify({note})});notice('Internal note added.');await show(x.id)}catch(err){notice(err.message,true)}}async function markReady(x){if(!confirm(`Mark ${x.business_name||x.email} as Ready to Build?`))return;try{await window.adminApi(`/api/admin/customers/${x.id}/ready`,{method:'POST',body:'{}'});notice(`${x.business_name||'Customer'} is ready to build.`);await load();show(x.id)}catch(err){notice(err.message,true)}}async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=d.customers||[];metrics();rows();if(selected)show(selected)}catch{}}window.addEventListener('admin-authenticated',load);el('refresh').onclick=load;['search','status','sort'].forEach(i=>el(i).addEventListener(i==='search'?'input':'change',rows));load();
</script>