---
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Customer Management | CajunSites</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <style>
    body { background:#faf8fc; min-height:100vh; }
    button,input,select { font:inherit; }
    .admin-shell { min-height:100vh; display:grid; grid-template-columns:230px 1fr; }
    .sidebar { background:linear-gradient(180deg,var(--purple-950),#19042e); color:#fff; padding:26px 18px; position:sticky; top:0; height:100vh; }
    .sidebar .brand { padding:0 8px 28px; }
    .sidebar .wordmark { color:#fff; font-size:1.65rem; }
    .sidebar .wordmark span { color:var(--gold-500); }
    .sidebar .brand small { color:#cfc1d9; }
    .side-label { padding:10px 12px 8px; color:#a998b8; text-transform:uppercase; letter-spacing:.14em; font-size:.66rem; font-weight:850; }
    .side-nav { display:grid; gap:6px; }
    .side-link { display:flex; gap:11px; align-items:center; padding:12px 13px; border-radius:11px; color:#e9e0ee; text-decoration:none; font-size:.92rem; font-weight:750; }
    .side-link.active { background:rgba(248,201,54,.14); color:#fff; box-shadow:inset 0 0 0 1px rgba(248,201,54,.14); }
    .side-link svg { width:18px; height:18px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    .sidebar-foot { position:absolute; bottom:26px; left:26px; right:26px; color:#a998b8; font-size:.75rem; }
    .main { min-width:0; }
    .admin-topbar { height:68px; display:flex; justify-content:flex-end; align-items:center; gap:12px; padding:0 28px; background:#fff; border-bottom:1px solid var(--line); }
    .avatar { width:34px; height:34px; border-radius:50%; display:grid; place-items:center; background:var(--purple-900); color:#fff; font-size:.76rem; font-weight:900; }
    .top-name { font-size:.88rem; font-weight:750; color:#403548; }
    .content { padding:30px; max-width:1500px; margin:0 auto; }
    .page-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:22px; }
    .page-head h1 { font-size:clamp(2.1rem,4vw,3.45rem); margin:0 0 8px; color:var(--purple-950); }
    .page-head p { margin:0; }
    .admin-eyebrow { text-transform:uppercase; letter-spacing:.15em; font-size:.68rem; font-weight:850; color:var(--purple-700); margin-bottom:5px; }
    .ghost-button,.admin-button { min-height:42px; border-radius:10px; padding:0 16px; border:1px solid var(--line); background:#fff; color:var(--purple-900); font-weight:800; cursor:pointer; }
    .admin-button.primary { background:var(--gold-500); color:var(--purple-950); border-color:rgba(0,0,0,.04); box-shadow:0 8px 20px rgba(240,183,25,.18); }
    .admin-button.primary:disabled { opacity:.55; cursor:not-allowed; box-shadow:none; }
    .metrics { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:12px; margin-bottom:18px; }
    .metric { background:#fff; border:1px solid var(--line); border-radius:14px; padding:17px; min-height:96px; display:flex; align-items:center; gap:13px; }
    .metric-icon { width:40px; height:40px; flex:0 0 auto; display:grid; place-items:center; border-radius:12px; background:#f5eff9; color:var(--purple-800); }
    .metric-icon.gold { background:#fff7dd; color:#8c6300; }
    .metric strong { display:block; font-size:1.65rem; line-height:1; color:var(--purple-950); }
    .metric span { display:block; color:var(--muted); font-size:.76rem; line-height:1.25; margin-top:6px; }
    .toolbar { background:#fff; border:1px solid var(--line); border-radius:14px; padding:10px; display:grid; grid-template-columns:1fr 190px 150px; gap:10px; margin-bottom:14px; }
    .toolbar input,.toolbar select { border:1px solid #ddd4e2; padding:10px 12px; border-radius:9px; min-height:42px; }
    .table-card { background:#fff; border:1px solid var(--line); border-radius:14px; overflow:hidden; }
    .table-scroll { overflow:auto; }
    table { width:100%; border-collapse:collapse; min-width:900px; }
    th { text-align:left; padding:12px 14px; background:#fbf9fc; color:#5f5366; font-size:.68rem; text-transform:uppercase; letter-spacing:.06em; }
    td { padding:13px 14px; border-top:1px solid #eee8f1; font-size:.84rem; vertical-align:middle; }
    tr.customer-row { cursor:pointer; }
    tr.customer-row:hover { background:#fcfafc; }
    tr.customer-row.selected { background:#fbf7ee; }
    .business { font-weight:850; color:var(--purple-950); }
    .subtle { display:block; color:#7c7083; font-size:.76rem; margin-top:2px; }
    .status { display:inline-flex; align-items:center; padding:5px 9px; border-radius:999px; background:#f2edf7; color:var(--purple-800); font-weight:800; font-size:.72rem; white-space:nowrap; }
    .status.awaiting { background:#fff3cd; color:#795700; }
    .status.ready { background:#e7f7eb; color:#166b36; }
    .status.building { background:#eee8ff; color:#4b26a0; }
    .status.live { background:#e8f6ef; color:#0b6842; }
    .dot-label { display:inline-flex; align-items:center; gap:7px; color:#4f4655; white-space:nowrap; }
    .dot-label:before { content:""; width:7px; height:7px; border-radius:50%; background:#1a9a5d; }
    .detail { margin-top:16px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px; }
    .detail-empty { color:var(--muted); text-align:center; padding:48px 20px; }
    .detail-head { display:flex; justify-content:space-between; align-items:flex-start; gap:18px; padding-bottom:18px; border-bottom:1px solid var(--line); }
    .back-link { color:var(--purple-700); background:none; border:0; padding:0; font-weight:800; cursor:pointer; margin-bottom:10px; }
    .detail-title { display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
    .detail-title h2 { margin:0; font-size:1.65rem; color:var(--purple-950); }
    .detail-meta { color:var(--muted); margin-top:5px; font-size:.84rem; }
    .detail-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:9px; }
    .detail-grid { display:grid; grid-template-columns:.8fr 1fr 1fr; gap:12px; margin-top:16px; }
    .info-card { border:1px solid var(--line); border-radius:13px; padding:17px; min-width:0; }
    .info-card h3 { font-size:.9rem; color:var(--purple-950); margin:0 0 13px; }
    .kv { display:grid; grid-template-columns:minmax(105px,.7fr) minmax(0,1fr); gap:8px 12px; font-size:.8rem; }
    .kv dt { color:#786c80; }
    .kv dd { margin:0; color:#2e2632; overflow-wrap:anywhere; }
    .tabs { display:flex; gap:6px; border-bottom:1px solid var(--line); margin-top:18px; overflow:auto; }
    .tab { border:0; background:none; padding:12px 14px; font-weight:800; color:#695e70; cursor:pointer; white-space:nowrap; border-bottom:3px solid transparent; }
    .tab.active { color:var(--purple-900); border-bottom-color:var(--gold-500); }
    .onboarding-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; padding-top:16px; }
    .onboarding-section { border:1px solid var(--line); border-radius:13px; padding:16px; }
    .onboarding-section h3 { font-size:.88rem; margin-bottom:12px; color:var(--purple-950); }
    .onboarding-section p { font-size:.8rem; margin:0 0 8px; overflow-wrap:anywhere; white-space:pre-wrap; }
    .onboarding-section strong { color:#45394a; }
    .notice { border-radius:10px; padding:11px 13px; font-size:.82rem; margin-bottom:14px; display:none; }
    .notice.show { display:block; }
    .notice.error { background:#fdecec; color:#8d2424; border:1px solid #f2cccc; }
    .notice.success { background:#e8f7ee; color:#17683a; border:1px solid #cdebd8; }
    .login-overlay { position:fixed; inset:0; z-index:100; display:grid; place-items:center; padding:20px; background:linear-gradient(135deg,rgba(34,6,63,.97),rgba(64,20,110,.94)); }
    .login-overlay.hidden { display:none; }
    .login-card { width:min(440px,100%); background:#fff; border-radius:22px; padding:32px; box-shadow:0 30px 80px rgba(0,0,0,.32); }
    .login-card .wordmark { font-size:1.8rem; }
    .login-card h1 { font-size:2rem; margin:28px 0 8px; color:var(--purple-950); }
    .login-card p { font-size:.92rem; }
    .login-card label { margin-top:18px; }
    .login-actions { display:flex; gap:10px; margin-top:16px; }
    .login-actions .admin-button { width:100%; }
    .loading { padding:46px 20px; text-align:center; color:var(--muted); }
    @media (max-width:1100px) {
      .metrics { grid-template-columns:repeat(3,1fr); }
      .detail-grid { grid-template-columns:1fr 1fr; }
      .onboarding-grid { grid-template-columns:1fr 1fr; }
    }
    @media (max-width:780px) {
      .admin-shell { grid-template-columns:1fr; }
      .sidebar { height:auto; position:static; padding:16px; }
      .sidebar .brand { padding-bottom:12px; }
      .side-label,.sidebar-foot { display:none; }
      .side-nav { grid-template-columns:repeat(4,1fr); overflow:auto; }
      .side-link { justify-content:center; padding:10px; font-size:.75rem; }
      .side-link span { display:none; }
      .admin-topbar { display:none; }
      .content { padding:18px 14px 30px; }
      .page-head { flex-direction:column; }
      .metrics { grid-template-columns:1fr 1fr; }
      .toolbar { grid-template-columns:1fr; }
      .detail-head { flex-direction:column; }
      .detail-actions { justify-content:flex-start; width:100%; }
      .detail-grid,.onboarding-grid { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
  <div class="login-overlay" id="loginOverlay">
    <form class="login-card" id="loginForm">
      <div class="brand"><span class="wordmark">Cajun<span>Sites</span></span><small>Websites Built for Small Business</small></div>
      <h1>Internal Dashboard</h1>
      <p>Sign in to manage paid customers, review onboarding submissions, and move projects into the build queue.</p>
      <div class="notice error" id="loginError"></div>
      <label for="password">Dashboard password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
      <div class="login-actions"><button class="admin-button primary" type="submit">Sign In</button></div>
    </form>
  </div>

  <div class="admin-shell">
    <aside class="sidebar">
      <a class="brand" href="/admin/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a>
      <div class="side-label">Manage</div>
      <nav class="side-nav" aria-label="Internal navigation">
        <a class="side-link active" href="/admin/" aria-current="page"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg><span>Customers</span></a>
        <a class="side-link" href="#detail"><svg viewBox="0 0 24 24"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h8M9 17h8"/></svg><span>Onboarding</span></a>
        <a class="side-link" href="#detail"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5 5L3 18l3 3 6.7-6.7a4 4 0 0 0 5-5l-2.4 2.4-3-3z"/></svg><span>Build Queue</span></a>
        <a class="side-link" href="/" target="_blank"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg><span>Public Site</span></a>
      </nav>
      <div class="sidebar-foot">CajunSites internal operations</div>
    </aside>

    <main class="main">
      <div class="admin-topbar"><div class="avatar">BT</div><span class="top-name">Blake Taravella</span><button class="ghost-button" id="logoutButton" type="button">Sign Out</button></div>
      <div class="content">
        <div class="page-head">
          <div><div class="admin-eyebrow">Customer Management</div><h1>Customers</h1><p>Track payments, review onboarding details, and move customers through the build process.</p></div>
          <button class="admin-button" id="refreshButton" type="button">Refresh</button>
        </div>
        <div class="notice" id="notice"></div>

        <section class="metrics" aria-label="Customer status summary">
          <div class="metric"><div class="metric-icon gold">#</div><div><strong id="metricTotal">0</strong><span>Total Customers</span></div></div>
          <div class="metric"><div class="metric-icon gold">$</div><div><strong id="metricAwaiting">0</strong><span>Paid - Awaiting Onboarding</span></div></div>
          <div class="metric"><div class="metric-icon">✓</div><div><strong id="metricReceived">0</strong><span>Onboarding Received</span></div></div>
          <div class="metric"><div class="metric-icon">→</div><div><strong id="metricReady">0</strong><span>Ready to Build</span></div></div>
          <div class="metric"><div class="metric-icon">●</div><div><strong id="metricBuild">0</strong><span>Building / Live</span></div></div>
        </section>

        <div class="toolbar">
          <input id="searchInput" type="search" placeholder="Search customers, business name, or email..." aria-label="Search customers" />
          <select id="statusFilter" aria-label="Filter by status"><option value="">All Statuses</option><option>Paid - Awaiting Onboarding</option><option>Onboarding Received</option><option>Waiting on Customer</option><option>Ready to Build</option><option>Building</option><option>Internal QA</option><option>Customer Review</option><option>Revisions</option><option>Approved for Launch</option><option>Launching</option><option>Live</option><option>Active Customer</option><option>Payment Issue</option><option>Cancelled</option></select>
          <select id="sortFilter" aria-label="Sort customers"><option value="newest">Newest First</option><option value="oldest">Oldest First</option><option value="business">Business A-Z</option></select>
        </div>

        <section class="table-card">
          <div class="table-scroll"><table><thead><tr><th>Business Name</th><th>Contact</th><th>Status</th><th>Payment</th><th>Onboarding</th><th>Created</th><th>Action</th></tr></thead><tbody id="customerRows"><tr><td colspan="7" class="loading">Loading customers...</td></tr></tbody></table></div>
        </section>

        <section class="detail" id="detail"><div class="detail-empty" id="detailEmpty">Select a customer to review their details.</div><div id="detailContent" hidden></div></section>
      </div>
    </main>
  </div>

  <script>
    const state = { customers: [], selectedId: null };
    const $ = (id) => document.getElementById(id);
    const esc = (value) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const formatDate = (value) => value ? new Intl.DateTimeFormat('en-US',{dateStyle:'medium',timeStyle:'short'}).format(new Date(value.endsWith('Z') ? value : value.replace(' ','T')+'Z')) : 'Not available';
    const statusClass = (status='') => status.includes('Awaiting') ? 'awaiting' : status === 'Ready to Build' ? 'ready' : ['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching'].includes(status) ? 'building' : ['Live','Active Customer'].includes(status) ? 'live' : '';
    const statusPill = (status) => `<span class="status ${statusClass(status)}">${esc(status || 'Unknown')}</span>`;

    function showNotice(message, type='success') {
      const el = $('notice'); el.textContent = message; el.className = `notice show ${type}`;
      window.setTimeout(() => { el.className = 'notice'; }, 4500);
    }

    async function api(path, options={}) {
      const response = await fetch(path, {credentials:'same-origin', ...options, headers:{'content-type':'application/json', ...(options.headers||{})}});
      if (response.status === 401) { $('loginOverlay').classList.remove('hidden'); throw new Error('Authentication required'); }
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'Request failed');
      return data;
    }

    async function loadCustomers() {
      try {
        const data = await api('/api/admin/customers');
        state.customers = data.customers || [];
        $('loginOverlay').classList.add('hidden');
        renderMetrics(); renderRows();
        if (state.selectedId) selectCustomer(state.selectedId, false);
      } catch (error) {
        if (error.message !== 'Authentication required') showNotice(error.message, 'error');
      }
    }

    function renderMetrics() {
      const statuses = state.customers.map(c => c.status);
      $('metricTotal').textContent = state.customers.length;
      $('metricAwaiting').textContent = statuses.filter(s => s === 'Paid - Awaiting Onboarding').length;
      $('metricReceived').textContent = statuses.filter(s => s === 'Onboarding Received').length;
      $('metricReady').textContent = statuses.filter(s => s === 'Ready to Build').length;
      $('metricBuild').textContent = statuses.filter(s => ['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching','Live','Active Customer'].includes(s)).length;
    }

    function filteredCustomers() {
      const term = $('searchInput').value.trim().toLowerCase();
      const status = $('statusFilter').value;
      const sort = $('sortFilter').value;
      const list = state.customers.filter(c => {
        const haystack = `${c.business_name||''} ${c.customer_name||''} ${c.email||''}`.toLowerCase();
        return (!term || haystack.includes(term)) && (!status || c.status === status);
      });
      list.sort((a,b) => sort === 'oldest' ? a.id-b.id : sort === 'business' ? String(a.business_name||'').localeCompare(String(b.business_name||'')) : b.id-a.id);
      return list;
    }

    function renderRows() {
      const list = filteredCustomers();
      $('customerRows').innerHTML = list.length ? list.map(c => `
        <tr class="customer-row ${state.selectedId===c.id?'selected':''}" data-id="${c.id}">
          <td><span class="business">${esc(c.business_name || 'Unnamed business')}</span></td>
          <td>${esc(c.customer_name || 'Not provided')}<span class="subtle">${esc(c.email)}</span></td>
          <td>${statusPill(c.status)}</td>
          <td><span class="dot-label">Paid</span><span class="subtle">$499 launch + $49/mo</span></td>
          <td>${c.onboarding_completed ? '<span class="dot-label">Complete</span>' : '<span class="subtle">Not submitted</span>'}</td>
          <td>${esc(formatDate(c.created_at))}</td>
          <td><button class="ghost-button view-customer" data-id="${c.id}" type="button">View</button></td>
        </tr>`).join('') : '<tr><td colspan="7" class="loading">No customers match your filters.</td></tr>';
      document.querySelectorAll('.customer-row,.view-customer').forEach(el => el.addEventListener('click',(event) => { event.stopPropagation(); selectCustomer(Number(el.dataset.id || el.closest('[data-id]')?.dataset.id)); }));
    }

    function sectionCard(title, rows) {
      const visible = rows.filter(([,value]) => value);
      if (!visible.length) return '';
      return `<div class="onboarding-section"><h3>${esc(title)}</h3>${visible.map(([label,value]) => `<p><strong>${esc(label)}:</strong> ${esc(value)}</p>`).join('')}</div>`;
    }

    function renderOnboarding(payload) {
      if (!payload) return '<div class="onboarding-section"><h3>No stored submission</h3><p>This customer does not have onboarding detail data stored in the dashboard.</p></div>';
      return [
        sectionCard('Business Details',[['Contact name',payload.contact_name],['Business name',payload.business_name],['Business type',payload.business_type],['Years in business',payload.years_business],['Description',payload.business_description],['What makes them different',payload.unique_points]]),
        sectionCard('Services & Service Areas',[['Services',payload.services],['Service areas',payload.service_areas],['Priority service/customer',payload.priority_service]]),
        sectionCard('Hours & Contact',[['Public phone',payload.public_phone],['Public email',payload.public_email],['Address',payload.business_address],['Hours',payload.hours],['Preferred contact',payload.contact_preference]]),
        sectionCard('Domain & Website',[['Domain',payload.domain_name],['Domain provider',payload.domain_provider],['Existing website',payload.existing_website],['Content to reuse',payload.existing_content]]),
        sectionCard('Brand Assets',[['Logo / brand files',payload.logo_link],['Business photos',payload.photos_link],['Photo notes',payload.photo_notes]]),
        sectionCard('Social & Google',[['Facebook',payload.facebook],['Instagram',payload.instagram],['LinkedIn',payload.linkedin],['Other social',payload.other_social],['Google Business Profile',payload.google_business]]),
        sectionCard('Reviews',[['Authorized testimonials',payload.testimonials],['Public review page',payload.reviews_link]]),
        sectionCard('Design Preferences',[['Style',payload.design_style],['Brand colors',payload.brand_colors],['Colors to avoid',payload.avoid_colors],['Example websites',payload.example_sites],['Things to avoid',payload.design_avoid]]),
        sectionCard('Final Notes',[['Additional notes',payload.additional_notes],['Authorization confirmed',payload.accuracy_confirmed === 'yes' ? 'Yes' : payload.accuracy_confirmed]])
      ].filter(Boolean).join('');
    }

    function selectCustomer(id, scroll=true) {
      const c = state.customers.find(item => item.id === id); if (!c) return;
      state.selectedId = id; renderRows();
      $('detailEmpty').hidden = true; const detail = $('detailContent'); detail.hidden = false;
      let payload = null; try { payload = c.onboarding_payload ? JSON.parse(c.onboarding_payload) : null; } catch {}
      const canReady = c.status === 'Onboarding Received';
      detail.innerHTML = `
        <div class="detail-head">
          <div><button class="back-link" id="backToCustomers" type="button">← Back to Customers</button><div class="detail-title"><h2>${esc(c.business_name || 'Unnamed business')}</h2>${statusPill(c.status)}</div><div class="detail-meta">Customer #${c.id} · Created ${esc(formatDate(c.created_at))}</div></div>
          <div class="detail-actions"><button class="admin-button primary" id="readyButton" type="button" ${canReady?'':'disabled'}>${canReady?'Mark Ready to Build':esc(c.status)}</button></div>
        </div>
        <div class="detail-grid">
          <div class="info-card"><h3>Contact Information</h3><dl class="kv"><dt>Name</dt><dd>${esc(c.customer_name || 'Not provided')}</dd><dt>Email</dt><dd>${esc(c.email)}</dd><dt>Business</dt><dd>${esc(c.business_name || 'Not provided')}</dd></dl></div>
          <div class="info-card"><h3>Payment Information</h3><dl class="kv"><dt>Status</dt><dd><span class="dot-label">Paid</span></dd><dt>Initial checkout</dt><dd>$548.00</dd><dt>Recurring</dt><dd>$49.00 / month</dd><dt>Checkout session</dt><dd>${esc(c.stripe_checkout_session_id)}</dd><dt>Subscription</dt><dd>${esc(c.stripe_subscription_id || 'Not available')}</dd><dt>Paid / created</dt><dd>${esc(formatDate(c.created_at))}</dd></dl></div>
          <div class="info-card"><h3>Onboarding Status</h3><dl class="kv"><dt>Status</dt><dd>${c.onboarding_completed ? '<span class="dot-label">Complete</span>' : 'Not submitted'}</dd><dt>Submitted</dt><dd>${esc(formatDate(c.onboarding_submitted_at))}</dd><dt>Welcome email</dt><dd>${c.welcome_email_sent ? 'Sent' : 'Pending'}</dd></dl></div>
        </div>
        <div class="tabs"><button class="tab active" type="button">Onboarding Details</button></div>
        <div class="onboarding-grid">${renderOnboarding(payload)}</div>`;
      $('backToCustomers').addEventListener('click',() => { state.selectedId=null; detail.hidden=true; $('detailEmpty').hidden=false; renderRows(); window.scrollTo({top:0,behavior:'smooth'}); });
      if (canReady) $('readyButton').addEventListener('click',() => markReady(c));
      if (scroll) $('detail').scrollIntoView({behavior:'smooth',block:'start'});
    }

    async function markReady(customer) {
      if (!confirm(`Mark ${customer.business_name || customer.email} as Ready to Build?`)) return;
      const button = $('readyButton'); button.disabled = true; button.textContent = 'Updating...';
      try { await api(`/api/admin/customers/${customer.id}/ready`, {method:'POST',body:'{}'}); showNotice(`${customer.business_name || 'Customer'} is ready to build.`); await loadCustomers(); selectCustomer(customer.id,false); }
      catch (error) { showNotice(error.message,'error'); button.disabled=false; button.textContent='Mark Ready to Build'; }
    }

    $('loginForm').addEventListener('submit', async (event) => {
      event.preventDefault(); const error = $('loginError'); error.className='notice';
      try { await api('/api/admin/login',{method:'POST',body:JSON.stringify({password:$('password').value})}); $('password').value=''; $('loginOverlay').classList.add('hidden'); await loadCustomers(); }
      catch (err) { if (err.message !== 'Authentication required') { error.textContent=err.message; error.className='notice show error'; } }
    });
    $('logoutButton').addEventListener('click', async () => { await fetch('/api/admin/logout',{method:'POST',credentials:'same-origin'}); $('loginOverlay').classList.remove('hidden'); state.customers=[]; state.selectedId=null; renderMetrics(); renderRows(); });
    $('refreshButton').addEventListener('click',loadCustomers);
    ['searchInput','statusFilter','sortFilter'].forEach(id => $(id).addEventListener(id==='searchInput'?'input':'change',renderRows));
    loadCustomers();
  </script>
</body>
</html>
