---
import AdminShell from '../../components/AdminShell.astro';
---
<AdminShell title="Customers" eyebrow="Customer Management" description="Track payments, review onboarding details, and move customers through the build process." active="customers">
  <button slot="actions" id="refresh" class="admin-refresh" type="button">Refresh</button>
  <style>
    .admin-refresh,.view,.ready{min-height:40px;border-radius:10px;padding:0 15px;border:1px solid var(--line);background:white;color:var(--purple-900);font-weight:800;cursor:pointer}.ready{background:var(--gold-500);color:var(--purple-950);border:0}.ready:disabled{opacity:.5;cursor:not-allowed}.toolbar{display:grid;grid-template-columns:1fr 220px 150px;gap:10px;padding:10px;background:white;border:1px solid var(--line);border-radius:14px;margin-bottom:14px}.toolbar input,.toolbar select{min-height:42px}.table-wrap{overflow:auto}.contact{display:flex;flex-direction:column;gap:2px}.subtle{font-size:.76rem;color:#7c7083}.detail{margin-top:14px}.detail-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;border-bottom:1px solid var(--line);padding-bottom:16px}.detail-head h2{margin:0 0 6px;color:var(--purple-950);font-size:1.65rem}.detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.info{border:1px solid var(--line);border-radius:12px;padding:16px}.info h3{font-size:.92rem;color:var(--purple-950)}dl{display:grid;grid-template-columns:110px 1fr;gap:8px 10px;font-size:.8rem}dt{color:#786c80}dd{margin:0;overflow-wrap:anywhere}.answers{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:12px}.answer{border:1px solid var(--line);border-radius:12px;padding:14px}.answer small{display:block;text-transform:capitalize;color:#786c80;margin-bottom:4px}.notice{display:none;padding:11px 13px;border-radius:10px;margin-bottom:14px}.notice.show{display:block;background:#e8f7ee;color:#17683a}.notice.error{background:#fdecec;color:#8d2424}@media(max-width:900px){.toolbar,.detail-grid,.answers{grid-template-columns:1fr}}
  </style>
  <div class="notice" id="notice"></div>
  <div class="admin-grid" style="margin-bottom:14px"><div class="metric"><strong id="total">0</strong><span>Total Customers</span></div><div class="metric"><strong id="awaiting">0</strong><span>Paid - Awaiting Onboarding</span></div><div class="metric"><strong id="received">0</strong><span>Onboarding Received</span></div><div class="metric"><strong id="readyCount">0</strong><span>Ready to Build</span></div><div class="metric"><strong id="active">0</strong><span>Building / Live</span></div></div>
  <div class="toolbar"><input id="search" type="search" placeholder="Search customers, business name, or email..." /><select id="status"><option value="">All Statuses</option><option>Paid - Awaiting Onboarding</option><option>Onboarding Received</option><option>Waiting on Customer</option><option>Ready to Build</option><option>Building</option><option>Internal QA</option><option>Customer Review</option><option>Revisions</option><option>Approved for Launch</option><option>Launching</option><option>Live</option><option>Active Customer</option><option>Payment Issue</option><option>Cancelled</option></select><select id="sort"><option value="newest">Newest First</option><option value="oldest">Oldest First</option><option value="business">Business A-Z</option></select></div>
  <div class="admin-card table-wrap" style="padding:0"><table class="admin-table"><thead><tr><th>Business Name</th><th>Contact</th><th>Status</th><th>Payment</th><th>Onboarding</th><th>Created</th><th>Action</th></tr></thead><tbody id="rows"><tr><td colspan="7" class="empty">Loading...</td></tr></tbody></table></div>
  <div class="admin-card detail" id="detail"><div class="empty">Select a customer to review their details.</div></div>
</AdminShell>
<script is:inline>
let customers=[];let selected=null;const el=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const fmt=v=>v?new Date(v.replace(' ','T')+'Z').toLocaleString():'Not available';const pill=s=>`<span class="pill ${s==='Ready to Build'||s==='Live'||s==='Active Customer'?'green':s?.includes('Awaiting')?'gold':''}">${esc(s||'Unknown')}</span>`;
function notice(m,bad=false){const n=el('notice');n.textContent=m;n.className='notice show'+(bad?' error':'');setTimeout(()=>n.className='notice',4000)}
function metrics(){const s=customers.map(x=>x.status);el('total').textContent=customers.length;el('awaiting').textContent=s.filter(x=>x==='Paid - Awaiting Onboarding').length;el('received').textContent=s.filter(x=>x==='Onboarding Received').length;el('readyCount').textContent=s.filter(x=>x==='Ready to Build').length;el('active').textContent=s.filter(x=>['Building','Internal QA','Customer Review','Revisions','Approved for Launch','Launching','Live','Active Customer'].includes(x)).length}
function list(){const q=el('search').value.trim().toLowerCase(),st=el('status').value,so=el('sort').value;const a=customers.filter(x=>(!q||`${x.business_name||''} ${x.customer_name||''} ${x.email||''}`.toLowerCase().includes(q))&&(!st||x.status===st));a.sort((a,b)=>so==='oldest'?a.id-b.id:so==='business'?String(a.business_name||'').localeCompare(String(b.business_name||'')):b.id-a.id);return a}
function rows(){const a=list();el('rows').innerHTML=a.length?a.map(x=>`<tr><td><strong>${esc(x.business_name||'Unnamed business')}</strong></td><td><div class="contact"><span>${esc(x.customer_name||'Not provided')}</span><span class="subtle">${esc(x.email)}</span></div></td><td>${pill(x.status)}</td><td>Paid<span class="subtle">$499 launch + $49/mo</span></td><td>${x.onboarding_completed?'Complete':'Not submitted'}</td><td>${esc(fmt(x.created_at))}</td><td><button class="view" data-id="${x.id}">View</button></td></tr>`).join(''):'<tr><td colspan="7" class="empty">No customers match your filters.</td></tr>';document.querySelectorAll('.view').forEach(b=>b.onclick=()=>show(Number(b.dataset.id)))}
function show(id){const x=customers.find(c=>c.id===id);if(!x)return;selected=id;let p={};try{p=x.onboarding_payload?JSON.parse(x.onboarding_payload):{}}catch{};const can=x.status==='Onboarding Received';el('detail').innerHTML=`<div class="detail-head"><div><h2>${esc(x.business_name||'Unnamed business')}</h2>${pill(x.status)} <span class="subtle">Customer #${x.id}</span></div><button class="ready" id="readyBtn" ${can?'':'disabled'}>${can?'Mark Ready to Build':esc(x.status)}</button></div><div class="detail-grid"><div class="info"><h3>Contact Information</h3><dl><dt>Name</dt><dd>${esc(x.customer_name||'Not provided')}</dd><dt>Email</dt><dd>${esc(x.email)}</dd><dt>Business</dt><dd>${esc(x.business_name||'Not provided')}</dd></dl></div><div class="info"><h3>Payment Information</h3><dl><dt>Status</dt><dd>Paid</dd><dt>Initial checkout</dt><dd>$548.00</dd><dt>Recurring</dt><dd>$49.00 / month</dd><dt>Session</dt><dd>${esc(x.stripe_checkout_session_id)}</dd></dl></div><div class="info"><h3>Onboarding Status</h3><dl><dt>Status</dt><dd>${x.onboarding_completed?'Complete':'Not submitted'}</dd><dt>Submitted</dt><dd>${esc(fmt(x.onboarding_submitted_at))}</dd><dt>Welcome email</dt><dd>${x.welcome_email_sent?'Sent':'Pending'}</dd></dl></div></div><h3 style="margin-top:18px">Onboarding Details</h3>${Object.keys(p).length?`<div class="answers">${Object.entries(p).map(([k,v])=>`<div class="answer"><small>${esc(k.replaceAll('_',' '))}</small><div>${esc(v||'Not provided')}</div></div>`).join('')}</div>`:'<p>No stored submission yet.</p>'}`;if(can)el('readyBtn').onclick=()=>markReady(x)}
async function markReady(x){if(!confirm(`Mark ${x.business_name||x.email} as Ready to Build?`))return;try{await window.adminApi(`/api/admin/customers/${x.id}/ready`,{method:'POST',body:'{}'});notice(`${x.business_name||'Customer'} is ready to build.`);await load();show(x.id)}catch(err){notice(err.message,true)}}
async function load(){try{const d=await window.adminApi('/api/admin/customers');customers=d.customers||[];metrics();rows();if(selected)show(selected)}catch{}}
window.addEventListener('admin-authenticated',load);el('refresh').onclick=load;['search','status','sort'].forEach(i=>el(i).addEventListener(i==='search'?'input':'change',rows));load();
</script>