---
import '../styles/global.css';
const { title, eyebrow='Internal Operations', description='', active='customers', hideHeader=false } = Astro.props;
const navGroups=[
  {label:'',items:[
    {key:'overview',label:'Overview',href:'/admin/overview/',icon:'M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3Z'}
  ]},
  {label:'Sales',items:[
    {key:'prospects',label:'Prospects',href:'/admin/prospects/',icon:'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-5a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z'},
    {key:'outreach',label:'Outreach',href:'/admin/outreach/',icon:'M4 5h16v12H7l-3 3V5Zm3 4h10m-10 4h7'},
    {key:'design',label:'Design Studio',href:'/admin/design-studio/',icon:'M12 3l1.4 4.1L17.5 8.5l-4.1 1.4L12 14l-1.4-4.1L6.5 8.5l4.1-1.4L12 3Zm6 10 .9 2.6 2.6.9-2.6.9L18 20l-.9-2.6-2.6-.9 2.6-.9L18 13Z'}
  ]},
  {label:'Production',items:[
    {key:'customers',label:'Customers',href:'/admin/',icon:'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.9m-1-10a4 4 0 0 1 0 7.75'},
    {key:'onboarding',label:'Onboarding',href:'/admin/onboarding/',icon:'M8 4h8m-8 4h8m-8 4h5m-8 9h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2Z'},
    {key:'build',label:'Build Queue',href:'/admin/build-queue/',icon:'M14.7 6.3a4 4 0 0 0-5.65 5.65L3 18l3 3 6.05-6.05a4 4 0 0 0 5.65-5.65L15 12l-3-3 2.7-2.7Z'},
    {key:'sites',label:'Sites',href:'/admin/sites/',icon:'M3 5h18v14H3zM3 9h18M7 5v4'}
  ]},
  {label:'Business',items:[
    {key:'billing',label:'Billing',href:'/admin/billing/',icon:'M4 7h16v12H4zM4 10h16M8 15h4'},
    {key:'analytics',label:'Analytics',href:'/admin/analytics/',icon:'M4 20V10m6 10V4m6 16v-7m4 7H2'},
    {key:'activity',label:'Activity',href:'/admin/activity/',icon:'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Zm0-15v6l4 2'}
  ]},
  {label:'System',items:[
    {key:'templates',label:'Visual Systems',href:'/admin/templates/',icon:'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z'},
    {key:'documentation',label:'Documentation',href:'/admin/documentation/',icon:'M5 3h10l4 4v14H5zM15 3v5h5M8 12h8m-8 4h8'},
    {key:'users',label:'Internal Users',href:'/admin/users/',icon:'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0',ownerOnly:true},
    {key:'settings',label:'Settings',href:'/admin/settings/',icon:'M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8-3.5 2-1-2-3-2 .5a8 8 0 0 0-1.5-1L16 5l-3-1-1 2a8 8 0 0 0-2 0L9 4 6 5l-.5 2.5a8 8 0 0 0-1.5 1L2 8l-2 3 2 1a8 8 0 0 0 0 2l-2 1 2 3 2-.5a8 8 0 0 0 1.5 1L6 21l3 1 1-2a8 8 0 0 0 2 0l1 2 3-1 .5-2.5a8 8 0 0 0 1.5-1l2 .5 2-3-2-1a8 8 0 0 0 0-2Z'}
  ]}
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="robots" content="noindex,nofollow"/>
<meta name="referrer" content="no-referrer"/>
<title>{title} | CajunSites</title>
<style>
:global(body){margin:0;min-height:100vh;overflow-x:hidden;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
:global(*),:global(*::before),:global(*::after){box-sizing:border-box}
:global(button),:global(input),:global(select),:global(textarea){font:inherit}
:global(a),:global(button),:global(input),:global(select),:global(textarea){-webkit-tap-highlight-color:transparent}
.shell{min-height:100vh;display:grid;grid-template-columns:228px minmax(0,1fr)}
.sidebar{position:sticky;top:0;height:100vh;overflow:auto;display:flex;flex-direction:column;z-index:60}
.brand{display:flex;flex-direction:column;text-decoration:none;line-height:1}.wordmark{color:#fff}.wordmark span{color:#f0b719}
.nav-group{display:block}.nav{display:grid}.nav a{display:flex;align-items:center;gap:10px;text-decoration:none}.nav a[hidden]{display:none}.nav-icon{width:18px;height:18px;display:grid;place-items:center;flex:none}.nav-icon svg{width:17px;height:17px}.foot{margin-top:auto}
.main{min-width:0}.topbar{position:sticky;top:0;z-index:30;display:flex;justify-content:flex-end;align-items:center;gap:10px}.mobilebar{display:none}.drawer-backdrop{display:none}
.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#2d0b50;color:#fff;font-size:.7rem;font-weight:700;flex:none}.identity{display:flex;flex-direction:column;line-height:1.15;min-width:0}.name{font-size:.8rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.role{font-size:.68rem;color:#85788c;text-transform:capitalize}.button{min-height:38px;border-radius:8px;padding:0 14px;border:1px solid #e2dee5;background:#fff;color:#39343d;font-weight:600;cursor:pointer}
.content{min-width:0}.head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start}.head>div:first-child{min-width:0}
:global(h2),:global(h3){margin-top:0}:global(p){line-height:1.55}:global(a){overflow-wrap:anywhere}:global(code),:global(pre){max-width:100%;overflow:auto}
:global(.admin-card),:global(.surface){background:#fff;min-width:0}:global(.surface-head){display:flex;justify-content:space-between;gap:14px;align-items:center}:global(.admin-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}:global(.stats-grid){display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
:global(.admin-table){width:100%}:global(.admin-table th){text-align:left}:global(.admin-table td){vertical-align:middle;overflow-wrap:anywhere}
:global(.pill){display:inline-flex;align-items:center}:global(.metric strong){display:block}:global(.empty){text-align:center}
:global(.admin-action){display:inline-flex;align-items:center;justify-content:center;gap:7px;text-decoration:none;cursor:pointer}:global(.admin-action[disabled]){opacity:.48;cursor:not-allowed}
:global(.toolbar-card){display:grid;grid-template-columns:1fr auto auto;gap:9px}:global(.page-grid){display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:start}:global(.side-stack){display:grid;gap:14px;position:sticky;top:72px}:global(.section-tabs){display:flex;overflow:auto;scrollbar-width:none}:global(.section-tabs::-webkit-scrollbar){display:none}
.login{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:#1e0735}.login.hidden{display:none}.login-card{width:min(420px,100%);background:#fff;border-radius:16px;padding:30px;box-shadow:0 20px 50px rgba(30,7,53,.22)}.login-card .wordmark{color:#2d0b50}.login-card h2{margin:24px 0 8px}.login-card label{display:block;margin-top:14px;font-size:.82rem;font-weight:600}.login-card input{width:100%;padding:12px;margin-top:5px;min-height:46px}.login-card button{width:100%;margin-top:16px;min-height:46px;background:#f0b719;color:#1e0735;border:1px solid #c38e08;border-radius:8px;font-weight:600}.error{color:#a12b2b;font-size:.8rem;margin-top:10px}
@media(max-width:1100px){:global(.stats-grid){grid-template-columns:repeat(2,minmax(0,1fr))}:global(.page-grid){grid-template-columns:1fr}:global(.side-stack){position:static;grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .shell{display:block;min-height:100vh}.topbar{display:none}.mobilebar{position:sticky;top:0;z-index:55;height:56px;display:grid;grid-template-columns:44px minmax(0,1fr) 40px;align-items:center;gap:8px;padding:0 max(12px,env(safe-area-inset-right)) 0 max(12px,env(safe-area-inset-left));background:rgba(255,255,255,.98);border-bottom:1px solid #ebe8ed;backdrop-filter:blur(12px)}.mobile-menu{width:40px;height:40px;border:1px solid #e2dee5;background:#fff;border-radius:8px;color:#2d0b50;font-size:1.15rem;font-weight:700;cursor:pointer}.mobile-page{min-width:0}.mobile-page strong{display:block;color:#18151b;font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-page span{display:block;color:#8b8490;font-size:.65rem;margin-top:1px}.mobilebar .avatar{justify-self:end}
  .sidebar{position:fixed;top:0;left:0;height:100dvh;width:min(320px,86vw);padding:calc(18px + env(safe-area-inset-top)) 12px calc(18px + env(safe-area-inset-bottom));transform:translateX(-105%);transition:transform .18s ease;box-shadow:18px 0 50px rgba(30,7,53,.22);z-index:80}.nav-open .sidebar{transform:translateX(0)}.drawer-backdrop{position:fixed;inset:0;background:rgba(24,21,27,.46);z-index:70}.nav-open .drawer-backdrop{display:block}.nav-open{overflow:hidden}
  .content{padding:20px 14px calc(34px + env(safe-area-inset-bottom))}:global(.admin-grid){grid-template-columns:1fr 1fr}:global(.toolbar-card){grid-template-columns:1fr}:global(.toolbar-card .admin-action){width:100%}:global(.surface-head){align-items:flex-start;flex-wrap:wrap}
}
@media(max-width:700px){
  :global(.admin-grid),:global(.side-stack){grid-template-columns:1fr}:global(.stats-grid){grid-template-columns:repeat(2,minmax(0,1fr))}.content{padding:16px 11px calc(30px + env(safe-area-inset-bottom))}.head{display:grid;gap:11px}
  :global(input),:global(select),:global(textarea),:global(button){min-height:44px}:global(.admin-action){min-height:44px}:global(.admin-action.compact){min-height:40px}:global(.form-grid){grid-template-columns:1fr!important}:global(.field.full){grid-column:1!important}
  :global(.admin-table){display:block;width:100%;min-width:0!important;border-collapse:separate}:global(.admin-table thead){display:none}:global(.admin-table tbody){display:grid;gap:8px;padding:0}:global(.admin-table tr){display:block;border:1px solid #ebe8ed;border-radius:10px;background:#fff;overflow:hidden}:global(.admin-table td){display:flex;justify-content:space-between;align-items:flex-start;gap:14px;width:100%;padding:10px 12px;border-top:1px solid #ebe8ed;text-align:right;min-width:0}:global(.admin-table td:first-child){border-top:0}:global(.admin-table td::before){content:attr(data-label);flex:0 0 38%;text-align:left;color:#8b8490;font-size:.68rem;font-weight:600}:global(.admin-table td>*),:global(.admin-table td>div){min-width:0;max-width:62%}:global(.admin-table td[colspan]){display:block;text-align:center}:global(.admin-table td[colspan]::before){display:none}:global(.admin-table td[colspan]>*),:global(.admin-table td[colspan]>div){max-width:100%}
}
@media(max-width:430px){:global(.stats-grid){grid-template-columns:1fr 1fr;gap:8px}.mobilebar{grid-template-columns:42px minmax(0,1fr) 36px}.content{padding-left:9px;padding-right:9px}.login-card{padding:24px 18px;border-radius:14px}}
@media(hover:none){.nav a:hover{background:transparent}.nav a.active:hover{background:rgba(240,183,25,.12)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
</head>
<body class="cs-admin" data-page={active}>
<div class="login" id="adminLogin"><form class="login-card" id="adminLoginForm"><div class="wordmark">Cajun<span>Sites</span></div><h2>Internal Dashboard</h2><p>Sign in with your CajunSites internal account.</p><label for="adminEmail">Email</label><input id="adminEmail" type="email" autocomplete="username" value="blaketaravella@gmail.com" required/><label for="adminPassword">Password</label><input id="adminPassword" type="password" autocomplete="current-password" required/><div class="error" id="adminLoginError"></div><button type="submit">Sign In</button></form></div>
<div class="drawer-backdrop" id="drawerBackdrop"></div>
<div class="shell">
  <aside class="sidebar" id="adminSidebar">
    <a class="brand" href="/admin/overview/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a>
    {navGroups.map(group=><div class="nav-group">
      {group.label&&<div class="nav-group-label">{group.label}</div>}
      <nav class="nav">
        {group.items.map(item=><a class={item.key===active?'active':''} href={item.href} data-owner-only={item.ownerOnly?'true':undefined} hidden={item.ownerOnly}>
          <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg></span>
          <span>{item.label}</span>
        </a>)}
      </nav>
    </div>)}
    <div class="foot">CajunSites internal operations</div>
  </aside>
  <main class="main">
    <div class="topbar"><div class="avatar" id="adminAvatar">CS</div><div class="identity"><span class="name" id="adminName">CajunSites</span><span class="role" id="adminRole">Internal User</span></div><button class="button" id="adminLogout">Sign Out</button></div>
    <div class="mobilebar"><button class="mobile-menu" id="mobileMenu" aria-label="Open navigation" aria-expanded="false">☰</button><div class="mobile-page"><strong>{title}</strong><span>CajunSites Operations</span></div><div class="avatar" id="mobileAvatar">CS</div></div>
    <div class="content">{!hideHeader&&<div class="head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div><slot name="actions"/></div>}<slot/></div>
  </main>
</div>
<script is:inline>
window.adminApi=async(path,options={})=>{const r=await fetch(path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});if(r.status===401){document.getElementById('adminLogin')?.classList.remove('hidden');throw new Error('Authentication required')}const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d};
const login=document.getElementById('adminLogin'),form=document.getElementById('adminLoginForm'),err=document.getElementById('adminLoginError');
function applyUser(user){window.adminUser=user;const initials=String(user.name||'CS').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase()||'CS';document.getElementById('adminAvatar').textContent=initials;document.getElementById('mobileAvatar').textContent=initials;document.getElementById('adminName').textContent=user.name||user.email;document.getElementById('adminRole').textContent=(user.role||'').replace('_',' ');document.querySelectorAll('[data-owner-only="true"]').forEach(a=>a.hidden=user.role!=='owner');document.body.dataset.adminRole=user.role||'';login?.classList.add('hidden');window.dispatchEvent(new CustomEvent('admin-authenticated',{detail:user}))}
async function hydrate(){const d=await window.adminApi('/api/admin/me');applyUser(d.user)}
form?.addEventListener('submit',async e=>{e.preventDefault();err.textContent='';try{const d=await window.adminApi('/api/admin/login',{method:'POST',body:JSON.stringify({email:document.getElementById('adminEmail').value,password:document.getElementById('adminPassword').value})});document.getElementById('adminPassword').value='';applyUser(d.user)}catch(e){err.textContent=e.message}});
async function logout(){try{await window.adminApi('/api/admin/logout',{method:'POST',body:'{}'})}catch{}location.href='/admin/login/'}
document.getElementById('adminLogout').onclick=logout;
const menu=document.getElementById('mobileMenu'),backdrop=document.getElementById('drawerBackdrop');function setNav(open){document.body.classList.toggle('nav-open',open);menu?.setAttribute('aria-expanded',open?'true':'false');menu&&(menu.textContent=open?'×':'☰')}menu?.addEventListener('click',()=>setNav(!document.body.classList.contains('nav-open')));backdrop?.addEventListener('click',()=>setNav(false));document.querySelectorAll('#adminSidebar a').forEach(a=>a.addEventListener('click',()=>setNav(false)));
document.getElementById('mobileAvatar')?.addEventListener('click',()=>{if(confirm('Sign out of CajunSites?'))logout()});
function labelTables(root=document){root.querySelectorAll?.('.admin-table').forEach(table=>{const labels=[...table.querySelectorAll('thead th')].map(th=>th.textContent.trim());table.querySelectorAll('tbody tr').forEach(row=>{[...row.children].forEach((cell,i)=>{if(cell.tagName==='TD'&&!cell.hasAttribute('colspan')&&!cell.dataset.label)cell.dataset.label=labels[i]||''})})})}
labelTables();new MutationObserver(m=>{for(const x of m)for(const n of x.addedNodes)if(n.nodeType===1)labelTables(n.matches?.('.admin-table')?n:n.parentElement||document)}).observe(document.body,{childList:true,subtree:true});
hydrate().catch(()=>{});
</script>
</body></html>
