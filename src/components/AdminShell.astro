---
import '../styles/global.css';
const { title, eyebrow='Internal Operations', description='', active='customers' } = Astro.props;
const nav = [
  ['overview','Overview','/admin/overview/'],
  ['customers','Customers','/admin/'],
  ['onboarding','Onboarding','/admin/onboarding/'],
  ['build','Build Queue','/admin/build-queue/'],
  ['sites','Sites','/admin/sites/'],
  ['activity','Activity','/admin/activity/'],
  ['templates','Templates','/admin/templates/'],
  ['analytics','Analytics','/admin/analytics/'],
  ['settings','Settings','/admin/settings/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{title} | CajunSites</title>
  <style>
    :global(body){margin:0;background:#faf8fc;min-height:100vh}
    .shell{min-height:100vh;display:grid;grid-template-columns:230px 1fr}
    .sidebar{position:sticky;top:0;height:100vh;padding:26px 18px;background:linear-gradient(180deg,var(--purple-950),#19042e);color:white}
    .brand{display:flex;flex-direction:column;text-decoration:none;padding:0 8px 28px;line-height:1}.wordmark{font-size:1.65rem;font-weight:900;letter-spacing:-.04em;color:white}.wordmark span{color:var(--gold-500)}.brand small{margin-top:6px;font-size:.72rem;color:#cfc1d9;font-weight:700}
    .label{padding:10px 12px 8px;color:#a998b8;text-transform:uppercase;letter-spacing:.14em;font-size:.66rem;font-weight:850}.nav{display:grid;gap:4px}.nav a{display:flex;align-items:center;padding:10px 13px;border-radius:11px;color:#e9e0ee;text-decoration:none;font-size:.88rem;font-weight:750}.nav a.active{background:rgba(248,201,54,.14);color:white;box-shadow:inset 0 0 0 1px rgba(248,201,54,.14)}.foot{position:absolute;bottom:26px;left:26px;color:#a998b8;font-size:.75rem}
    .main{min-width:0}.topbar{height:68px;display:flex;justify-content:flex-end;align-items:center;gap:12px;padding:0 28px;background:#fff;border-bottom:1px solid var(--line)}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--purple-900);color:#fff;font-size:.76rem;font-weight:900}.name{font-size:.88rem;font-weight:750}.button{min-height:40px;border-radius:10px;padding:0 15px;border:1px solid var(--line);background:white;color:var(--purple-900);font-weight:800;cursor:pointer}
    .content{padding:30px;max-width:1500px;margin:0 auto}.head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:22px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.68rem;font-weight:850;color:var(--purple-700);margin-bottom:5px}.head h1{font-size:clamp(2.1rem,4vw,3.45rem);margin:0 0 8px;color:var(--purple-950)}.head p{margin:0;color:var(--muted)}
    :global(.admin-card){background:white;border:1px solid var(--line);border-radius:14px;padding:18px}:global(.admin-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}:global(.admin-table){width:100%;border-collapse:collapse}:global(.admin-table th){text-align:left;padding:11px 12px;background:#fbf9fc;color:#5f5366;font-size:.68rem;text-transform:uppercase;letter-spacing:.06em}:global(.admin-table td){padding:13px 12px;border-top:1px solid #eee8f1;font-size:.84rem}:global(.pill){display:inline-flex;padding:5px 9px;border-radius:999px;background:#f2edf7;color:var(--purple-800);font-size:.72rem;font-weight:800}:global(.pill.gold){background:#fff3cd;color:#795700}:global(.pill.green){background:#e7f7eb;color:#166b36}:global(.metric){background:white;border:1px solid var(--line);border-radius:14px;padding:18px}:global(.metric strong){display:block;font-size:1.8rem;color:var(--purple-950)}:global(.metric span){font-size:.78rem;color:var(--muted)}:global(.empty){padding:46px 20px;text-align:center;color:var(--muted)}:global(.admin-action){min-height:36px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:white;color:var(--purple-900);font-weight:800;cursor:pointer}:global(.admin-action.primary){background:var(--gold-500);color:var(--purple-950);border-color:transparent}
    .login{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,rgba(34,6,63,.97),rgba(64,20,110,.94))}.login.hidden{display:none}.login-card{width:min(430px,100%);background:white;border-radius:22px;padding:32px}.login-card h2{margin:26px 0 8px;color:var(--purple-950)}.login-card input{width:100%;padding:13px;border:1px solid var(--line);border-radius:10px}.login-card button{width:100%;margin-top:14px;min-height:44px;background:var(--gold-500);color:var(--purple-950);border:0;border-radius:10px;font-weight:850}.error{color:#8d2424;font-size:.82rem;margin-top:10px}
    @media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{height:auto;position:static}.nav{grid-template-columns:repeat(4,1fr);overflow:auto}.nav a{justify-content:center;font-size:.75rem}.foot,.label{display:none}.topbar{display:none}.content{padding:18px 14px}.admin-grid{grid-template-columns:1fr 1fr}}
  </style>
</head>
<body>
  <div class="login" id="adminLogin"><form class="login-card" id="adminLoginForm"><div class="wordmark">Cajun<span>Sites</span></div><h2>Internal Dashboard</h2><p>Sign in to continue.</p><input id="adminPassword" type="password" autocomplete="current-password" required /><div class="error" id="adminLoginError"></div><button type="submit">Sign In</button></form></div>
  <div class="shell">
    <aside class="sidebar"><a class="brand" href="/admin/overview/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a><div class="label">Manage</div><nav class="nav">{nav.map(([key,label,href]) => <a class={key===active?'active':''} href={href}>{label}</a>)}</nav><div class="foot">CajunSites internal operations</div></aside>
    <main class="main"><div class="topbar"><div class="avatar">BT</div><span class="name">Blake Taravella</span><button class="button" id="adminLogout" type="button">Sign Out</button></div><div class="content"><div class="head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div><slot name="actions" /></div><slot /></div></main>
  </div>
  <script is:inline>
    window.adminApi=async(path,options={})=>{const r=await fetch(path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});if(r.status===401){document.getElementById('adminLogin').classList.remove('hidden');throw new Error('Authentication required')}const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d};
    const login=document.getElementById('adminLogin');const form=document.getElementById('adminLoginForm');const err=document.getElementById('adminLoginError');
    form.addEventListener('submit',async e=>{e.preventDefault();err.textContent='';try{await window.adminApi('/api/admin/login',{method:'POST',body:JSON.stringify({password:document.getElementById('adminPassword').value})});document.getElementById('adminPassword').value='';login.classList.add('hidden');window.dispatchEvent(new Event('admin-authenticated'))}catch(x){if(x.message!=='Authentication required')err.textContent=x.message}});
    document.getElementById('adminLogout')?.addEventListener('click',async()=>{await fetch('/api/admin/logout',{method:'POST',credentials:'same-origin'});login.classList.remove('hidden')});
    window.adminApi('/api/admin/customers').then(()=>{login.classList.add('hidden');window.dispatchEvent(new Event('admin-authenticated'))}).catch(()=>{});
  </script>
</body>
</html>