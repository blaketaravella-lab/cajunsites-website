---
import '../styles/global.css';
const { title, eyebrow='Internal Operations', description='', active='customers' } = Astro.props;
const nav = [
  ['overview','Overview','/admin/overview/'],
  ['prospects','Prospects','/admin/prospects/'],
  ['customers','Customers','/admin/'],
  ['onboarding','Onboarding','/admin/onboarding/'],
  ['build','Build Queue','/admin/build-queue/'],
  ['sites','Sites','/admin/sites/'],
  ['activity','Activity','/admin/activity/'],
  ['templates','Templates','/admin/templates/'],
  ['analytics','Analytics','/admin/analytics/'],
  ['documentation','Documentation','/admin/documentation/'],
  ['users','Internal Users','/admin/users/',true],
  ['settings','Settings','/admin/settings/'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{title} | CajunSites</title>
  <style>
    :global(body){margin:0;background:#faf8fc;min-height:100vh}
    .shell{min-height:100vh;display:grid;grid-template-columns:230px 1fr}
    .sidebar{position:sticky;top:0;height:100vh;padding:24px 16px 18px;background:linear-gradient(180deg,var(--purple-950) 0%,#19042e 100%);color:white;overflow:auto;display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,.05)}
    .brand{display:flex;flex-direction:column;text-decoration:none;padding:0 10px 24px;line-height:1}.wordmark{font-size:1.65rem;font-weight:900;letter-spacing:-.04em;color:white}.wordmark span{color:var(--gold-500)}.brand small{margin-top:6px;font-size:.72rem;color:#cfc1d9;font-weight:700}
    .label{padding:9px 12px 8px;color:#aa99b9;text-transform:uppercase;letter-spacing:.14em;font-size:.66rem;font-weight:850}.nav{display:grid;gap:6px}.nav a{display:flex;align-items:center;min-height:42px;padding:10px 13px;border-radius:12px;color:#e9e0ee;text-decoration:none;font-size:.88rem;font-weight:750;border:1px solid transparent;transition:background .15s ease,border-color .15s ease,color .15s ease,transform .15s ease}.nav a:hover{background:rgba(255,255,255,.055);color:#fff;transform:translateX(1px)}.nav a.active{background:linear-gradient(90deg,rgba(248,201,54,.17),rgba(248,201,54,.09));color:white;border-color:rgba(248,201,54,.24);box-shadow:inset 3px 0 0 var(--gold-500)}.nav a[hidden]{display:none}.foot{margin-top:auto;padding:24px 10px 2px;color:#a998b8;font-size:.72rem;line-height:1.4}
    .main{min-width:0}.topbar{height:68px;display:flex;justify-content:flex-end;align-items:center;gap:12px;padding:0 28px;background:rgba(255,255,255,.97);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--purple-900);color:#fff;font-size:.76rem;font-weight:900;box-shadow:0 6px 14px rgba(45,11,80,.16)}.identity{display:flex;flex-direction:column;line-height:1.2}.name{font-size:.88rem;font-weight:800;color:var(--purple-950)}.role{font-size:.68rem;color:var(--muted);text-transform:capitalize}.button{min-height:40px;border-radius:11px;padding:0 16px;border:1px solid var(--line);background:white;color:var(--purple-900);font-weight:800;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}.button:hover{transform:translateY(-1px);border-color:#d9cfe0;box-shadow:0 8px 20px rgba(34,6,63,.07)}
    .content{padding:30px;max-width:1500px;margin:0 auto}.head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:24px}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:.68rem;font-weight:850;color:var(--purple-700);margin-bottom:6px}.head h1{font-size:clamp(2.1rem,4vw,3.45rem);line-height:.98;letter-spacing:-.045em;margin:0 0 10px;color:var(--purple-950)}.head p{margin:0;color:var(--muted);max-width:780px}
    :global(.admin-card){background:white;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 8px 28px rgba(34,6,63,.035)}:global(.admin-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}:global(.admin-table){width:100%;border-collapse:collapse}:global(.admin-table th){text-align:left;padding:12px 13px;background:#fbf9fc;color:#5f5366;font-size:.68rem;text-transform:uppercase;letter-spacing:.065em;font-weight:850}:global(.admin-table td){padding:14px 13px;border-top:1px solid #eee8f1;font-size:.84rem;vertical-align:middle}:global(.admin-table tbody tr:hover){background:#fdfbfe}:global(.pill){display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;background:#f2edf7;color:var(--purple-800);font-size:.72rem;font-weight:800}:global(.pill.gold){background:#fff3cd;color:#795700}:global(.pill.green){background:#e7f7eb;color:#166b36}:global(.metric){position:relative;overflow:hidden;background:white;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:0 8px 28px rgba(34,6,63,.035)}:global(.metric::before){content:"";position:absolute;left:0;top:0;width:100%;height:3px;background:linear-gradient(90deg,var(--purple-800),var(--gold-500));opacity:.9}:global(.metric strong){display:block;font-size:1.9rem;line-height:1;color:var(--purple-950);letter-spacing:-.035em;margin-bottom:8px}:global(.metric span){font-size:.78rem;color:var(--muted);font-weight:650}:global(.empty){padding:46px 20px;text-align:center;color:var(--muted)}:global(.admin-action){min-height:38px;padding:0 13px;border:1px solid var(--line);border-radius:10px;background:white;color:var(--purple-900);font-weight:800;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease,border-color .15s ease}:global(.admin-action:hover){transform:translateY(-1px);border-color:#d8cde0;box-shadow:0 8px 18px rgba(34,6,63,.07)}:global(.admin-action.primary){background:var(--gold-500);color:var(--purple-950);border-color:rgba(0,0,0,.04);box-shadow:0 10px 24px rgba(240,183,25,.2)}:global(.admin-action.primary:hover){box-shadow:0 12px 28px rgba(240,183,25,.27)}
    .login{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,rgba(34,6,63,.97),rgba(64,20,110,.94))}.login.hidden{display:none}.login-card{width:min(430px,100%);background:white;border-radius:22px;padding:32px;box-shadow:0 30px 80px rgba(0,0,0,.3)}.login-card .wordmark{color:var(--purple-900)}.login-card h2{margin:26px 0 8px;color:var(--purple-950)}.login-card p{font-size:.9rem}.login-card label{display:block;margin-top:14px;font-size:.8rem;font-weight:800}.login-card input{width:100%;padding:13px;border:1px solid var(--line);border-radius:10px;margin-top:5px}.login-card input:focus{outline:2px solid rgba(84,33,138,.16);border-color:var(--purple-700)}.login-card button{width:100%;margin-top:16px;min-height:44px;background:var(--gold-500);color:var(--purple-950);border:0;border-radius:11px;font-weight:850;box-shadow:0 10px 25px rgba(240,183,25,.22)}.error{color:#8d2424;font-size:.82rem;margin-top:10px}
    @media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{height:auto;position:static;display:block;padding:18px 14px}.brand{padding-bottom:16px}.nav{grid-template-columns:repeat(4,minmax(120px,1fr));overflow:auto;gap:6px;padding-bottom:2px}.nav a{justify-content:center;font-size:.75rem;min-height:38px;white-space:nowrap}.nav a.active{box-shadow:inset 0 -3px 0 var(--gold-500)}.foot,.label{display:none}.topbar{display:none}.content{padding:20px 14px}.head{margin-bottom:20px}:global(.admin-grid){grid-template-columns:1fr 1fr}}
    @media(max-width:620px){:global(.admin-grid){grid-template-columns:1fr}.content{padding:18px 12px}.head h1{font-size:2.25rem}}
  </style>
</head>
<body>
  <div class="login" id="adminLogin"><form class="login-card" id="adminLoginForm"><div class="wordmark">Cajun<span>Sites</span></div><h2>Internal Dashboard</h2><p>Sign in with your CajunSites internal account.</p><label for="adminEmail">Email</label><input id="adminEmail" type="email" autocomplete="username" value="blaketaravella@gmail.com" required /><label for="adminPassword">Password</label><input id="adminPassword" type="password" autocomplete="current-password" required /><div class="error" id="adminLoginError"></div><button type="submit">Sign In</button></form></div>
  <div class="shell">
    <aside class="sidebar"><a class="brand" href="/admin/overview/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a><div class="label">Manage</div><nav class="nav">{nav.map(([key,label,href,ownerOnly]) => <a class={key===active?'active':''} href={href} data-owner-only={ownerOnly?'true':undefined} hidden={ownerOnly}>{label}</a>)}</nav><div class="foot">CajunSites internal operations</div></aside>
    <main class="main"><div class="topbar"><div class="avatar" id="adminAvatar">CS</div><div class="identity"><span class="name" id="adminName">CajunSites</span><span class="role" id="adminRole">Internal User</span></div><button class="button" id="adminLogout" type="button">Sign Out</button></div><div class="content"><div class="head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div><slot name="actions" /></div><slot /></div></main>
  </div>
  <script is:inline>
    window.adminApi=async(path,options={})=>{const r=await fetch(path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});if(r.status===401){document.getElementById('adminLogin').classList.remove('hidden');throw new Error('Authentication required')}const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d};
    const login=document.getElementById('adminLogin'),form=document.getElementById('adminLoginForm'),err=document.getElementById('adminLoginError');
    function applyUser(user){window.adminUser=user;const initials=String(user.name||'CS').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();document.getElementById('adminAvatar').textContent=initials||'CS';document.getElementById('adminName').textContent=user.name||user.email;document.getElementById('adminRole').textContent=(user.role||'').replace('_',' ');document.querySelectorAll('[data-owner-only="true"]').forEach(a=>a.hidden=user.role!=='owner');document.body.dataset.adminRole=user.role||'';login.classList.add('hidden');window.dispatchEvent(new CustomEvent('admin-authenticated',{detail:user}))}
    async function hydrate(){const d=await window.adminApi('/api/admin/me');applyUser(d.user);return d.user}
    form.addEventListener('submit',async e=>{e.preventDefault();err.textContent='';try{const d=await window.adminApi('/api/admin/login',{method:'POST',body:JSON.stringify({email:document.getElementById('adminEmail').value,password:document.getElementById('adminPassword').value,name:'Blake Taravella'})});document.getElementById('adminPassword').value='';applyUser(d.user)}catch(x){if(x.message!=='Authentication required')err.textContent=x.message}});
    document.getElementById('adminLogout')?.addEventListener('click',async()=>{await fetch('/api/admin/logout',{method:'POST',credentials:'same-origin'});window.adminUser=null;login.classList.remove('hidden')});
    hydrate().catch(()=>{});
  </script>
</body>
</html>