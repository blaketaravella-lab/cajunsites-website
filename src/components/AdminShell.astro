---
import '../styles/global.css';
const { title, eyebrow='Internal Operations', description='', active='customers', hideHeader=false } = Astro.props;
const nav=[['overview','Overview','/admin/overview/','⌂'],['prospects','Prospects','/admin/prospects/','◎'],['customers','Customers','/admin/','◉'],['onboarding','Onboarding','/admin/onboarding/','✓'],['build','Build Queue','/admin/build-queue/','◇'],['sites','Sites','/admin/sites/','□'],['activity','Activity','/admin/activity/','◷'],['templates','Templates','/admin/templates/','▱'],['analytics','Analytics','/admin/analytics/','⌁'],['documentation','Documentation','/admin/documentation/','≡'],['users','Internal Users','/admin/users/','♙',true],['settings','Settings','/admin/settings/','⚙']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<meta name="robots" content="noindex,nofollow"/>
<meta name="referrer" content="no-referrer"/>
<title>{title} | CajunSites</title>
<style>
:global(body){margin:0;background:#fbfaff;min-height:100vh;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;overflow-x:hidden}
:global(*),:global(*::before),:global(*::after){box-sizing:border-box}
:global(button),:global(input),:global(select),:global(textarea){font:inherit}
:global(a),:global(button),:global(input),:global(select),:global(textarea){-webkit-tap-highlight-color:transparent}
:global(:focus-visible){outline:3px solid rgba(93,35,194,.16);outline-offset:2px}
.shell{min-height:100vh;display:grid;grid-template-columns:212px minmax(0,1fr)}
.sidebar{position:sticky;top:0;height:100vh;padding:20px 13px 15px;background:linear-gradient(180deg,#280548,#170228);color:white;overflow:auto;display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,.05);z-index:60}
.brand{display:flex;flex-direction:column;text-decoration:none;padding:0 9px 22px;line-height:1}
.wordmark{font-size:1.55rem;font-weight:950;letter-spacing:-.05em;color:white}.wordmark span{color:#ffc21c}.brand small{margin-top:6px;font-size:.67rem;color:#d4c7dd;font-weight:700}
.label{padding:9px 10px 7px;color:#a996b8;text-transform:uppercase;letter-spacing:.13em;font-size:.62rem;font-weight:900}
.nav{display:grid;gap:4px}.nav a{display:flex;align-items:center;gap:10px;min-height:42px;padding:9px 11px;border-radius:10px;color:#eee7f2;text-decoration:none;font-size:.82rem;font-weight:780;border:1px solid transparent;transition:.15s ease}.nav a:hover{background:rgba(255,255,255,.055);color:#fff}.nav a.active{background:linear-gradient(90deg,rgba(255,194,28,.22),rgba(255,255,255,.09));color:#fff;border-color:rgba(255,194,28,.12);box-shadow:inset 3px 0 0 #ffc21c}.nav-icon{width:18px;text-align:center;color:#c8b6d5;font-size:.84rem}.nav a.active .nav-icon{color:#ffc21c}.nav a[hidden]{display:none}.foot{margin-top:auto;padding:22px 9px 2px;color:#9f8cad;font-size:.65rem}
.main{min-width:0}.topbar{position:sticky;top:0;z-index:30;height:58px;display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:0 24px;background:rgba(255,255,255,.96);border-bottom:1px solid #eee9f1;backdrop-filter:blur(14px)}
.mobilebar{display:none}.drawer-backdrop{display:none}.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#2d0752;color:#fff;font-size:.7rem;font-weight:900;flex:none}.identity{display:flex;flex-direction:column;line-height:1.15;min-width:0}.name{font-size:.8rem;font-weight:850;color:#2b0b4b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.role{font-size:.62rem;color:#85788c;text-transform:capitalize}.button{min-height:38px;border-radius:9px;padding:0 14px;border:1px solid #e6deea;background:white;color:#321050;font-weight:800;cursor:pointer}
.content{padding:24px 30px 38px;max-width:1600px;margin:0 auto;min-width:0}.head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:20px}.head>div:first-child{min-width:0}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.62rem;font-weight:900;color:#6d24b8;margin-bottom:6px}.head h1{font-size:clamp(2rem,3.3vw,3rem);line-height:1;letter-spacing:-.045em;margin:0 0 8px;color:#280548}.head p{margin:0;color:#776b7d;max-width:780px;font-size:.88rem;line-height:1.5}
:global(h2),:global(h3){color:#280548}:global(h3){margin:0 0 8px;font-size:1rem}:global(p){line-height:1.55}:global(a){overflow-wrap:anywhere}:global(code),:global(pre){max-width:100%;overflow:auto}
:global(.admin-card),:global(.surface){background:#fff;border:1px solid #e9e2ed;border-radius:16px;box-shadow:0 5px 18px rgba(40,5,72,.025);min-width:0}:global(.admin-card){padding:20px}:global(.surface-head){display:flex;justify-content:space-between;gap:14px;align-items:center;padding:17px 19px;border-bottom:1px solid #eee9f1}:global(.surface-head h3){margin:0}:global(.surface-head p){margin:4px 0 0;color:#81758a;font-size:.72rem}:global(.surface-body){padding:18px 19px}
:global(.admin-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}:global(.stats-grid){display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:14px}
:global(.admin-table){width:100%;border-collapse:separate;border-spacing:0}:global(.admin-table th){text-align:left;padding:11px 13px;background:#fbf9fc;color:#6d6174;font-size:.64rem;text-transform:uppercase;letter-spacing:.065em;font-weight:900;white-space:nowrap}:global(.admin-table td){padding:13px;border-top:1px solid #eee9f1;font-size:.8rem;vertical-align:middle;overflow-wrap:anywhere}:global(.admin-table tbody tr:hover){background:#fdfbff}
:global(.pill){display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#f1eafa;color:#55208d;font-size:.68rem;font-weight:850;white-space:nowrap}:global(.pill.gold){background:#fff0bd;color:#795500}:global(.pill.green){background:#e4f7e9;color:#126832}:global(.pill.gray){background:#f0f1f4;color:#626873}:global(.pill.red){background:#fde9e9;color:#8c2525}
:global(.metric){position:relative;background:#fff;border:1px solid #e9e2ed;border-radius:14px;padding:15px 16px;min-height:86px;box-shadow:0 5px 18px rgba(40,5,72,.025)}:global(.metric strong){display:block;font-size:1.6rem;line-height:1;color:#280548;letter-spacing:-.04em;margin:3px 0 8px}:global(.metric span){font-size:.71rem;color:#776b7d;font-weight:650}:global(.metric small){display:block;color:#9b8fa2;font-size:.63rem;margin-top:4px}:global(.empty){padding:38px 18px;text-align:center;color:#817587}
:global(.admin-action){display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:40px;padding:0 13px;border:1px solid #e3dbe8;border-radius:9px;background:#fff;color:#42116e;font-weight:820;cursor:pointer;transition:.15s ease;text-decoration:none;font-size:.8rem}:global(.admin-action:hover){transform:translateY(-1px);border-color:#cdbdd8;box-shadow:0 7px 17px rgba(40,5,72,.07)}:global(.admin-action.primary){background:linear-gradient(135deg,#ffbd16,#ffc943);color:#2b074a;border-color:#eeb017;box-shadow:0 8px 20px rgba(240,183,25,.2)}:global(.admin-action.purple){background:linear-gradient(135deg,#3b0767,#6619b4);color:#fff;border-color:#4c0a85;box-shadow:0 8px 20px rgba(70,12,121,.16)}:global(.admin-action.compact){min-height:36px;padding:0 10px;font-size:.74rem}:global(.admin-action.danger){color:#8d2424;background:#fffafa}:global(.admin-action[disabled]){opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
:global(.toolbar-card){display:grid;grid-template-columns:1fr auto auto;gap:9px;padding:10px;background:#fff;border:1px solid #e9e2ed;border-radius:14px;margin-bottom:14px}:global(.toolbar-card input),:global(.toolbar-card select){min-height:42px;padding:0 11px}:global(.page-grid){display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:14px;align-items:start}:global(.side-stack){display:grid;gap:14px;position:sticky;top:72px}:global(.section-tabs){display:flex;gap:3px;border-bottom:1px solid #e9e2ed;overflow:auto;scrollbar-width:none}:global(.section-tabs::-webkit-scrollbar){display:none}:global(.section-tab){border:0;background:none;padding:12px 15px;color:#81758a;font-weight:800;font-size:.75rem;white-space:nowrap;border-bottom:2px solid transparent}:global(.section-tab.active){color:#641bc0;border-color:#7425d0}
:global(input),:global(select),:global(textarea){border:1px solid #e4dce8;border-radius:9px;background:white;color:var(--ink);transition:.15s ease;max-width:100%}:global(input:focus),:global(select:focus),:global(textarea:focus){outline:none;border-color:#a98ac0;box-shadow:0 0 0 3px rgba(93,35,194,.08)}
.login{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,rgba(34,6,63,.97),rgba(64,20,110,.94))}.login.hidden{display:none}.login-card{width:min(420px,100%);background:white;border-radius:20px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.3)}.login-card .wordmark{color:#2d0b50}.login-card h2{margin:24px 0 8px}.login-card label{display:block;margin-top:14px;font-size:.76rem;font-weight:800}.login-card input{width:100%;padding:12px;margin-top:5px;min-height:46px}.login-card button{width:100%;margin-top:16px;min-height:46px;background:#f0b719;color:#2d0b50;border:0;border-radius:10px;font-weight:850}.error{color:#8d2424;font-size:.8rem;margin-top:10px}
@media(max-width:1100px){:global(.stats-grid){grid-template-columns:repeat(2,minmax(0,1fr))}:global(.page-grid){grid-template-columns:1fr}:global(.side-stack){position:static;grid-template-columns:1fr 1fr}}
@media(max-width:900px){
  .shell{display:block;min-height:100vh}.topbar{display:none}.mobilebar{position:sticky;top:0;z-index:55;height:58px;display:grid;grid-template-columns:44px minmax(0,1fr) 40px;align-items:center;gap:8px;padding:0 max(12px,env(safe-area-inset-right)) 0 max(12px,env(safe-area-inset-left));background:rgba(255,255,255,.97);border-bottom:1px solid #e9e2ed;backdrop-filter:blur(14px)}.mobile-menu{width:40px;height:40px;border:1px solid #e7dfea;background:#fff;border-radius:10px;color:#351052;font-size:1.2rem;font-weight:900;cursor:pointer}.mobile-page{min-width:0}.mobile-page strong{display:block;color:#2b0b4b;font-size:.84rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mobile-page span{display:block;color:#8b7d92;font-size:.62rem;margin-top:1px}.mobilebar .avatar{justify-self:end}
  .sidebar{position:fixed;top:0;left:0;height:100dvh;width:min(318px,86vw);padding:calc(20px + env(safe-area-inset-top)) 14px calc(18px + env(safe-area-inset-bottom));transform:translateX(-105%);transition:transform .2s ease;box-shadow:18px 0 45px rgba(20,3,34,.25);z-index:80}.nav-open .sidebar{transform:translateX(0)}.sidebar .brand{padding-bottom:14px}.sidebar .nav{display:grid;overflow:visible}.sidebar .nav a{min-height:46px;font-size:.88rem}.sidebar .nav-icon{display:block}.sidebar .label{display:block}.sidebar .foot{display:block}.drawer-backdrop{position:fixed;inset:0;background:rgba(20,3,34,.42);z-index:70}.nav-open .drawer-backdrop{display:block}.nav-open{overflow:hidden}
  .content{padding:20px 14px calc(32px + env(safe-area-inset-bottom))}.head{margin-bottom:16px}.head h1{font-size:2.25rem}:global(.admin-grid){grid-template-columns:1fr 1fr}:global(.toolbar-card){grid-template-columns:1fr}:global(.toolbar-card .admin-action){width:100%}:global(.surface-head){align-items:flex-start;flex-wrap:wrap}
}
@media(max-width:700px){
  :global(.admin-grid),:global(.side-stack){grid-template-columns:1fr}:global(.stats-grid){grid-template-columns:repeat(2,minmax(0,1fr))}:global(.metric){min-height:82px;padding:13px}:global(.metric strong){font-size:1.45rem}.content{padding:16px 11px calc(28px + env(safe-area-inset-bottom))}.head{display:grid;gap:11px}.head h1{font-size:1.95rem}.head p{font-size:.82rem}:global(.admin-card){padding:14px}:global(.surface-body){padding:14px}:global(.surface-head){padding:14px}
  :global(input),:global(select),:global(textarea),:global(button){min-height:44px}:global(.admin-action){min-height:44px}:global(.admin-action.compact){min-height:40px}:global(.form-grid){grid-template-columns:1fr!important}:global(.field.full){grid-column:1!important}
  :global(.admin-table){display:block;width:100%;min-width:0!important;border-collapse:separate}:global(.admin-table thead){display:none}:global(.admin-table tbody){display:grid;gap:10px;padding:10px}:global(.admin-table tr){display:block;border:1px solid #e9e2ed;border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 3px 12px rgba(40,5,72,.025)}:global(.admin-table td){display:flex;justify-content:space-between;align-items:flex-start;gap:14px;width:100%;padding:10px 12px;border-top:1px solid #f0ebf2;text-align:right;min-width:0}:global(.admin-table td:first-child){border-top:0}:global(.admin-table td::before){content:attr(data-label);flex:0 0 38%;text-align:left;color:#8b7e92;font-size:.61rem;font-weight:900;text-transform:uppercase;letter-spacing:.05em}:global(.admin-table td>*),:global(.admin-table td>div){min-width:0;max-width:62%}:global(.admin-table td[colspan]){display:block;text-align:center}:global(.admin-table td[colspan]::before){display:none}:global(.admin-table td[colspan]>*),:global(.admin-table td[colspan]>div){max-width:100%}
  :global(.section-tabs){margin-inline:-14px;padding-inline:10px}:global(.section-tab){min-height:44px;padding:11px 12px}:global(.pill){white-space:normal;text-align:center}:global(.empty){padding:26px 12px}
}
@media(max-width:430px){:global(.stats-grid){grid-template-columns:1fr 1fr;gap:8px}:global(.metric){padding:12px;min-height:78px}:global(.metric strong){font-size:1.35rem}.mobilebar{grid-template-columns:42px minmax(0,1fr) 36px}.mobile-page strong{font-size:.8rem}.content{padding-left:9px;padding-right:9px}.login-card{padding:24px 18px;border-radius:17px}}
@media(hover:none){:global(.admin-action:hover){transform:none;box-shadow:none}.nav a:hover{background:transparent}.nav a.active:hover{background:linear-gradient(90deg,rgba(255,194,28,.22),rgba(255,255,255,.09))}}
</style>
</head>
<body>
<div class="login" id="adminLogin"><form class="login-card" id="adminLoginForm"><div class="wordmark">Cajun<span>Sites</span></div><h2>Internal Dashboard</h2><p>Sign in with your CajunSites internal account.</p><label for="adminEmail">Email</label><input id="adminEmail" type="email" autocomplete="username" value="blaketaravella@gmail.com" required/><label for="adminPassword">Password</label><input id="adminPassword" type="password" autocomplete="current-password" required/><div class="error" id="adminLoginError"></div><button type="submit">Sign In</button></form></div>
<div class="drawer-backdrop" id="drawerBackdrop"></div>
<div class="shell">
  <aside class="sidebar" id="adminSidebar"><a class="brand" href="/admin/overview/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a><div class="label">Manage</div><nav class="nav">{nav.map(([key,label,href,icon,ownerOnly])=><a class={key===active?'active':''} href={href} data-owner-only={ownerOnly?'true':undefined} hidden={ownerOnly}><span class="nav-icon">{icon}</span>{label}</a>)}</nav><div class="foot">CajunSites internal operations</div></aside>
  <main class="main">
    <div class="topbar"><div class="avatar" id="adminAvatar">CS</div><div class="identity"><span class="name" id="adminName">CajunSites</span><span class="role" id="adminRole">Internal User</span></div><button class="button" id="adminLogout">Sign Out</button></div>
    <div class="mobilebar"><button class="mobile-menu" id="mobileMenu" aria-label="Open navigation" aria-expanded="false">☰</button><div class="mobile-page"><strong>{title}</strong><span>CajunSites Operations</span></div><div class="avatar" id="mobileAvatar">CS</div></div>
    <div class="content">{!hideHeader&&<div class="head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div><slot name="actions"/></div>}<slot/></div>
  </main>
</div>
<script is:inline>
window.adminApi=async(path,options={})=>{const r=await fetch(path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});if(r.status===401){document.getElementById('adminLogin')?.classList.remove('hidden');throw new Error('Authentication required')}const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d};
const login=document.getElementById('adminLogin'),form=document.getElementById('adminLoginForm'),err=document.getElementById('adminLoginError');
function applyUser(user){window.adminUser=user;const initials=String(user.name||'CS').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase()||'CS';document.getElementById('adminAvatar').textContent=initials;document.getElementById('mobileAvatar').textContent=initials;document.getElementById('adminName').textContent=user.name||user.email;document.getElementById('adminRole').textContent=(user.role||'').replace('_',' ');document.querySelectorAll('[data-owner-only="true"]').forEach(a=>a.hidden=user.role!=='owner');document.body.dataset.adminRole=user.role||'';login?.classList.add('hidden');window.dispatchEvent(new CustomEvent('admin-authenticated',{detail:user}))}
async function hydrate(){const d=await window.adminApi('/api/admin/me');applyUser(d.user)}
form?.addEventListener('submit',async e=>{e.preventDefault();err.textContent='';try{const d=await window.adminApi('/api/admin/login',{method:'POST',body:JSON.stringify({email:document.getElementById('adminEmail').value,password:document.getElementById('adminPassword').value})});document.getElementById('adminPassword').value='';applyUser(d.user)}catch(e){err.textContent=e.message}});
async function logout(){try{await window.adminApi('/api/admin/logout',{method:'POST',body:'{}'})}catch{}location.href='/admin/login/'}
document.getElementById('adminLogout').onclick=logout;
const menu=document.getElementById('mobileMenu'),backdrop=document.getElementById('drawerBackdrop');function setNav(open){document.body.classList.toggle('nav-open',open);menu?.setAttribute('aria-expanded',open?'true':'false');menu&&(menu.textContent=open?'×':'☰')}menu?.addEventListener('click',()=>setNav(!document.body.classList.contains('nav-open')));backdrop?.addEventListener('click',()=>setNav(false));document.querySelectorAll('#adminSidebar a').forEach(a=>a.addEventListener('click',()=>setNav(false)));
document.getElementById('mobileAvatar')?.addEventListener('click',()=>{if(confirm('Sign out of CajunSites?'))logout()});
function labelTables(root=document){root.querySelectorAll?.('.admin-table').forEach(table=>{const labels=[...table.querySelectorAll('thead th')].map(th=>th.textContent.trim());table.querySelectorAll('tbody tr').forEach(row=>{[...row.children].forEach((cell,i)=>{if(cell.tagName==='TD'&&!cell.hasAttribute('colspan')&&!cell.dataset.label)cell.dataset.label=labels[i]||''})})})}
labelTables();new MutationObserver(m=>{for(const x of m)for(const n of x.addedNodes)if(n.nodeType===1)labelTables(n.matches?.('.admin-table')?n:n.parentElement||document)}).observe(document.body,{childList:true,subtree:true});
hydrate().catch(()=>{});
</script>
</body></html>