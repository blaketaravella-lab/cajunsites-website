---
import '../styles/global.css';
const { title, eyebrow='Internal Operations', description='', active='customers' } = Astro.props;
const nav=[['overview','Overview','/admin/overview/','⌂'],['prospects','Prospects','/admin/prospects/','◎'],['customers','Customers','/admin/','◉'],['onboarding','Onboarding','/admin/onboarding/','✓'],['build','Build Queue','/admin/build-queue/','◇'],['sites','Sites','/admin/sites/','□'],['activity','Activity','/admin/activity/','◷'],['templates','Templates','/admin/templates/','▱'],['analytics','Analytics','/admin/analytics/','⌁'],['documentation','Documentation','/admin/documentation/','≡'],['users','Internal Users','/admin/users/','♙',true],['settings','Settings','/admin/settings/','⚙']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="referrer" content="no-referrer"/><title>{title} | CajunSites</title><style>
:global(body){margin:0;background:#fbfaff;min-height:100vh;color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}:global(*),:global(*::before),:global(*::after){box-sizing:border-box}:global(button),:global(input),:global(select),:global(textarea){font:inherit}:global(a),:global(button),:global(input),:global(select),:global(textarea){-webkit-tap-highlight-color:transparent}:global(:focus-visible){outline:3px solid rgba(93,35,194,.16);outline-offset:2px}.shell{min-height:100vh;display:grid;grid-template-columns:212px 1fr}.sidebar{position:sticky;top:0;height:100vh;padding:20px 13px 15px;background:linear-gradient(180deg,#280548,#170228);color:white;overflow:auto;display:flex;flex-direction:column;border-right:1px solid rgba(255,255,255,.05)}.brand{display:flex;flex-direction:column;text-decoration:none;padding:0 9px 22px;line-height:1}.wordmark{font-size:1.55rem;font-weight:950;letter-spacing:-.05em;color:white}.wordmark span{color:#ffc21c}.brand small{margin-top:6px;font-size:.67rem;color:#d4c7dd;font-weight:700}.label{padding:9px 10px 7px;color:#a996b8;text-transform:uppercase;letter-spacing:.13em;font-size:.62rem;font-weight:900}.nav{display:grid;gap:4px}.nav a{display:flex;align-items:center;gap:10px;min-height:39px;padding:9px 11px;border-radius:10px;color:#eee7f2;text-decoration:none;font-size:.82rem;font-weight:780;border:1px solid transparent;transition:.15s ease}.nav a:hover{background:rgba(255,255,255,.055);color:#fff}.nav a.active{background:linear-gradient(90deg,rgba(255,194,28,.22),rgba(255,255,255,.09));color:#fff;border-color:rgba(255,194,28,.12);box-shadow:inset 3px 0 0 #ffc21c}.nav-icon{width:18px;text-align:center;color:#c8b6d5;font-size:.84rem}.nav a.active .nav-icon{color:#ffc21c}.nav a[hidden]{display:none}.foot{margin-top:auto;padding:22px 9px 2px;color:#9f8cad;font-size:.65rem}.main{min-width:0}.topbar{position:sticky;top:0;z-index:30;height:58px;display:flex;justify-content:flex-end;align-items:center;gap:10px;padding:0 24px;background:rgba(255,255,255,.96);border-bottom:1px solid #eee9f1;backdrop-filter:blur(14px)}.avatar{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:#2d0752;color:#fff;font-size:.7rem;font-weight:900}.identity{display:flex;flex-direction:column;line-height:1.15}.name{font-size:.8rem;font-weight:850;color:#2b0b4b}.role{font-size:.62rem;color:#85788c;text-transform:capitalize}.button{min-height:36px;border-radius:9px;padding:0 14px;border:1px solid #e6deea;background:white;color:#321050;font-weight:800;cursor:pointer}.content{padding:26px 30px 38px;max-width:1600px;margin:0 auto}.head{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:22px}.head>div:first-child{min-width:0}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.62rem;font-weight:900;color:#6d24b8;margin-bottom:6px}.head h1{font-size:clamp(2rem,3.5vw,3.1rem);line-height:1;letter-spacing:-.045em;margin:0 0 8px;color:#280548}.head p{margin:0;color:#776b7d;max-width:780px;font-size:.9rem;line-height:1.5}:global(h2),:global(h3){color:#280548}:global(h3){margin:0 0 8px;font-size:1rem}:global(p){line-height:1.55}:global(.admin-card){background:#fff;border:1px solid #e9e2ed;border-radius:16px;padding:20px;box-shadow:0 5px 18px rgba(40,5,72,.025)}:global(.admin-grid){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}:global(.admin-table){width:100%;border-collapse:separate;border-spacing:0}:global(.admin-table th){text-align:left;padding:11px 13px;background:#fbf9fc;color:#6d6174;font-size:.64rem;text-transform:uppercase;letter-spacing:.065em;font-weight:900;white-space:nowrap}:global(.admin-table td){padding:13px;border-top:1px solid #eee9f1;font-size:.8rem;vertical-align:middle}:global(.admin-table tbody tr:hover){background:#fdfbff}:global(.pill){display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:#f1eafa;color:#55208d;font-size:.68rem;font-weight:850;white-space:nowrap}:global(.pill.gold){background:#fff0bd;color:#795500}:global(.pill.green){background:#e4f7e9;color:#126832}:global(.pill.gray){background:#f0f1f4;color:#626873}:global(.pill.red){background:#fde9e9;color:#8c2525}:global(.metric){position:relative;background:#fff;border:1px solid #e9e2ed;border-radius:15px;padding:16px 17px;min-height:88px;box-shadow:0 5px 18px rgba(40,5,72,.025)}:global(.metric strong){display:block;font-size:1.65rem;line-height:1;color:#280548;letter-spacing:-.04em;margin:3px 0 8px}:global(.metric span){font-size:.72rem;color:#776b7d;font-weight:650}:global(.empty){padding:38px 18px;text-align:center;color:#817587}:global(.admin-action){display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:38px;padding:0 13px;border:1px solid #e3dbe8;border-radius:9px;background:#fff;color:#42116e;font-weight:820;cursor:pointer;transition:.15s ease;text-decoration:none;font-size:.8rem}:global(.admin-action:hover){transform:translateY(-1px);border-color:#cdbdd8;box-shadow:0 7px 17px rgba(40,5,72,.07)}:global(.admin-action.primary){background:linear-gradient(135deg,#ffbd16,#ffc943);color:#2b074a;border-color:#eeb017;box-shadow:0 8px 20px rgba(240,183,25,.2)}:global(.admin-action.purple){background:linear-gradient(135deg,#3b0767,#6619b4);color:#fff;border-color:#4c0a85;box-shadow:0 8px 20px rgba(70,12,121,.16)}:global(.admin-action.compact){min-height:32px;padding:0 10px;font-size:.74rem}:global(.admin-action.danger){color:#8d2424;background:#fffafa}:global(.admin-action[disabled]){opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}:global(input),:global(select),:global(textarea){border:1px solid #e4dce8;border-radius:9px;background:white;color:var(--ink);transition:.15s ease}:global(input:focus),:global(select:focus),:global(textarea:focus){outline:none;border-color:#a98ac0;box-shadow:0 0 0 3px rgba(93,35,194,.08)}.login{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:linear-gradient(135deg,rgba(34,6,63,.97),rgba(64,20,110,.94))}.login.hidden{display:none}.login-card{width:min(420px,100%);background:white;border-radius:20px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.3)}.login-card .wordmark{color:#2d0b50}.login-card h2{margin:24px 0 8px}.login-card label{display:block;margin-top:14px;font-size:.76rem;font-weight:800}.login-card input{width:100%;padding:12px;margin-top:5px}.login-card button{width:100%;margin-top:16px;min-height:42px;background:#f0b719;color:#2d0b50;border:0;border-radius:10px;font-weight:850}.error{color:#8d2424;font-size:.8rem;margin-top:10px}@media(max-width:900px){.shell{grid-template-columns:1fr}.sidebar{height:auto;position:static;display:block;padding:15px 12px}.brand{padding-bottom:13px}.nav{display:flex;overflow-x:auto;gap:5px}.nav a{white-space:nowrap;flex:none}.nav-icon,.foot,.label{display:none}.topbar{display:none}.content{padding:20px 14px}.head h1{font-size:2.35rem}:global(.admin-grid){grid-template-columns:1fr 1fr}:global(.admin-table){min-width:760px}}@media(max-width:620px){:global(.admin-grid){grid-template-columns:1fr}.content{padding:17px 11px}.head{display:grid;gap:13px}.head h1{font-size:2.05rem}:global(.admin-card){padding:15px}}
</style></head><body><div class="login" id="adminLogin"><form class="login-card" id="adminLoginForm"><div class="wordmark">Cajun<span>Sites</span></div><h2>Internal Dashboard</h2><p>Sign in with your CajunSites internal account.</p><label for="adminEmail">Email</label><input id="adminEmail" type="email" autocomplete="username" value="blaketaravella@gmail.com" required/><label for="adminPassword">Password</label><input id="adminPassword" type="password" autocomplete="current-password" required/><div class="error" id="adminLoginError"></div><button type="submit">Sign In</button></form></div><div class="shell"><aside class="sidebar"><a class="brand" href="/admin/overview/"><span class="wordmark">Cajun<span>Sites</span></span><small>Internal Operations</small></a><div class="label">Manage</div><nav class="nav">{nav.map(([key,label,href,icon,ownerOnly])=><a class={key===active?'active':''} href={href} data-owner-only={ownerOnly?'true':undefined} hidden={ownerOnly}><span class="nav-icon">{icon}</span>{label}</a>)}</nav><div class="foot">CajunSites internal operations</div></aside><main class="main"><div class="topbar"><div class="avatar" id="adminAvatar">CS</div><div class="identity"><span class="name" id="adminName">CajunSites</span><span class="role" id="adminRole">Internal User</span></div><button class="button" id="adminLogout">Sign Out</button></div><div class="content"><div class="head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p>{description}</p></div><slot name="actions"/></div><slot/></div></main></div><script is:inline>
window.adminApi=async(path,options={})=>{const r=await fetch(path,{credentials:'same-origin',...options,headers:{'content-type':'application/json',...(options.headers||{})}});if(r.status===401){document.getElementById('adminLogin').classList.remove('hidden');throw new Error('Authentication required')}const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Request failed');return d};const login=document.getElementById('adminLogin'),form=document.getElementById('adminLoginForm'),err=document.getElementById('adminLoginError');function applyUser(user){window.adminUser=user;const initials=String(user.name||'CS').split(/\s+/).map(x=>x[0]).join('').slice(0,2).toUpperCase();document.getElementById('adminAvatar').textContent=initials||'CS';document.getElementById('adminName').textContent=user.name||user.email;document.getElementById('adminRole').textContent=(user.role||'').replace('_',' ');document.querySelectorAll('[data-owner-only="true"]').forEach(a=>a.hidden=user.role!=='owner');document.body.dataset.adminRole=user.role||'';login.classList.add('hidden');window.dispatchEvent(new CustomEvent('admin-authenticated',{detail:user}))}async function hydrate(){const d=await window.adminApi('/api/admin/me');applyUser(d.user)}form.addEventListener('submit',async e=>{e.preventDefault();err.textContent='';try{const d=await window.adminApi('/api/admin/login',{method:'POST',body:JSON.stringify({email:document.getElementById('adminEmail').value,password:document.getElementById('adminPassword').value})});document.getElementById('adminPassword').value='';applyUser(d.user)}catch(e){err.textContent=e.message}});document.getElementById('adminLogout').onclick=async()=>{try{await window.adminApi('/api/admin/logout',{method:'POST',body:'{}'})}catch{}location.href='/admin/'};hydrate().catch(()=>{});
</script></body></html>