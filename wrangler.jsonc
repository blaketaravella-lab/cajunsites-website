{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cajunsites-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ]
}
